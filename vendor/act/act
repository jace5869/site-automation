def _provider_record(record):
    """One provider's persisted fields. The format fields are written only when they carry
    something, so a plain OpenAI-only setup file looks exactly as it did before 0.6.19."""
    out = {
        "key": str(record.get("key", "")),
        "url": str(record.get("url", "")),
        "model": str(record.get("model", "")),
    }
    if record.get("anthropic_url"):
        out["anthropic_url"] = str(record["anthropic_url"])
    if record.get("format", "auto") != "auto":
        out["format"] = str(record["format"])
    if record.get("formats"):
        out["formats"] = dict(sorted(record["formats"].items()))
    return out


def _write_config_document(path, document):
    """Atomically write the setup file with user-only directory/file permissions."""
    directory = os.path.dirname(os.path.abspath(path))
    directory_existed = os.path.isdir(directory)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    if not directory_existed:
        try:
            os.chmod(directory, 0o700)
        except OSError:
            pass
    fd, temporary = tempfile.mkstemp(prefix=".config-", suffix=".json", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            fd = -1
            json.dump(document, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            if os.path.exists(temporary):
                os.unlink(temporary)
        except OSError:
            pass
    return path


def save_user_config(path=None):
    """Atomically persist provider setup with user-only directory/file permissions."""
    path = path or act_config_path()
    document = {
        "version": 1,
        "provider": PROVIDER,
        "providers": {name: _provider_record(record) for name, record in _PROVIDER_STATE.items()},
    }
    for keep in ("pseudonymize", "pseudo_names"):       # hand-set privacy settings survive :setup
        if keep in _USER_CONFIG:
            document[keep] = _USER_CONFIG[keep]
    return _write_config_document(path, document)


def save_model_formats(name=None, path=None):
    """Record a provider's learned model -> format map in the setup file WITHOUT re-saving
    anything else: the key in memory may have come from an environment variable, and a
    runtime discovery must never write that to disk. Only an existing setup file is
    updated (automation runs without one stay file-free). Best effort; returns True when
    written."""
    name = name or PROVIDER
    path = path or act_config_path()
    if not os.path.isfile(path):
        return False
    document = load_user_config(path)
    if not document:
        return False
    providers = document.get("providers")
    if not isinstance(providers, dict):
        providers = document["providers"] = {}
    record = providers.get(name)
    if not isinstance(record, dict):
        record = providers[name] = {}
    formats = dict(sorted((_PROVIDER_STATE.get(name) or {}).get("formats", {}).items()))
    if record.get("formats") == formats:
        return False
    record["formats"] = formats
    try:
        _write_config_document(path, document)
    except OSError:
        return False
    return True


