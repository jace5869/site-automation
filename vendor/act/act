def act_config_path():
    """Return the per-user ACT config path (overridable for managed installs/tests)."""
    configured = os.environ.get("ACT_CONFIG", "").strip()
    if configured:
        return os.path.abspath(os.path.expanduser(configured))
    base = os.environ.get("XDG_CONFIG_HOME", "").strip()
    if not base:
        base = os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(os.path.abspath(os.path.expanduser(base)), "act", "config.json")


def load_user_config(path=None):
    """Load a local setup file. A damaged/missing file behaves like no configuration."""
    path = path or act_config_path()
    try:
        with open(path, "r", encoding="utf-8") as stream:
            data = json.load(stream)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def stored_provider_value(config, provider, field, default=""):
    providers = config.get("providers", {}) if isinstance(config, dict) else {}
    record = providers.get(provider, {}) if isinstance(providers, dict) else {}
    value = record.get(field, default) if isinstance(record, dict) else default
    return value if isinstance(value, str) else default


def stored_provider_formats(config, provider):
    """The learned model -> request format map ("openai" / "anthropic") for a provider."""
    providers = config.get("providers", {}) if isinstance(config, dict) else {}
    record = providers.get(provider, {}) if isinstance(providers, dict) else {}
    value = record.get("formats") if isinstance(record, dict) else None
    if not isinstance(value, dict):
        return {}
    return {str(k): v for k, v in value.items() if v in ("openai", "anthropic")}


def env_or_stored(name, config, provider, field, default=""):
    value = os.environ.get(name)
    if value is not None and value != "":
        return value
    return stored_provider_value(config, provider, field, default)


_USER_CONFIG = load_user_config()


def _env_int(name, default, minimum, maximum):
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        value = int(raw)
    except (TypeError, ValueError):
        _CONFIG_ERRORS.append("{0} must be an integer (got {1!r})".format(name, raw))
        return default
    if value < minimum or value > maximum:
        _CONFIG_ERRORS.append("{0} must be between {1} and {2} (got {3})".format(
            name, minimum, maximum, value))
        return default
    return value


def _env_float(name, default, minimum, maximum):
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        value = float(raw)
    except (TypeError, ValueError):
        _CONFIG_ERRORS.append("{0} must be numeric (got {1!r})".format(name, raw))
        return default
    if value < minimum or value > maximum:
        _CONFIG_ERRORS.append("{0} must be between {1} and {2} (got {3})".format(
            name, minimum, maximum, value))
        return default
    return value


