RESULT_SCHEMA = "act.result/1"
# The exact top-level key set, identical in act.ps1 (both test suites assert it).
RESULT_KEYS = ("schema", "act_version", "platform", "host", "user", "cwd", "task",
               "provider", "model", "started_at", "finished_at", "duration_s", "exit_code",
               "status", "summary", "stop_reason", "changed", "commands", "denied",
               "files_changed", "pre_approved_patterns", "race", "tokens")
_RESULT_TASK = None          # the one-shot task text; None = not a task run (REPL, --version)


def _utc_iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def build_result(events, exit_code, started, finished, task="", context=None):
    """Pure: fold a run's events and exit code into one act.result/1 record.

    status: completed (exit 0) | needs_approval (actions were refused; `denied` is the
    proposed fix) | stopped (a harness limit ended the run) | error (setup/model failure)
    | cancelled. Command OUTPUT is deliberately absent: it can carry secrets, and
    `summary` already holds the model's findings."""
    ctx = context or {}
    commands, denied, files = [], [], []
    summary, stop_reason, race, cancelled = "", "", None, False
    for ev in events:
        kind = ev.get("event")
        if kind in ("command", "background_start"):
            commands.append({
                "command": ev.get("command", ""), "risk": ev.get("risk", ""),
                "approval": ev.get("approval") or "auto", "pattern": ev.get("pattern"),
                "exit_code": ev.get("exit_code"), "duration_ms": ev.get("duration_ms"),
                "timed_out": bool(ev.get("timed_out")), "background": kind == "background_start",
                "read_only": bool(ev.get("read_only", True))})
        elif kind == "policy_denied":
            denied.append({"kind": ev.get("target", "command"), "command": ev.get("command", ""),
                           "risk": ev.get("risk", ""), "reason": ev.get("reason", ""),
                           "thought": ev.get("thought", ""),
                           "pre_approvable": bool(ev.get("pre_approvable", False))})
        elif kind == "file_edit":
            files.append({"action": ev.get("action", ""), "path": ev.get("path", ""),
                          "ok": bool(ev.get("ok"))})
        elif kind == "finish":
            summary = ev.get("message") or ""
        elif kind == "stopped":
            stop_reason = ev.get("reason") or ""
        elif kind == "ask_rejected":
            stop_reason = ("the model asked a clarifying question, which a non-interactive run "
                           "cannot answer")
        elif kind == "error":
            stop_reason = ev.get("message") or "error"
        elif kind == "cancelled":
            cancelled = True
            stop_reason = "cancelled ({0})".format(ev.get("reason") or "interrupted")
        elif kind == "race_result":
            race = {k: ev.get(k) for k in ("judge", "outcome", "chosen", "candidates", "dropped")}
    if exit_code in (2, 3) or (exit_code not in (0, 4) and not cancelled):
        status = "error"
    elif cancelled:
        status = "cancelled"
    elif denied:
        status = "needs_approval"
    elif exit_code == 0:
        status = "completed"
    else:
        status = "stopped"
    if status in ("stopped", "error") and not stop_reason:
        stop_reason = "{0} (exit {1})".format(status, exit_code)
    if status in ("completed", "needs_approval"):
        stop_reason = ""
    rec = {
        "schema": RESULT_SCHEMA, "act_version": ACT_VERSION, "platform": "linux",
        "host": ctx.get("host", ""), "user": ctx.get("user", ""), "cwd": ctx.get("cwd", ""),
        "task": task or "", "provider": ctx.get("provider", ""), "model": ctx.get("model", ""),
        "started_at": _utc_iso(started), "finished_at": _utc_iso(finished),
        "duration_s": round(max(0.0, finished - started), 1), "exit_code": exit_code,
        "status": status, "summary": summary, "stop_reason": stop_reason,
        "changed": any(f["ok"] for f in files) or any(not c["read_only"] for c in commands),
        "commands": commands, "denied": denied, "files_changed": files,
        "pre_approved_patterns": list(ctx.get("patterns") or []),
        "race": race, "tokens": ctx.get("tokens"),
    }
    return {k: rec[k] for k in RESULT_KEYS}


def write_result_file(path, record):
    """Write the result atomically (temp file + rename, mode 0600). Never raises: a failed
    write warns on stderr and the run keeps its own exit code."""
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(prefix=".act-result-",
                                   dir=os.path.dirname(os.path.abspath(path)) or ".")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(record, f, indent=2, default=str)
            f.write("\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        return True
    except (OSError, ValueError, TypeError) as e:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        sys.stderr.write("act: could not write result file {0}: {1}\n".format(
            path, sanitize_terminal(str(e))))
        return False


def _result_context():
    try:
        import getpass
        user = getpass.getuser()
    except Exception:  # noqa: BLE001 — best-effort metadata
        user = os.environ.get("USER", "")
    try:
        import socket
        host = socket.gethostname()
    except Exception:  # noqa: BLE001
        host = ""
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = ""
    return {"host": host, "user": user, "cwd": cwd, "provider": PROVIDER, "model": MODEL,
            "tokens": TOKENS_USED.get(PROVIDER) or None,
            "patterns": [src for src, _rx in PREAPPROVED]}


def _euid():
    return os.geteuid() if hasattr(os, "geteuid") else -1


def _journal_root():
    """Per-user 0700 journal directory, or None when it cannot be trusted (a symlink, not a
    directory, owned by someone else, or group/other accessible). Never reuses a shared,
    predictable /tmp path that another local user could have pre-created."""
    uid = _euid()
    d = os.path.join(tempfile.gettempdir(), "act-journal-{0}".format(uid))
    try:
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            pass
        st = os.lstat(d)
    except OSError:
        return None
    if (not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or st.st_mode & 0o077):
        return None
    return d


def _journal_untrusted_note():
    return ("the undo journal directory {0} is missing, not owned by you, or accessible to "
            "other users; refusing to use it".format(
                os.path.join(tempfile.gettempdir(), "act-journal-{0}".format(_euid()))))


def _trusted_regular(path, private=False):
    """lstat a journal or backup file: regular, owned by the current user, and not writable
    by group/other (private=True also forbids any group/other access)."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or st.st_uid != _euid():
        return None
    if st.st_mode & (0o077 if private else 0o022):
        return None
    return st


def _current_umask():
    old = os.umask(0o022)
    os.umask(old)
    return old


def _copy_xattrs(src, dst):
    """Best-effort copy of extended attributes (incl. security.selinux) from src to dst
    (paths or fds). Whatever the kernel/user cannot copy is skipped."""
    if not hasattr(os, "listxattr"):
        return
    try:
        names = os.listxattr(src, follow_symlinks=False) if isinstance(src, str) else os.listxattr(src)
    except OSError:
        return
    for name in names:
        try:
            value = (os.getxattr(src, name, follow_symlinks=False) if isinstance(src, str)
                     else os.getxattr(src, name))
            if isinstance(dst, str):
                os.setxattr(dst, name, value, follow_symlinks=False)
            else:
                os.setxattr(dst, name, value)
        except OSError:
            continue


def record_mutation(path, backup, created, meta=None):
    """Record a file mutation (overwrite w/ backup, or a newly-created file) so it can be
    reverted with ':undo' in the REPL or `act --undo` in a later process."""
    rec = {"ts": round(time.time(), 3), "session": _session_id(),
           "path": os.path.abspath(path), "backup": backup or "", "created": bool(created)}
    if meta:
        rec.update(meta)
    _MUTATION_JOURNAL.append(rec)
    root = _journal_root()
    if root is None:
        sys.stderr.write("act: " + _journal_untrusted_note() + "; this change can be undone "
                         "only in this session (:undo)\n")
        return
    try:
        _append_jsonl(os.path.join(root, _session_id() + ".jsonl"), rec)
    except OSError:
        pass


def _latest_journal():
    root = _journal_root()
    if root is None:
        return None
    try:
        files = sorted(f for f in os.listdir(root) if f.endswith(".jsonl"))
    except OSError:
        return None
    return os.path.join(root, files[-1]) if files else None


def _load_journal(path):
    records = []
    if _trusted_regular(path, private=True) is None:
        return None
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0))
        with os.fdopen(fd, "r", encoding="utf-8") as fh:
            for ln in fh:
                ln = ln.strip()
                if ln:
                    records.append(json.loads(ln))
    except (OSError, ValueError):
        pass
    return records


def perform_undo(records=None):
    """Revert the most recent session's file mutations, newest first: restore an
    overwritten file from its verified backup; delete a file the agent created.
    Records read from disk are only used when the journal directory, the journal file and
    each backup are private to the current user (a root `--undo` never follows another
    user's journal). Returns (reverted_count, [human messages])."""
    from_disk = records is None
    if from_disk:
        jf = _latest_journal()
        if jf is None:
            root = _journal_root()
            return 0, ([] if root is not None else [_journal_untrusted_note()])
        records = _load_journal(jf)
        if records is None:
            return 0, ["refusing the undo journal {0}: it is not a private file owned by you".format(jf)]
    reverted, msgs = 0, []
    for rec in reversed(records):
        path, backup, created = rec.get("path"), rec.get("backup"), rec.get("created")
        tmp = None
        try:
            if not isinstance(path, str) or not os.path.isabs(path):
                msgs.append("skipped a journal entry with an invalid path")
                continue
            if created:
                if os.path.lexists(path):
                    os.unlink(path)
                    msgs.append("removed created file " + path)
                    reverted += 1
                else:
                    msgs.append("already absent: " + str(path))
            elif backup and os.path.exists(backup):
                if from_disk and _trusted_regular(backup) is None:
                    msgs.append("refusing backup {0}: not a regular file owned by you".format(backup))
                    continue
                fd = os.open(backup, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
                with os.fdopen(fd, "rb") as b:
                    data = b.read()
                parent = os.path.dirname(path) or "."
                fd, tmp = tempfile.mkstemp(dir=parent, prefix=".act-undo-")
                with os.fdopen(fd, "wb") as out:
                    out.write(data)
                    out.flush()
                    uid, gid = rec.get("uid"), rec.get("gid")
                    if isinstance(uid, int) and isinstance(gid, int):
                        cur = os.fstat(out.fileno())
                        if (cur.st_uid, cur.st_gid) != (uid, gid):
                            os.fchown(out.fileno(), uid, gid)
                    mode = rec.get("mode")          # after chown, which clears setuid/setgid
                    if isinstance(mode, int):
                        os.fchmod(out.fileno(), stat.S_IMODE(mode))
                    if os.path.lexists(path):
                        _copy_xattrs(path, out.fileno())
                    os.fsync(out.fileno())
                os.replace(tmp, path)
                tmp = None
                msgs.append("restored " + path)
                reverted += 1
            else:
                msgs.append("no backup available for " + str(path) + " — cannot restore")
        except OSError as e:
            msgs.append("FAILED to revert {0}: {1}".format(path, e))
        finally:
            if tmp:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
    return reverted, msgs


# Background jobs (#2): long-running admin work (dnf upgrade, kernel builds, rsync) must
# not be killed by the per-command timeout. A background command is launched detached, its
# combined output streamed to a session log, and awaited locally via 'wait_job' (or inspected
# without waiting via the 'jobs' action / ':jobs'). It
# still passes the SAME classifier + approval gate before launching — background is not an
# approval bypass, and it inherits the same host permissions and scrubbed environment.
_JOBS = []


def launch_background(cmd, cwd, step_id=""):
    """Start cmd detached (own session, survives the step/timeout). Returns (job, error)."""
    log = os.path.join(_journal_root() or _backup_root(), "job-{0}-{1}.log".format(_session_id(), len(_JOBS) + 1))
    try:
        logf = open(log, "wb")
    except OSError as e:
        return None, "could not open job log: {0}".format(e)
    try:
        proc = subprocess.Popen(
            ["/bin/bash", "--noprofile", "--norc", "-c", cmd],
            stdout=logf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
            cwd=cwd, start_new_session=True, env=executor_environment())
    except OSError as e:
        logf.close()
        return None, "failed to launch: {0}".format(e)
    logf.close()   # the child keeps its own write fd
    job = {"id": len(_JOBS) + 1, "pid": proc.pid, "cmd": cmd, "log": log,
           "started": time.time(), "proc": proc, "step_id": step_id or ""}
    _JOBS.append(job)
    return job, None


def _job_state(job):
    rc = job["proc"].poll()
    return ("running", None) if rc is None else ("exited", rc)


def _find_job(job_id):
    try:
        wanted = int(job_id)
    except (TypeError, ValueError):
        return None
    return next((job for job in _JOBS if job["id"] == wanted), None)


def _job_tail(job, tail_bytes=2000):
    try:
        with open(job["log"], "rb") as fh:
            return fh.read()[-tail_bytes:].decode("utf-8", "replace")
    except OSError:
        return ""


def wait_for_job(job_id, timeout=300, cancel=None, tail_bytes=3000):
    """Wait locally for one detached job, avoiding an LLM round trip per poll.

    A timeout does not kill the job.  Returns (status_dict, error).
    """
    job = _find_job(job_id)
    if job is None:
        return None, "unknown background job id {0!r}".format(job_id)
    try:
        timeout = max(0.1, min(float(timeout), 3600.0))
    except (TypeError, ValueError):
        return None, "wait timeout must be numeric"
    deadline = time.monotonic() + timeout
    timed_out = cancelled = False
    while job["proc"].poll() is None:
        if cancel is not None and cancel.cancelled.is_set():
            cancelled = True
            break
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break
        time.sleep(min(0.1, remaining))
    state, rc = _job_state(job)
    return {
        "job_id": job["id"], "pid": job["pid"], "step_id": job.get("step_id", ""),
        "state": state, "exit_code": rc, "timed_out": timed_out, "cancelled": cancelled,
        "duration": max(0.0, time.time() - job["started"]),
        "output": _job_tail(job, tail_bytes),
    }, ""


def poll_jobs(tail_bytes=2000):
    """Human/model-readable status + recent output tail for every background job."""
    if not _JOBS:
        return "(no background jobs)"
    blocks = []
    for job in _JOBS:
        state, rc = _job_state(job)
        dur = int(time.time() - job["started"])
        head = "job {0} [{1}{2}] {3}s :: {4}".format(
            job["id"], state, "" if rc is None else " exit={0}".format(rc), dur, job["cmd"])
        tail = _job_tail(job, tail_bytes)
        blocks.append(head + ("\n    " + tail.strip().replace("\n", "\n    ")
                              if tail.strip() else ""))
    return "\n".join(blocks)


