_SSL_CONTEXT_CACHE = {}


def _ssl_context():
    ca = os.environ.get("GENAI_CA") or ""
    cache_key = (bool(ALLOW_INSECURE_TLS), ca)
    cached = _SSL_CONTEXT_CACHE.get(cache_key)
    if cached is not None:
        return cached
    if ALLOW_INSECURE_TLS:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    elif ca:
        ctx = ssl.create_default_context(cafile=ca)
    else:
        ctx = ssl.create_default_context()
    _SSL_CONTEXT_CACHE[cache_key] = ctx
    return ctx


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect: urllib would replay the Authorization header to the new host."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code,
                                     "redirect refused (API key is never forwarded)", headers, fp)


def _api_url_allowed(url):
    parts = urllib.parse.urlsplit(url or "")
    if parts.scheme == "https":
        return True
    if parts.scheme != "http":
        return False
    host = (parts.hostname or "").lower()
    if host == "localhost":
        return True
    try:                                   # a loopback ADDRESS, not a name like 127.x.evil.com
        if __import__("ipaddress").ip_address(host).is_loopback:
            return True
    except ValueError:
        pass
    return os.environ.get("ACT_ALLOW_HTTP", "").strip().lower() in ("1", "true", "yes", "on")


def api_urlopen(req, timeout):
    """urlopen for every provider request: https only (plain http only to loopback or with
    ACT_ALLOW_HTTP=1) so the API key never crosses the network in clear, and no redirects."""
    if not _api_url_allowed(req.full_url):
        raise RuntimeError(
            "refusing to send the API key to %s: use an https:// URL (plain http is allowed "
            "only for localhost, or set ACT_ALLOW_HTTP=1 to accept the risk)"
            % sanitize_terminal(req.full_url.split("?", 1)[0]))
    urllib.request.install_opener(urllib.request.build_opener(
        _NoRedirect, urllib.request.HTTPSHandler(context=_ssl_context())))
    return urllib.request.urlopen(req, timeout=timeout)


def _read_limited(stream, limit, label):
    """Read at most limit bytes and reject oversized remote/local streams."""
    data = stream.read(limit + 1)
    if len(data) > limit:
        raise RuntimeError("{0} exceeded the {1}-byte limit".format(label, limit))
    return data


_STR = {"type": "string"}
_TOOL_COMMON = {"thought": {"type": "string",
                            "description": "one short line of reasoning for this action"},
                "step_id": {"type": "string",
                            "description": "id of the plan step this action belongs to"}}

# The action protocol as a function schema. Field names and semantics are identical to the
# JSON protocol in SYSTEM_PROMPT - this is the same contract, enforced by the endpoint
# instead of coaxed out of prose. Kept as a compact table because it must stay readable
# next to the prompt it mirrors.
_ACTION_TOOLS = [
    ("run", "Run one shell command on this host and observe its output.",
     {"command": {"type": "string", "description": "the exact command to run"},
      "risk": {"type": "string", "enum": ["safe", "caution", "mutating", "danger"]},
      "reason": _STR,
      "background": {"type": "boolean", "description": "detach and poll with wait_job"},
      "expect_contains": {"type": "string",
                          "description": "literal text the output must contain; required "
                                         "when verifying a change"},
      "expect_exit_code": {"type": "integer",
                           "description": "exit-status proof; only 0, only for a related "
                                          "filesystem predicate such as test -f PATH"}},
     ["command"]),
    ("batch", "Run 2-8 independent proven read-only commands together.",
     {"commands": {"type": "array", "minItems": 2, "maxItems": 8,
                   "items": {"type": "object",
                             "properties": {"command": _STR, "step_id": _STR},
                             "required": ["command"]}}},
     ["commands"]),
    ("edit", "Replace literal text in a file.",
     {"path": _STR, "find": _STR, "replace": _STR}, ["path", "find", "replace"]),
    ("write", "Write a file, creating or overwriting it.",
     {"path": _STR, "content": _STR}, ["path", "content"]),
    ("plan", "Declare the ordered plan for this task before doing host work.",
     {"requires_host": {"type": "boolean",
                        "description": "false only when the task needs no host access"},
      "goals": {"type": "array", "items": {"type": "object", "properties":
                {"id": _STR, "description": _STR}, "required": ["description"]}},
      "steps": {"type": "array", "minItems": 1, "maxItems": 20,
                "items": {"type": "object", "properties":
                          {"id": _STR, "description": _STR, "verification": _STR,
                           "goal_ids": {"type": "array", "items": _STR},
                           "expected_mutation": {"type": "boolean"}},
                          "required": ["description", "verification"]}},
      "next_action": {"type": "object",
                      "description": "optional first action, same shape as any action"}},
     ["requires_host"]),
    ("wait_job", "Wait for a background job to finish.",
     {"job_id": {"type": "integer"},
      "timeout": {"type": "integer", "description": "seconds to wait, 1-3600"},
      "verify_command": {"type": "string",
                         "description": "proven read-only command run once the job exits"},
      "expect_contains": _STR},
     ["job_id"]),
    ("jobs", "List background jobs and their state.", {}, []),
    ("ask", "Ask the operator one question and wait for the answer.",
