def stop_with_results(obs_log, reason):
    """Stop the run but still surface the most useful real output already gathered."""
    emit_event("stopped", reason=reason)
    print(yellow(f"\n⚠ stopping: {reason}."))
    best = None
    for cmd, rc, output in reversed(obs_log):
        if (output or "").strip():
            best = (cmd, rc, output)
            if rc == 0:
                break
    if best:
        bcmd, brc, boutput = best
        print(grey("  most useful real output so far (from `{0}`, exit {1}):".format(
            sanitize_terminal(bcmd), brc)))
        print(sanitize_terminal(truncate_for_llm(boutput, 2000)))
    else:
        print(grey("  (no command produced output before stopping)"))


