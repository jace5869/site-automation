                   help="max command/observe iterations per task (default %(default)s; env GENAI_MAX_STEPS)")
    p.add_argument("--loop-limit", type=int, default=4,
                   help="stop only after this many CONSECUTIVE repeated/same-purpose command "
                        "strikes with no progress between them (default 4; the counter resets "
                        "after a successful non-duplicate command, successful edit/background "
                        "launch, or genuinely changed plan; a per-task repeat ceiling also applies)")
    p.add_argument("--timeout", type=int, default=120, help="per-command timeout in seconds")
    p.add_argument("--llm-timeout", type=int, default=None,
                   help="total seconds for one model turn, including fallbacks/retries "
