def _scrub_ctrl(s):
    """Remove stray control characters but PRESERVE leading/trailing whitespace —
    used for pasted block lines where indentation is meaningful (YAML!)."""
    return "".join(ch for ch in s if (ch >= " " and ch != "\x7f") or ch == "\t")


def _clean_line(s):
    """Drop stray control characters (e.g. a literal backspace/DEL that slipped into a line) so
    a mistyped-then-corrected command still matches the ':' commands. Keeps tab and unicode."""
    return "".join(ch for ch in s if (ch >= " " and ch != "\x7f") or ch == "\t").strip()


def _pending_stdin(wait=0.06):
    """True if more input is already waiting on stdin (i.e. a multi-line paste in flight).
    Only meaningful on a tty; safe False anywhere else."""
    try:
        import select
        if not sys.stdin.isatty():
            return False
        r, _, _ = select.select([sys.stdin], [], [], wait)
        return bool(r)
    except Exception:
        return False


_AUTO_PASTE_MAX = 2000   # sanity cap on auto-captured pasted lines


def read_task(prompt):
    """Read a task with multi-line support:
    - PASTE DIRECTLY: a multi-line paste at the prompt is auto-detected — the remaining
      lines arrive within milliseconds, so they are captured into one block automatically.
    - end a line with a trailing backslash to continue on the next line
    - type :paste for explicit block mode; finish with EOF/FINISH on its own line (or Ctrl-D)
    Each physical line is scrubbed of stray control chars; newlines between lines are kept."""
    line = _clean_line(read_tty(prompt))
    if line in (":paste", ":ml", ":multiline"):
        print(grey("  (paste mode — finish by typing EOF on its own line and pressing Enter)"))
        buf = []
        while True:
            try:
                nxt = read_tty("… ", eof=None, raw=True)
            except KeyboardInterrupt:
                print(grey("  (paste abandoned)"))
                return ""
            if nxt is None:                        # Ctrl-D also ends the block
                break
            if _clean_line(nxt) in ("EOF", "FINISH"):
                break
            buf.append(_scrub_ctrl(nxt))          # keep indentation — pasted YAML needs it
        return "\n".join(buf).strip("\n")

    # Auto-capture a direct multi-line paste: if more lines are already queued on stdin
    # right after this one, the user pasted a block — absorb it all as ONE input.
    if line and _pending_stdin():
        buf = [_scrub_ctrl(line)]
        while _pending_stdin() and len(buf) < _AUTO_PASTE_MAX:
            try:
                nxt = read_tty("", eof=None, raw=True)
            except KeyboardInterrupt:
                break
            if nxt is None:
                break
            buf.append(_scrub_ctrl(nxt))
        joined = "\n".join(buf).strip("\n")
        n = len(buf)
        if n > 1:
            print(grey(f"  (captured a {n}-line paste as one input)"))
            return joined

    parts = [line]
    while parts and parts[-1].endswith("\\") and not parts[-1].endswith("\\\\"):
        parts[-1] = parts[-1][:-1].rstrip()
        try:
            nxt = read_tty("… ")
        except (KeyboardInterrupt, EOFError):
            print()
            return ""
        parts.append(_scrub_ctrl(nxt))
    return "\n".join(parts).strip()


def read_tty(prompt, eof="", raw=False):
    """Read a line of input with proper line editing (backspace, arrows, history via the
    readline module). Falls back to reading the controlling terminal directly only when
    stdin isn't a usable tty.
    eof : value returned when the stream ends (Ctrl-D). Callers that need to distinguish
          end-of-input from a blank line pass a sentinel like None.
    raw : return the line without stripping (paste mode needs leading indentation)."""
    def _post(line):
        return line if raw else line.strip()
    if sys.stdin.isatty():
        try:
            return _post(input(prompt))
        except EOFError:
            return eof
        # KeyboardInterrupt intentionally propagates to the caller.
    try:
        with open("/dev/tty", "r") as tin, open("/dev/tty", "w") as tout:
            tout.write(prompt)
            tout.flush()
            line = tin.readline()
            if not line:
                return eof
            return _post(line.rstrip("\n"))
    except OSError:
        try:
            return _post(input(prompt))
        except EOFError:
            return eof


def read_secret(prompt):
    """Read a secret from the terminal without echoing it when the platform permits."""
    try:
        return getpass.getpass(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        raise
    except Exception:
        return read_tty(prompt + " (input visible) > ").strip()


