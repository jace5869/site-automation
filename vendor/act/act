    _CONFIG_ERRORS.append("ACT_API_FORMAT must be auto, openai or anthropic (got {0!r})".format(
        _FORMAT_ENV))
    _FORMAT_ENV = ""
_CHAT_SUFFIX_RE = re.compile(r"/chat/completions/?$")
_MESSAGES_SUFFIX_RE = re.compile(r"/messages/?$")


def chat_url(url):
    """The OpenAI chat/completions URL for a provider URL (a /messages URL is swapped back)."""
    url = (url or "").rstrip("/")
    return _MESSAGES_SUFFIX_RE.sub("/chat/completions", url) if _MESSAGES_SUFFIX_RE.search(url) \
        else url


def derived_anthropic_url(url):
    """The Anthropic Messages URL a provider URL implies: .../chat/completions -> .../messages."""
    url = (url or "").rstrip("/")
    if _CHAT_SUFFIX_RE.search(url):
        return _CHAT_SUFFIX_RE.sub("/messages", url)
    if _MESSAGES_SUFFIX_RE.search(url):
        return url
    return url + "/messages" if url else ""


def anthropic_url(name=None):
    p = _PROVIDER_STATE.get(name or PROVIDER) or {}
    url = API_URL if (name or PROVIDER) == PROVIDER else p.get("url", "")
    return p.get("anthropic_url") or derived_anthropic_url(url)


def format_url(fmt, name=None):
    """The endpoint a request in `fmt` goes to for the (active) provider."""
    if fmt == "anthropic":
        return anthropic_url(name)
    p = _PROVIDER_STATE.get(name or PROVIDER) or {}
    return chat_url(API_URL if (name or PROVIDER) == PROVIDER else p.get("url", ""))


def provider_format(name=None):
    """auto / openai / anthropic for a provider; ACT_API_FORMAT wins over the setup file."""
    if _FORMAT_ENV:
        return _FORMAT_ENV
    fmt = str((_PROVIDER_STATE.get(name or PROVIDER) or {}).get("format") or "auto").lower()
    return fmt if fmt in ("auto",) + _API_FORMATS else "auto"


def preferred_format(model=None):
    """The format to try first for a model nothing has been learned about: the one the
    configured URL names - exactly the request ACT sent before 0.6.19. Deliberately not
    guessed from the model name: AskSage serves its google-/aws-bedrock-claude-* models on
    chat/completions, and a model that is only served on /messages costs one refused request
    before auto mode switches and remembers it (:setup's probe learns it up front)."""
    if _MESSAGES_SUFFIX_RE.search(API_URL or ""):
        return "anthropic"
    return "openai"


def model_format(model=None):
    """(format, forced) for a request on the active provider: a forced format never switches;
    otherwise the format this model last answered on, else the preferred one."""
    forced = provider_format()
    if forced != "auto":
        return forced, True
    learned = (_PROVIDER_STATE.get(PROVIDER) or {}).get("formats", {}).get(model or MODEL)
    if learned in _API_FORMATS:
        return learned, False
    return preferred_format(model), False


def learn_model_format(model, fmt, persist=True):
    """Remember that `model` answers in `fmt` (session), and record it in an existing setup
    file. Only changes are written."""
    formats = _PROVIDER_STATE.setdefault(PROVIDER, {}).setdefault("formats", {})
    if formats.get(model) == fmt:
        return False
    formats[model] = fmt
    if persist:
        save_model_formats(PROVIDER)
    return True


