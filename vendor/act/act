def _probe_post(url, headers, payload, timeout):
    """One probe request -> (ok, status, raw). A 200 that carries an error object (some
    gateways answer {"response": "Token is invalid", "status": 400}) is not OK."""
    try:
        req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"),
                                     method="POST", headers=headers)
        with api_urlopen(req, timeout) as r:
            status = getattr(r, "status", None) or 200
            raw = _read_limited(r, MAX_API_RESPONSE_BYTES, "API response").decode(
                "utf-8", "replace")
    except urllib.error.HTTPError as e:
        return False, e.code, _read_limited(e, MAX_API_RESPONSE_BYTES,
                                            "API error response").decode("utf-8", "replace")
    except KeyboardInterrupt:
        raise
    except Exception as e:  # noqa: BLE001 — report it as this endpoint's result
        return False, None, "could not connect: {0}".format(getattr(e, "reason", None) or e)
    try:
        body = json.loads(raw)
    except ValueError:
        return False, status, raw
    if not isinstance(body, dict) or body.get("error") or body.get("type") == "error":
        return False, status, raw
    code = body.get("status")
    if isinstance(code, int) and code >= 400:
        return False, status, raw
    if not ("choices" in body or "content" in body):
        return False, status, raw
    return True, status, raw


def _probe_text(status, raw):
    if status is None:
        return sanitize_terminal(raw)
    return "HTTP {0}: {1}".format(status, api_error_reason(raw, 160))


def _probe_basic(fmt, model, timeout):
    """The smallest possible request: does this endpoint serve the model at all?"""
    key = _support_key(fmt, model)
    send = pseudo_outgoing([{"role": "user", "content": _PROBE_BASIC_PROMPT}])
    headers = _auth_headers(PROVIDER, KEY, {"Content-Type": "application/json"}, fmt=fmt)
    for _ in range(2):
        if fmt == "anthropic":
            payload = {"model": model, "max_tokens": 64, "messages": send}
        else:
            payload = {"model": model, "messages": send, token_param_for(key): 64}
        ok, status, raw = _probe_post(format_url(fmt), headers, payload, timeout)
        if ok:
            return True, "OK"
        if fmt == "openai" and status in (400, 422) and token_param_rejected(key, raw):
            continue
        return False, _probe_text(status, raw)
    return False, "HTTP 400"


def _probe_full(fmt, model, timeout):
    """ACT's real request shape (system prompt, temperature, tools/JSON mode, max tokens).
    Refused optional fields are dropped one at a time and remembered, like a real turn."""
    key, use_json_mode, use_tools, prefill = _request_features(fmt, model, PREFILL)
    messages = [{"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": _PROBE_FULL_PROMPT}]
    dropped = []
    for _ in range(6):
        url, headers, payload = build_model_request(pseudo_outgoing(messages), model, fmt,
                                                    use_json_mode, prefill, use_tools, key=key)
        ok, status, raw = _probe_post(url, headers, payload, timeout)
        if ok:
            if use_tools:
                _TOOLS_SUPPORT[key] = True
            return True, dropped
        if status in (400, 422):
            on = _fields_on(fmt, key, use_json_mode, use_tools, prefill)
            field = rejected_field(raw, on)
            if field == "token_param":
                if token_param_rejected(key, raw):
                    dropped.append("max_tokens (uses " + token_param_for(key) + ")")
                    continue
                field = rejected_field(raw, on - {"token_param"})
            if field:
                _drop_field(field, key)
                dropped.append(_FIELD_LABEL[field])
                key, use_json_mode, use_tools, prefill = _request_features(fmt, model, prefill)
                continue
        return False, _probe_text(status, raw)
    return False, "still refused after dropping " + ", ".join(dropped)


def _forget_request_shape(model):
    """A probe tests from scratch: forget what this model's endpoints refused before."""
    for fmt in _API_FORMATS:
        key = _support_key(fmt, model)
        for cache in (_JSON_MODE_SUPPORT, _TOOLS_SUPPORT, _TEMPERATURE_SUPPORT,
                      _TOOL_CHOICE_SUPPORT, _PREFILL_SUPPORT, _TOKEN_PARAM):
            cache.pop(key, None)


def probe_models(models, out=None):
    """:probe — test each model on BOTH endpoints: a basic request (is the model served
    there at all?) and ACT's full request (does it accept everything ACT sends?), printing
    the server's reason for every refusal. The working format is remembered per model (and
    written to an existing setup file). Returns {model: format or None}."""
    out = out or sys.stdout
    timeout = min(LLM_TIMEOUT, 60)
    forced = provider_format()
    models = [m for m in models if m]
    out.write(blue("Testing {0} model(s) on {1}, both endpoints:".format(
        len(models), _providers()[PROVIDER]["name"])) + "\n")
    for fmt in _API_FORMATS:
        out.write(grey("  {0:<19}{1}".format(_FORMAT_LABEL[fmt] + " endpoint",
                                             sanitize_terminal(format_url(fmt)))) + "\n")
    out.flush()
    chosen = {}
    for model in models:
        _forget_request_shape(model)
        out.write(bold(sanitize_terminal(model)) + "\n")
        results = {}
        for fmt in _API_FORMATS:
            try:
                ok, text = _probe_basic(fmt, model, timeout)
            except Exception as e:  # noqa: BLE001 — e.g. a masking error: nothing was sent
                ok, text = False, "not sent: " + sanitize_terminal(e)[:160]
            line = "  {0:<11}basic {1}".format(_FORMAT_LABEL[fmt], green(text) if ok else red(text))
            full = None
            if ok:
                try:
                    full = _probe_full(fmt, model, timeout)
                except Exception as e:  # noqa: BLE001
                    full = (False, "not sent: " + sanitize_terminal(e)[:160])
                if full[0]:
                    line += "   full " + green("OK" + (" without " + ", ".join(full[1])
                                                     if full[1] else ""))
                else:
                    line += "   full " + red(full[1])
            results[fmt] = (ok, full)
            out.write(line + "\n")
            out.flush()
        pref = preferred_format(model)
        order = lambda f: (0 if f == pref else 1)                  # noqa: E731
        full_ok = sorted((f for f in _API_FORMATS if results[f][1] and results[f][1][0]),
                         key=lambda f: (len(results[f][1][1]), order(f)))
        basic_ok = sorted((f for f in _API_FORMATS if results[f][0]), key=order)
        pick = (full_ok or basic_ok or [None])[0]
        chosen[model] = pick
        if pick:
            _PROVIDER_STATE[PROVIDER].setdefault("formats", {})[model] = pick
            note = "" if full_ok else " (only the basic request worked; ACT's full request did not)"
            out.write(green("  -> {0} endpoint".format(_FORMAT_LABEL[pick])) + grey(note) + "\n")
        else:
            out.write(red("  -> neither endpoint accepted this model — see the reasons above")
                      + "\n")
    if forced != "auto":
        out.write(yellow("  note: the endpoint format is set to {0} (ACT_API_FORMAT or :setup), "
                         "so requests stay on the {1} endpoint".format(
                             forced, _FORMAT_LABEL[forced])) + "\n")
    if len(models) > 1:
        out.write(blue("Summary: ") + ", ".join(
            "{0} -> {1}".format(sanitize_terminal(m), _FORMAT_LABEL[f] if f else "neither")
            for m, f in chosen.items()) + "\n")
    if any(chosen.values()) and save_model_formats(PROVIDER):
        out.write(grey("  (remembered in " + sanitize_terminal(act_config_path()) + ")") + "\n")
    out.flush()
    return chosen


def review_command(cmd, risk, reasons):
    """Confirm/edit/skip/quit. Returns ('run', final_cmd) | ('skip', None) | ('quit', None)."""
    while True:
        tag = {"danger": red("DANGEROUS"), "mutating": yellow("changes state"),
               "caution": yellow("caution"), "safe": green("safe")}.get(risk, risk)
        print()
        print(f"  {bold('proposed command')} [{tag}]")
        for r in reasons:
            if r:
                print("  " + grey("• " + sanitize_terminal(r)))
        print("    " + bold(sanitize_terminal(cmd)))
        choice = read_tty("  run? [y]es / [n]o / [e]dit / [q]uit > ").lower()
        if choice in ("y", "yes"):
            return "run", cmd
        if choice in ("", "n", "no"):
            return "skip", None
        if choice in ("q", "quit"):
            return "quit", None
        if choice in ("e", "edit"):
            new = read_tty("  new command > ").strip()
            if new:
                cmd = new
                risk, why = classify(cmd)
                reasons = [why] if why else []
            continue


