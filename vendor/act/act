# Which optional field an HTTP 400/422 names. Order matters: the first on-feature named wins.
_REJECT_PATTERNS = (
    ("token_param", re.compile(r"max_completion_tokens|max_tokens", re.I)),
    ("temperature", re.compile(r"temperature", re.I)),
    ("tool_choice", re.compile(r"tool_choice", re.I)),
    ("tools", re.compile(r"\btools?\b|function|tool_use", re.I)),
    ("json", re.compile(r"response_format|json_object|json_schema|json mode", re.I)),
    ("prefill", re.compile(r"prefill|final assistant|assistant message|last message|"
                           r"must end with|conversation must", re.I)),
)
_FIELD_LABEL = {"token_param": "max_tokens", "temperature": "temperature",
                "tool_choice": "tool_choice", "tools": "tools", "json": "JSON mode",
                "prefill": "the '{' prefill"}


def rejected_field(detail, on):
    """The first optional request field the error text names that is ON for this request
    (`on` = set of field names), or None when it names none of them (e.g. "invalid model")."""
    for field, pattern in _REJECT_PATTERNS:
        if field in on and pattern.search(detail or ""):
            return field
    return None


def api_error_reason(raw, limit=300):
    """The server's own explanation from an error body, secrets scrubbed, one line."""
    text = raw if isinstance(raw, str) else ""
    reason = ""
    try:
        body = json.loads(text) if text.strip() else None
    except ValueError:
        body = None
    if isinstance(body, dict):
        err = body.get("error")
        if isinstance(err, dict):
            reason = err.get("message") or err.get("msg") or json.dumps(err)
        elif isinstance(err, str) and err:
            reason = err
        else:
            for k in ("message", "detail", "response", "msg"):
                v = body.get(k)
                if isinstance(v, str) and v:
                    reason = v
                    break
                if v not in (None, "", [], {}):
                    reason = json.dumps(v)
                    break
    if not reason:
        reason = text
    reason = re.sub(r"\s+", " ", str(reason)).strip()
    for secret in _secret_values():
        reason = reason.replace(secret, "[REDACTED]")
    if len(reason) > limit:
        reason = reason[:limit] + " ..."
    return sanitize_terminal(reason) if reason else "(no reason given)"
