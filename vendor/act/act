AUDIT_PATH = os.environ.get("ACT_AUDIT_LOG", "").strip()   # --audit-log / $ACT_AUDIT_LOG
_JSON_OUT = None                                      # real stdout for NDJSON (decorative -> stderr)
# --result-file / $ACT_RESULT_FILE: one structured JSON summary of a one-shot run, written on
