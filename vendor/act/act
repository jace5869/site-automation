_USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


class Spinner:
    """A lightweight 'thinking…' indicator shown on stderr while we wait on the API."""
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, label="working"):
        self.label = label
        self._stop = threading.Event()
        self._t = None
        self._started = 0.0
        self.enabled = sys.stderr.isatty() and os.environ.get("NO_COLOR") is None

    def __enter__(self):
        self._started = time.monotonic()
        if self.enabled:
            self._t = threading.Thread(target=self._spin, daemon=True)
            self._t.start()
        return self

    def _spin(self):
        i = 0
        while not self._stop.is_set():
            f = self.FRAMES[i % len(self.FRAMES)]
            g = _THEME.get("grey", "90")
            pre, post = (f"\033[{g}m", "\033[0m") if g else ("", "")
            elapsed = max(0, int(time.monotonic() - self._started))
            sys.stderr.write(f"\r{pre}{f} {self.label}… {elapsed}s{post}")
            sys.stderr.flush()
            i += 1
            time.sleep(0.1)

    def __exit__(self, *a):
        self._stop.set()
        if self._t:
            self._t.join(timeout=0.25)
        if self.enabled:
            sys.stderr.write("\r\033[K")
            sys.stderr.flush()


def c(text, code):
    if not _USE_COLOR or not code:
        return text
    return f"\033[{code}m{text}\033[0m"


