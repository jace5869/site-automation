        print(f"  genai_beta_url={beta['url']}  genai_beta_key={'set' if beta['key'] else 'MISSING'}")
        return 0

    if args.theme:
        if args.theme.strip().lower() == "list":
            _preview_themes()
            return 0
        set_theme(args.theme)   # CLI overrides $ACT_THEME

    print_banner()
    if args.provider:
        set_provider(args.provider)          # repoints API_URL/KEY/MODEL at that provider
    if args.model:
        set_provider(PROVIDER, args.model)   # override + persist for the active provider
    if args.pick_model and sys.stdin.isatty():
        _p, _m = choose_model(MODEL)
        set_provider(_p, _m)
    if args.no_tools:
        TOOLS_MODE = False
    if args.plan_model:
        PLAN_MODEL = args.plan_model.strip()
    if args.race:
        RACE = True
    if args.url:
        API_URL = args.url
    if args.llm_timeout is not None:
        LLM_TIMEOUT = args.llm_timeout
    if args.backend:
        BACKEND = args.backend
    if args.no_autoheal:
        AUTOHEAL = False
    if args.auto:
        AUTO = True
    NONINTERACTIVE = args.non_interactive
    if PREAPPROVED:
        print(grey("note: {0} pre-approved command pattern(s) (--allow): {1}".format(
            len(PREAPPROVED), ", ".join(sanitize_terminal(src) for src, _rx in PREAPPROVED))),
            file=sys.stderr)
    if AUTO:
        print(yellow("⚠ AUTO mode: service, package-install, config and ordinary file changes "
                     "run WITHOUT asking."), file=sys.stderr)
        print(grey("  The danger tier (forced deletes, package removal, credentials/sudo/ssh "
                   "keys, disks, firewall, power state, code-exec vectors) and edits of "
                   "auth/boot/system-binary files still prompt"
                   + ("; in non-interactive mode they are refused unless an --allow pattern "
                      "matches." if NONINTERACTIVE else ".")),
              file=sys.stderr)
    if args.project_context:
        LOAD_PROJECT_CONTEXT = True
    insecure_env = os.environ.get("GENAI_INSECURE", "").lower() in ("1", "true", "yes")
    if insecure_env and not args.insecure:
        print(red("GENAI_INSECURE is set, but insecure TLS now requires the explicit --insecure "
                  "acknowledgment."), file=sys.stderr)
        return 2
    if args.insecure:
        ALLOW_INSECURE_TLS = True
        print(red("WARNING: TLS certificate verification is DISABLED for " + API_URL),
              file=sys.stderr)

    if DEBUG:
        sys.stderr.write(grey("[debug] act {0} — provider={1} model={2} url={3} max_tokens={4}\n".format(
            ACT_VERSION, sanitize_terminal(PROVIDER), sanitize_terminal(MODEL),
            sanitize_terminal(API_URL), MAX_TOKENS)))
    if BACKEND == "api" and not KEY:
        if NONINTERACTIVE or not sys.stdin.isatty():
            print(red("No API key is configured. Run ACT interactively and use :setup; "
                      "non-interactive input cannot answer a secret prompt."), file=sys.stderr)
            return 2
        try:
            invoke_setup(initial=True)
        except (EOFError, KeyboardInterrupt):
            print(red("\nSetup cancelled; no API key was configured."), file=sys.stderr)
            return 2
        if not KEY:
            return 2

    try:
        if os.geteuid() == 0:
            print(red("WARNING: ACT is running as root. Only proven read-only commands auto-run; "
                      "drop privileges whenever possible."), file=sys.stderr)
        else:
            print(yellow("note: not running as root — commands needing elevation will fail unless "
                         "they use sudo."), file=sys.stderr)
    except AttributeError:
        pass

    # Piped input (e.g. `cat file | act "analyze this"`) → one-shot analysis of that
    # content, not the command loop. Matches the muscle memory of piping into `ask`.
    piped = ""
    if not sys.stdin.isatty() and args.task and not args.allow_piped_upload:
        import select
        # A task was given and uploading stdin is not allowed, so stdin is only inspected to
        # refuse stray input. An open, never-closed pipe (CI runners, subprocess stdin=PIPE)
        # must not hang the run: wait briefly for data and carry on if there is none.
        try:
            ready, _, _ = select.select([sys.stdin], [], [], 1.0)
            if ready:
                first = os.read(sys.stdin.fileno(), 65536)
                if first.strip():
                    _RESULT_TASK = " ".join(args.task)
                    print(red("refusing to upload piped input without --allow-piped-upload"),
                          file=sys.stderr)
                    return 2
        except (OSError, ValueError):
            pass
    elif not sys.stdin.isatty():
        try:
            raw_piped = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
            if len(raw_piped) > MAX_INPUT_BYTES:
                print(red("piped input exceeds the {0}-byte limit".format(MAX_INPUT_BYTES)),
                      file=sys.stderr)
                return 2
            piped = raw_piped.decode("utf-8", "strict")
        except UnicodeDecodeError:
            print(red("piped input is not valid UTF-8"), file=sys.stderr)
            return 2
        except Exception as e:
            print(red("could not read piped input: " + sanitize_terminal(e)), file=sys.stderr)
            return 2

    task = " ".join(args.task)

    if piped.strip():
        _RESULT_TASK = task or "(analysis of piped input)"
        if not args.allow_piped_upload:
            print(red("refusing to upload piped input without --allow-piped-upload"),
                  file=sys.stderr)
            return 2
        return analyze_once(task, piped)

    def run_one(task):
        try:
            return agent_loop(task, max_steps=args.max_steps, timeout=args.timeout,
                              loop_limit=args.loop_limit)
        except KeyboardInterrupt:
            emit_event("cancelled", reason="interrupted")
            print(grey("\ninterrupted."))
            return 4

    if task:
        return run_one(task)

    # Conversational session: ONE Session, context (and cwd) carry across turns.
    print(bold("agent session") + grey("  — type a task; it remembers the conversation."))
    print(grey("  quick commands  ") + blue(":help") + grey("  ·  ") + blue(":status")
          + grey("  ·  ") + blue(":setup") + grey("  ·  ") + blue(":paste"))
    print(grey("  session tools   ") + blue(":auto") + grey("  ·  ") + blue(":model")
          + grey("  ·  ") + blue(":theme") + grey("  ·  ") + blue(":reset")
          + grey("  ·  ") + blue(":cwd") + grey("    blank/Ctrl-D quits"))
    live_note = ""
    if MODEL_DISCOVERY and provider_configured(PROVIDER):
        discovered = refresh_provider_models(PROVIDER)
        if _providers()[PROVIDER].get("models_live"):
            live_note = f"    {len(discovered)} models available (:models)"
    print(grey(f"  model: {provider_label()}    auto-approve: {'ON' if AUTO else 'off'}"
               + ("    race: ON" if RACE else "") + live_note))
    session = Session()
    while True:
        try:
            task = read_task("\nagent> ")
        except KeyboardInterrupt:
            print()
            continue
        if not task:
            break
        if task in (":help", ":h", "?", ":commands"):
            print_repl_help()
            continue
        if task in (":status", ":info"):
            print_session_status(session)
            continue
        if task in (":setup", ":key"):
            try:
                invoke_setup()
            except (EOFError, KeyboardInterrupt):
                print(grey("\n  (setup cancelled)"))
            continue
        if task in (":reset", ":new", ":clear"):
            session = Session()
            print(grey("  (context cleared — fresh session)"))
            continue
        if task in (":undo", ":revert"):
            reverted, msgs = perform_undo(list(_MUTATION_JOURNAL))
            for msg in msgs:
                print(grey("  " + msg))
            print(grey("  (reverted {0} file change(s) this session)".format(reverted))
                  if msgs else grey("  (no file changes to undo this session)"))
            _MUTATION_JOURNAL.clear()
            continue
        if task in (":jobs", ":job"):
            print(grey("  " + sanitize_terminal(poll_jobs()).replace("\n", "\n  ")))
            continue
        if task in (":model", ":m"):
            _p, _m = choose_model(MODEL)
            set_provider(_p, _m)
            print(grey(f"  model: {provider_label()}"))
            continue
        if task == ":models":
            live = get_provider_models(PROVIDER)
            if live:
                _providers()[PROVIDER]["models"] = live
                _providers()[PROVIDER]["models_live"] = True
                print(grey(f"  {PROVIDER} models (live): ") + ", ".join(live))
            else:
                print(grey(f"  {PROVIDER}: live list unavailable (no key/endpoint or unsupported). "
                           "Known: ") + ", ".join(_providers()[PROVIDER]["models"]))
            continue
        if task == ":probe" or task.startswith(":probe "):
            arg = task[7:].strip()
            if not KEY:
                print(yellow("  no API key for {0} — run :setup first".format(PROVIDER)))
                continue
            try:
                if arg.lower() == "all":
                    models = probe_model_list()
                    ans = read_tty("  Test {0} models on both endpoints (about {1} small "
                                   "requests)? [y/N] > ".format(len(models), 4 * len(models)))
                    if ans.strip().lower() not in ("y", "yes"):
                        print(grey("  (probe cancelled)"))
                        continue
                else:
                    models = [arg or MODEL]
                probe_models(models)
            except (EOFError, KeyboardInterrupt):
                print(grey("\n  (probe cancelled)"))
            continue
        if task == ":provider" or task.startswith(":provider "):
            arg = task[10:].strip().lower() if task.startswith(":provider ") else ""
            names = list(_providers())
            if not arg:
                for i, n in enumerate(_providers().items(), 1):
                    n, p = n
                    mark = green(" ●") if n == PROVIDER else "  "
                    cfg = "" if provider_configured(n) else yellow(" (no key)")
                    print(grey(f"  {i}){mark} {n}: {p['name']} — {p['model']}{cfg}"))
            else:
                target = names[int(arg) - 1] if arg.isdigit() and 1 <= int(arg) <= len(names) else arg
                if set_provider(target):
                    print(grey(f"  provider: {provider_label()}"))
                else:
                    print(grey(f"  unknown provider '{arg}' (" + " / ".join(_providers()) + ")"))
            continue
        if task == ":tools" or task.startswith(":tools "):
            arg = task[7:].strip().lower()
            TOOLS_MODE = (arg in ("on", "1", "true", "yes")) if arg else (not TOOLS_MODE)
            _TOOLS_SUPPORT.clear()      # re-probe the endpoint after a deliberate change
            _TOOL_CHOICE_SUPPORT.clear()
            _TOKEN_PARAM.clear()
            if TOOLS_MODE:
                print(grey("  tools: ON — the endpoint enforces the action schema "
                           "(falls back to JSON mode if it rejects them)"))
            else:
                print(grey("  tools: off — actions are parsed out of the reply text"))
            continue
        if task == ":planmodel" or task.startswith(":planmodel "):
            arg = task[11:].strip()
            if arg.lower() in ("off", "none", "clear", "0"):
                PLAN_MODEL = ""
                print(grey("  plan model: off — " + provider_label() + " plans and executes"))
            elif arg:
                known = refresh_provider_models(PROVIDER)
                PLAN_MODEL = arg
                print(grey("  plan model: " + arg + " — executing on " + MODEL))
                if known and arg not in known:
                    print(yellow("  note: '" + arg + "' is not in this provider's model list "
                                 "(':models' to see it). Kept anyway — the list can be stale."))
            elif PLAN_MODEL:
                print(grey("  plan model: " + PLAN_MODEL + " — executing on " + MODEL))
            else:
                print(grey("  plan model: off — " + provider_label() + " plans and executes"))
            continue
        if task == ":race" or task.startswith(":race "):
            arg = task[6:].strip().lower()
            RACE = (arg in ("on", "1", "true", "yes")) if arg else (not RACE)
            if RACE:
                racers = race_model_list()
                print(yellow("  race: ON") + grey(" — the planning turn goes to "
                      f"{len(racers)} models; {MODEL} judges the answers (pick or merge) "
                      "and runs the task"))
                print(grey("  racers: " + ", ".join(racers)))
            else:
                print(grey(f"  race: off — single model ({provider_label()})"))
            continue
        if task == ":pseudo" or task.startswith(":pseudo "):
            arg = task[7:].strip().lower()
            if arg in ("on", "off", "1", "0", "true", "false", "yes", "no"):
                PSEUDONYMIZE = arg in ("on", "1", "true", "yes")
            rows = pseudonymizer().table() if PSEUDONYMIZE else []
            print((green("  masking: ON") if PSEUDONYMIZE else yellow("  masking: OFF"))
                  + grey(" - host names, IP addresses, user names and e-mail addresses are "
                         + ("replaced with placeholders before anything is sent"
                            if PSEUDONYMIZE else "sent to the model as they are")))
            if arg == "show" or (not arg and rows):
                if not rows:
                    print(grey("  nothing masked yet in this session"))
                for real, placeholder in rows:
                    print(grey("  {0:<28} -> ".format(placeholder)) + sanitize_terminal(real))
            continue
        if task == ":tokens":
            sess = TOKENS_USED.get(PROVIDER, 0)
            print(grey(f"  this session ({PROVIDER}): "
                       + (f"{sess} tokens" if sess else "usage not reported by the API")))
            continue
        if task == ":theme" or task.startswith(":theme ") or task == ":themes":
            name = task[7:].strip() if task.startswith(":theme ") else ""
            if not name:
                _preview_themes()
                name = read_tty("  theme name > ").strip()
            if name:
                set_theme(name)
                print("  " + "  ".join([grey("dim"), green("ok"), yellow("warn"),
                                        red("danger"), blue("accent")]) + grey("  ← active theme"))
            continue
        if task == ":auto" or task.startswith(":auto ") or task in (":auto-approve", ":y"):
            arg = task[6:] if task.startswith(":auto ") else ("on" if task == ":y" else "")
            _toggle_auto(arg)
            if AUTO:
                print(yellow("  auto-approve: ON") + grey(" — the danger tier and sensitive-file "
                      "edits still prompt (refused in non-interactive mode)"))
            else:
                print(grey("  auto-approve: off — anything not a proven read-only command asks first"))
            continue
        if task in (":cwd", ":pwd"):
            print(grey(f"  cwd: {session.cwd}"))
            continue
        if task.startswith("!") and len(task) > 1:
            # Direct shell passthrough (no model involved) — like Claude Code's `!`.
            # Same safety contract: classify, and confirm danger/mutating per current mode.
            sh_cmd = task[1:].strip()
            risk, why = classify(sh_cmd)
            if needs_confirm(risk, sh_cmd):
                if NONINTERACTIVE:
                    print(red("  ✗ policy denied: command requires confirmation"))
                    continue
                decision, final = review_command(sh_cmd, risk, [why] if why else [])
                if decision == "skip":
                    print(grey("  (skipped)"))
                    continue
                if decision == "quit":
                    break
                sh_cmd = final or sh_cmd
            result = run_command(sh_cmd, timeout=args.timeout, cwd=session.cwd)
            rc, out_text = result
            session.cmds += 1
            session.cwd = update_cwd(sh_cmd, session.cwd)
            print(grey(f"  ⎿ exit {rc}"))
            # Let the model see what the operator did so follow-up tasks have context.
            direct_record = ("[Operator ran a shell command directly]\n$ " + sh_cmd
                             + "\n(exit {0})\n".format(rc)
                             + truncate_for_llm(out_text or "(no output)", 2000))
            direct_record, changed = model_safe_text(direct_record, "direct shell history")
            if changed:
                print(yellow("  ⚠ sensitive direct-command data was redacted from model history"))
            session.messages.append({"role": "user", "content": direct_record})
            continue
        try:
            run_turn(session, task, max_steps=args.max_steps, timeout=args.timeout,
                     loop_limit=args.loop_limit)
        except KeyboardInterrupt:
            session.messages.append({"role": "user",
                                     "content": "[The previous task was interrupted by the user before it "
                                                "finished. Await the next instruction.]"})
            print(grey("\n  (task interrupted; session context kept)"))
    exit_animation(session)
    return 0


if __name__ == "__main__":
    sys.exit(main())
