def _toggle_auto(arg=""):
    """Resolve a ':auto [on|off]' argument to a new AUTO state and set it. Returns the bool.
    Bare ':auto' (empty arg) flips the current state."""
    global AUTO
    a = (arg or "").strip().lower()
    if a in ("on", "1", "yes", "true", "y"):
        AUTO = True
    elif a in ("off", "0", "no", "false", "n"):
        AUTO = False
    else:
        AUTO = not AUTO
    return AUTO


