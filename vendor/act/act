        PSEUDONYMIZE = False
    _PSEUDO_EXTRA_NAMES.extend(args.pseudo_name)
    if args.result_file:
        RESULT_PATH = args.result_file
    if args.task and not (args.version or args.undo):
        _RESULT_TASK = " ".join(args.task)
    PREAPPROVED, allow_errors = compile_preapproved(
        list(args.allow) + os.environ.get("ACT_ALLOW", "").splitlines())
    if allow_errors:
        for err in allow_errors:
            print("act: " + err, file=sys.stderr)
            emit_event("error", message=err)
        return 2
    set_provider(PROVIDER)   # resolve $ACT_PROVIDER (or default) into the active url/key/model
    NDJSON_MODE = args.json
    if args.audit_log:
        AUDIT_PATH = args.audit_log
    if NDJSON_MODE:
        # Keep stdout a pure NDJSON stream: send all decorative output + live command
        # echo to stderr, and emit events to the saved real stdout.
        global _JSON_OUT, _USE_COLOR
        _JSON_OUT = sys.stdout
        sys.stdout = sys.stderr
        _USE_COLOR = False

    if args.undo:
        reverted, msgs = perform_undo()
        for msg in msgs:
            print(("  " + msg) if not NDJSON_MODE else "", end="" if NDJSON_MODE else "\n")
            if NDJSON_MODE:
                emit_event("undo_item", detail=msg)
        summary = "reverted {0} file mutation(s) from the last session".format(reverted)
        if NDJSON_MODE:
            emit_event("undo_done", reverted=reverted)
        else:
            print(("act: " + summary) if msgs else "act: nothing to undo")
        return 0

    if _CONFIG_ERRORS:
        for error in _CONFIG_ERRORS:
            print("act: configuration error: " + error, file=sys.stderr)
        return 2
    for name, value, minimum, maximum in (
            ("--max-steps", args.max_steps, 1, 500),
            ("--loop-limit", args.loop_limit, 1, 100),
            ("--timeout", args.timeout, 1, 86400),
            ("--llm-timeout", args.llm_timeout, 1, 3600)):
