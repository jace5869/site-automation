    _TOKEN_PARAM_FORCED = ""
_TOKEN_PARAM = {}                                  # key -> field name in use
_TOKEN_PARAM_REJECT_RE = re.compile(r"max_completion_tokens|max_tokens", re.I)


def token_param_for(support_key):
    """Field name that carries MAX_TOKENS for this endpoint."""
    return _TOKEN_PARAM_FORCED or _TOKEN_PARAM.get(support_key) or "max_tokens"


def token_param_rejected(support_key, detail):
    """True when an HTTP 400/422 body complains about the output-limit field we sent.
    Flips the endpoint's remembered field to the other name so the retry (and every
    later call) uses it. Flips at most once per endpoint so two picky errors can't
    ping-pong forever, and never overrides an explicit ACT_TOKEN_PARAM."""
    if _TOKEN_PARAM_FORCED or not _TOKEN_PARAM_REJECT_RE.search(detail or ""):
        return False
    if support_key in _TOKEN_PARAM:
        return False
    current = token_param_for(support_key)
    _TOKEN_PARAM[support_key] = "max_completion_tokens" if current == "max_tokens" else "max_tokens"
    return True


# ---- Request formats (0.6.19) ----
# "openai"    POST <url>            chat/completions body (every release before 0.6.19)
# "anthropic" POST <anthropic url>  Anthropic Messages body: top-level system, max_tokens
#                                   always, no response_format, tools with input_schema
