def _session_id():
    global _SESSION_ID
    if _SESSION_ID is None:
        _SESSION_ID = time.strftime("%Y%m%dT%H%M%S") + "-" + str(os.getpid())
    return _SESSION_ID


def _append_jsonl(path, rec, mode=0o600):
    """Append one JSON object as a line to path (O_APPEND is atomic for small writes)."""
    line = (json.dumps(rec, default=str) + "\n").encode("utf-8", "replace")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, mode)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)


def emit_event(kind, **fields):
    """Emit one structured event: NDJSON on stdout when --json is on, and appended to the
    audit log when configured. Never raises into the agent loop."""
    global _AUDIT_WARNED
    rec = {"ts": round(time.time(), 3), "session": _session_id(), "event": kind}
    rec.update(fields)
    if RESULT_PATH and len(_RESULT_EVENTS) < _RESULT_EVENT_CAP:
        _RESULT_EVENTS.append(rec)
    if NDJSON_MODE:
        out = _JSON_OUT if _JSON_OUT is not None else sys.stdout
        try:
            out.write(json.dumps(rec, default=str) + "\n")
            out.flush()
        except (OSError, ValueError):
            pass
    if AUDIT_PATH:
        try:
            _append_jsonl(AUDIT_PATH, rec)
        except OSError as e:
            if not _AUDIT_WARNED:
                _AUDIT_WARNED = True
                sys.stderr.write("act: could not write audit log {0}: {1}\n".format(
                    AUDIT_PATH, sanitize_terminal(str(e))))


