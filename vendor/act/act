            p.error("{0} must be between {1} and {2}".format(name, minimum, maximum))

    if args.version:
        print(f"act {ACT_VERSION}")
        print(f"  provider={PROVIDER} model={MODEL}")
        print(f"  ACT_DEBUG={'on' if DEBUG else 'off'}  max_tokens={MAX_TOKENS}  auto={'on' if AUTO else 'off'}")
