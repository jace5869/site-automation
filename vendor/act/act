def choose_model(current=None):
    """Interactive provider + model picker. Returns (provider, model), or (PROVIDER, current) if
    kept/cancelled. Offers a live /models fetch per provider, falling back to the curated list."""
    provs = _providers()
    names = list(provs)
    print(bold("\nselect a provider:"))
    for i, n in enumerate(names, 1):
        p = provs[n]
        cur = green("  ● current") if n == PROVIDER else ""
        cfg = "" if provider_configured(n) else yellow("  (no key set)")
        print(f"  {i}) {bold(p['name'])}{cur}{cfg}")
    try:
        sel = read_tty("> ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(); return PROVIDER, current
    if sel in ("", "q", "quit", "k", "keep"):
        return PROVIDER, current
    prov = None
    if sel.isdigit() and 1 <= int(sel) <= len(names):
        prov = names[int(sel) - 1]
    elif sel in provs:
        prov = sel
    if prov is None:
        print(grey("  keeping current")); return PROVIDER, current

    p = provs[prov]
    print(grey(f"  fetching {p['name']} models…"))
    try:
        live = get_provider_models(prov)
    except KeyboardInterrupt:
        live = []
        print(grey("  (skipped live fetch)"))
    models = live or p["models"]
    src = "live" if live else "known"
    print(bold(f"\nselect a model for {p['name']} ") + grey(f"({src} list; 'c' = custom, 'q' = keep):"))
    for i, m in enumerate(models, 1):
        cur = green("  ● current") if (m == current and prov == PROVIDER) else ""
        print(f"  {i}) {m}{cur}")
    print(f"  c) {grey('custom model string')}")
    while True:
        try:
            choice = read_tty("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print(); return PROVIDER, current
        low = choice.lower()
        if low in ("", "q", "quit", "k", "keep"):
            return PROVIDER, current
        if low in ("c", "custom"):
            name = read_tty("  model string > ").strip()
            return (prov, name) if name else (PROVIDER, current)
        if choice.isdigit() and 1 <= int(choice) <= len(models):
            return prov, models[int(choice) - 1]
        for m in models:
            if low == m.lower():
                return prov, m
        print(grey("  enter a number, 'c' for a custom string, or 'q' to keep current"))


def exit_animation(session=None):
    """Brief themed sign-off with a session summary. Plain text when piped/NO_COLOR."""
    turns = getattr(session, "turns", 0)
    cmds = getattr(session, "cmds", 0)
    dur = max(0, int(time.time() - getattr(session, "started", time.time())))
    summary = ("session ended — {0} task{1} · {2} command{3} · {4}m{5:02d}s"
               .format(turns, "" if turns == 1 else "s", cmds, "" if cmds == 1 else "s",
                       dur // 60, dur % 60))
    if not (sys.stdout.isatty() and _USE_COLOR):
        print("bye — " + summary)
        return
    width = 26
    try:
        for i in range(width):
            bar = "─" * i + "⏺" + "─" * (width - i - 1)
            sys.stdout.write("\r" + blue(bar))
            sys.stdout.flush()
            time.sleep(0.012)
        sys.stdout.write("\r" + " " * (width + 2) + "\r")
    except Exception:
        pass
    print(blue("⏺ ") + grey(summary))


def main():
    """CLI entry. With --result-file / ACT_RESULT_FILE, a task run writes its act.result/1
    summary on EVERY exit path: success, refusal, setup error, Ctrl-C, or a crash."""
    started = time.time()
    rc = 1
    try:
        rc = _main()
        return rc
    except KeyboardInterrupt:
        emit_event("cancelled", reason="interrupted")
        rc = 130
        raise
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) else (0 if e.code is None else 2)
        raise
    except BaseException as e:
        emit_event("error", message="crash: {0}: {1}".format(type(e).__name__, str(e)[:300]))
        rc = 1
        raise
    finally:
        if RESULT_PATH and _RESULT_TASK is not None:
            write_result_file(RESULT_PATH, build_result(
                _RESULT_EVENTS, rc, started, time.time(), _RESULT_TASK, _result_context()))


def _main():
