_TERM_OSC_RE = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
_TERM_CSI_RE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|[@-_])")


def sanitize_terminal(text):
    """Remove terminal escape/control sequences from untrusted text."""
    s = _TERM_OSC_RE.sub("", str(text or ""))
    s = _TERM_CSI_RE.sub("", s)
    return "".join(ch for ch in s if ch in "\n\r\t" or ord(ch) >= 32)


