    global ALLOW_INSECURE_TLS, NONINTERACTIVE, LOAD_PROJECT_CONTEXT, NDJSON_MODE, AUDIT_PATH
    global RACE, PLAN_MODEL, TOOLS_MODE, RESULT_PATH, PREAPPROVED, _RESULT_TASK, PSEUDONYMIZE
