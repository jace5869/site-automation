django.db.utils.OperationalError: server closed the connection unexpectedly"""
TASK = """2026-11-05 10:00:59,000 INFO [-] awx.main.dispatch task 1 ok, errors: 0
2026-11-05 10:01:00,000 ERROR [-] awx.main.dispatch worker pid 99 is gone - reaping it
2026-11-05 10:01:01,000 ERROR [-] awx.main.commands.run_callback_receiver callback receiver failed to save event"""
# EDA's ERROR line says only where (rest_framework's dispatch); the message is on the lines after it
EDA = """2026-11-05 10:03:00,000 INFO dispatcherd.service.main Control action alive [x] ROE
2026-11-05 10:03:01,123 ERROR [rid:5f1c2a9e-1111-4c2b-9d3e-0a1b2c3d4e5f] aap_eda.api.exceptions /usr/lib/python3.12/site-packages/rest_framework/views.py:497 dispatch
