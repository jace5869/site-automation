C = [  # name, state, status, started (s ago), restarts, mounts
    ("automation-gateway-proxy", "running", "Up 3 hours", 10800, 0, [(FAKE + "/gateway.cert", "/etc/ansible-automation-platform/gateway/gateway.cert")]),
    ("automation-gateway", "running", "Up 3 hours", 10800, 0, [(FAKE + "/gateway.cert", "/etc/gw/gateway.cert"), (FAKE + "/gateway.key", "/etc/gw/gateway.key")]),
    ("automation-controller-web", "running", "Up 3 hours", 10800, 0, [(FAKE + "/tower.cert", "/etc/tower/tower.cert"),
                                                                       (FAKE + "/receptor.sock", "/var/run/receptor/receptor.sock")]),
    ("automation-controller-task", "running", "Up 3 minutes", 180, 0, [(FAKE + "/receptor.sock", "/run/awx-receptor/receptor.sock")]),
    ("automation-controller-rsyslog", "exited", "Exited (1) 5 minutes ago", 0, 0, []),
    ("automation-hub-api", "running", "Up 2 hours", 7200, 5, []),
    ("automation-eda-api", "running", "Up 3 hours", 10800, 0, []),
    ("postgresql", "running", "Up 3 hours", 10800, 0, [(FAKE + "/pgdata", "/var/lib/pgsql/data")]),
    ("receptor", "running", "Up 3 hours", 10800, 0, []),
    ("redis-unix", "running", "Up 3 hours", 10800, 0, []),
    ("someone-elses", "running", "Up 1 day", 90000, 0, []),
]
PROXY = """[2026-11-05T10:00:00.000Z] "GET /api/controller/v2/ping/ HTTP/1.1" 200 - 0 512 12 11 "-" "curl/8" "id1" "aap" "127.0.0.1:8052"
[2026-11-05T10:00:01.000Z] "GET /api/controller/v2/inventories/8/hosts/?page_size=100 HTTP/1.1" 503 - 0 95 13012 13010 "-" "Mozilla/5.0" "id2" "aap" "127.0.0.1:8052"
[2026-11-05T10:00:02.000Z] "GET /api/controller/v2/inventories/8/hosts/?page_size=100 HTTP/1.1" 503 - 0 95 13230 13228 "-" "Mozilla/5.0" "id3" "aap" "127.0.0.1:8052"
