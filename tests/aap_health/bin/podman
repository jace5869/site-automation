#!/usr/bin/env python3
"""A stand-in for the AAP host's rootless podman (tests/test_aap_health.py): canned answers, read-only like the real
checks expect. AAPH_FAKE = the test's folder (certificate files); AAPH_PEER_REFUSE=1 = psql's peer login refused."""
