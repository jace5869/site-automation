GW = """2026-11-05 10:02:00,000 ERROR django.request Internal Server Error: /api/gateway/v1/status/
2026-11-05 10:02:01,000 INFO aap.gateway.authentication.basic_auth User x performed a GET to /api/x/?errors=1
2026-11-05 10:02:02,000 ALWAYS aap.dispatcherd ANSIBLE_RULEBOOK_LOG_LEVEL: error"""
SECTIONS = {
    "inventories": "1|Demo Inventory|2|200|100|120|0|0\n8|AD hosts|1500|92160000|61440|240000|3000000|4000",
    "hostjobs": "1|10|5\n8|1320000|7500",
    "hostgroups": "1|2|1|1\n8|900|450|300",
    "dead": "main_host|176|90000|2026-10-01 00:00:00+00|",
    "dbsize": "4294967296",
    "tables": "main_jobevent|2147483648|9000000\nmain_host|80000000|1502",
    "conns": "45|100",
    "long": "4242|awx|awx|active|95|SELECT main_host.variables FROM main_host WHERE inventory_id = 8",
    "idle_tx": "4300|awx|awx|400|UPDATE main_unifiedjob SET status='running'",
    "jobevents": "25000000|400|main_jobevent_20250101_00|",
    "unifiedjobs": "8000|2025-01-01 00:00:00.123+00",
}


def out(s):
    sys.stdout.write(s + ("\n" if s and not s.endswith("\n") else ""))


def psql():
    sql = sys.stdin.read()
    if "default_transaction_read_only = on" not in sql:
        sys.exit("psql: the session must be read-only")
    for line in sql.splitlines():
        if line.startswith("\\echo "):
            name = line[6:].strip()
            out(name)
            out(SECTIONS.get(name.replace("@@@ ", ""), ""))


def main(a):
    if not a:
        return 1
    cmd = a[0]
    if cmd == "info":
        out(FAKE + "/storage")
    elif cmd == "ps":
        if "-q" in a or "-aq" in a:
            out("\n".join("id%d" % i for i in range(len(C))))
        else:
            out(json.dumps([{"Names": [n], "State": st, "Status": stat, "StartedAt": (NOW - up) if up else 0, "Restarts": r,
                             "ExitCode": 1 if st == "exited" else 0} for n, st, stat, up, r, _ in C]))
    elif cmd == "inspect":
        if "Config.Cmd" in " ".join(a):
            out("receptor --config /etc/receptor/receptor.conf")
        else:
            for n, _, _, _, _, m in C:
                out("/" + n + "".join(" %s=%s" % x for x in m))
    elif cmd == "stats":
        out(json.dumps([{"name": n, "mem_usage": "5.1GB / 16.5GB" if n == "automation-controller-web" else "300.5MB / 16.5GB",
                         "mem_percent": "30.91%" if n == "automation-controller-web" else "1.78%",
                         "cpu_percent": "2.0%"} for n, st, *_ in C if st == "running"]))
    elif cmd == "images":
        out("a\nb")
    elif cmd == "volume":
        out("")
    elif cmd == "system":
        out(json.dumps([{"Type": "Images", "Total": 12, "Active": 10, "Size": "9.8GB", "RawSize": 9800000000}]))
    elif cmd == "logs":
        name = a[-1]
        out({"automation-gateway-proxy": PROXY, "automation-controller-web": WEB, "automation-controller-task": TASK,
             "automation-gateway": GW,
             "automation-eda-api": EDA}.get(name, "all quiet"))
    elif cmd == "exec":
        rest = [x for x in a[1:] if x != "-i"]
        name, prog = rest[0], rest[1:]
        if name == "postgresql" and prog[0] == "psql":
            if os.environ.get("AAPH_PEER_REFUSE"):
                sys.stderr.write('psql: error: FATAL:  Peer authentication failed for user "postgres"\n')
                return 2
            psql()
        elif name == "postgresql" and prog[0] == "bash":
            if sys.stdin.readline().rstrip("\n") != "pw-from-inventory":
                sys.stderr.write("psql: error: FATAL:  password authentication failed\n")
                return 2
            psql()
        elif name == "receptor" and prog[0] == "cat":
            out("---\n- node:\n    id: aap01\n- control-service:\n    service: control\n    filename: /run/receptor/receptor.sock\n")
        elif prog[0] == "sh" and "command -v receptorctl" in " ".join(prog):
            if name != "automation-controller-task":
                return 1
            out("/usr/bin/receptorctl")
        elif name == "automation-controller-web" and prog[0].startswith("python3") and prog[1] == "-c":
            # receptor's Python library (AAP's own way to receptor): the import, then ReceptorControl(socket).simple_command("status")
            if prog[2] == "import receptorctl.socket_interface":
                return 0
            if "ReceptorControl" not in prog[2] or "status" not in prog[2] or prog[3:] != ["/var/run/receptor/receptor.sock"]:
                sys.stderr.write("unexpected: %r\n" % prog)
                return 1
            out(json.dumps({"NodeID": "aap01", "RoutingTable": {"exec01": "exec01", "exec02": "exec01"},
                            "Advertisements": [{"NodeID": "aap01", "WorkCommands": [{"WorkType": "local"}]},
                                               {"NodeID": "exec01", "WorkCommands": [{"WorkType": "ansible-runner"}]},
                                               {"NodeID": "exec02", "WorkCommands": [{"WorkType": "ansible-runner"}]}]}))
        elif name == "automation-controller-task" and prog[0] == "receptorctl":
            if "/run/awx-receptor/receptor.sock" not in prog:
                sys.stderr.write("socket not found\n")
                return 1
            out(json.dumps({"NodeID": "aap01", "RoutingTable": {"exec01": "exec01"},
                            "Advertisements": [{"NodeID": "aap01", "WorkCommands": [{"WorkType": "local"}, {"WorkType": "kubernetes-runtime-auth"}]},
                                               {"NodeID": "exec01", "WorkCommands": [{"WorkType": "ansible-runner"}]},
                                               {"NodeID": "exec02", "WorkCommands": []}]}))
        else:
            return 125
    return 0


sys.exit(main(sys.argv[1:]))
