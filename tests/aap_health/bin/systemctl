#!/usr/bin/env python3
"""A stand-in for systemctl --user on the AAP host (tests/test_aap_health.py); anything else goes to the real one."""
import os
import sys

UNITS = ["automation-gateway-proxy", "automation-gateway", "automation-controller-web", "automation-controller-task",
         "automation-controller-rsyslog", "automation-hub-api", "automation-eda-api", "automation-eda-scheduler",
         "postgresql", "receptor", "redis-unix"]
a = sys.argv[1:]
if "--user" not in a:
    for p in os.environ.get("PATH", "").split(os.pathsep)[1:]:
        if os.access(os.path.join(p, "systemctl"), os.X_OK):
            os.execv(os.path.join(p, "systemctl"), ["systemctl"] + a)
    sys.exit(1)
if "list-unit-files" in a:
    print("\n".join("%s.service enabled enabled" % u for u in UNITS + ["pipewire"]))
elif "cat" in a:
    u = a[-1].replace(".service", "")
    print("[Service]\nExecStart=/usr/bin/podman run --rm --cidfile=%%t/%%n.ctr-id --name %s registry/x:1" % u)
elif "show" in a:
    for u in [x for x in a if x.endswith(".service")]:
        n = u.replace(".service", "")
        st = ("failed", "failed", "exit-code") if n == "automation-controller-rsyslog" else ("active", "running", "success")
        print("Id=%s\nActiveState=%s\nSubState=%s\nResult=%s\nNRestarts=%s\nLoadState=loaded\n"
              % (u, st[0], st[1], st[2], 5 if n == "automation-hub-api" else 0))
