{#- A section's outage time line (1.66.0, the VM outage watch's review), in the atlas and brief looks only (a web page;
    an email gets the cards and the events table): s.outage = {label, zone, legend: [{level, word}], band_word, lanes:
    [{key, name, sub, rows (1 to 3), marks: [{x (%), row, level, label (the event's number, '3+1' = one more under it),
    tip, lead_end}]}], ticks: [{at (%), text, wide}], bands: [{from, to (%), text}], lead: {from, to (%), text, num, span} or
    none (1.90.0: the lead-up to the first critical event, outlined red; 1.90.1: its tab, "Lead-up - 10 min", and its end
    drawn), lead_note (why there is none), overview: {from, to (%), begin, end, text, marks: [{at, level}]} or none, none}.
    A mark is one row of "The events" at its time: its level is its icon and its colour, its number is the row's. Its lines
    show on hover and focus (data-tip, the hover layer of site-report.js; without the script its title). 1.90.1: a click,
    Enter, Space or a tap opens its events under its lane, and the host / vCenter / VM row filters the chart (both
    site-report.js, from data-ev). Made by the outage_timeline filter. #}
{%- set ot = s.outage %}
{%- if ot.lanes | default([]) and not ot.none | default('') %}
<p class="hint"><b>Hover</b> a mark for what happened. A click (or <b>Enter</b> on a Tab stop, or a tap) opens its events below the lane, with the facts of each and a link to its row in The events; <b>Esc</b> or <b>Close</b> closes it.</p>
<div class="ot-legend">
{%- for l in ot.legend | default([]) %}<span><i class="ot-m ot-{{ l.level | e }}" aria-hidden="true">{{ icon(l.level) }}</i>{{ l.word | e }}</span>{% endfor %}
{%- if ot.bands | default([]) %}<span><i class="ot-shade" aria-hidden="true"></i>Shaded: {{ ot.band_word | e }}</span>{% endif %}
{%- if ot.lead | default(none) %}<span><i class="ot-lead-k" aria-hidden="true"></i>Outlined red: {{ ot.lead.text | e }}</span>{% endif %}
{%- if ot.legend_rel | default('') %}<span><i class="ot-m ot-ring" aria-hidden="true"></i>{{ ot.legend_rel | e }}</span>{% endif %}</div>
{%- if ot.related_note | default('') %}<p class="ot-cap">{{ ot.related_note | e }}</p>{% endif %}
{%- if ot.lead_note | default('') %}<p class="ot-cap">{{ ot.lead_note | e }}</p>{% endif %}
{#- 1.76.2 controls (site-report.js; hidden without it): which events the chart and The events show. Remembered per viewer. #}
<div class="ot-ctl" data-ot-ctl hidden>
<div class="ot-ctl-r">{% if ot.subject | default('') %}<span class="ot-ctl-g" role="group" aria-label="Show"><b>Show</b>
<label><input type="radio" name="ot-show" value="all" checked> All</label><label><input type="radio" name="ot-show" value="rel"> Related only</label></span>{% endif %}
<span class="ot-ctl-g"><label><input type="checkbox" name="ot-rep"> Show every repeat</label></span></div>
<div class="ot-ctl-r"><span class="ot-ctl-g" role="group" aria-label="Kinds of event"><b>Kinds</b>{% for k in ot.kinds | default([]) %}<label><input type="checkbox" name="ot-kind" value="{{ k.key | e }}" checked> {{ k.name | e }} <small>{{ k.count }}</small></label>{% endfor %}</span></div></div>
{%- if ot.overview %}
<div class="ot-over" aria-hidden="true"><div class="ot-strip"><i class="ot-box" style="left:{{ ot.overview.from }}%;width:{{ (ot.overview.to - ot.overview.from) | round(2) }}%"></i>
{%- for m in ot.overview.marks | default([]) %}<i class="ot-t ot-{{ m.level | e }}" style="left:{{ m.at }}%"></i>{% endfor %}</div>
<div class="ot-ends"><span>{{ ot.overview.begin | e }}</span><span>{{ ot.overview.end | e }}</span></div></div>
<p class="ot-cap">{{ ot.overview.text | e }}</p>
{%- endif %}
<div class="ot" role="group" aria-label="{{ ot.label | default('Outage time line') | e }}"{% if ot.subject | default('') %} data-subject="{{ ot.subject | e }}"{% endif %}>
<div class="ot-plot{{ ' has-lead' if ot.lead | default(none) and ot.lead.span | default('') else '' }}">
<div class="ot-bg" aria-hidden="true">
{%- for b in ot.bands | default([]) %}<i class="ot-band" style="left:{{ b.from }}%;width:{{ [(b.to - b.from) | round(2), 0.4] | max }}%">{% if ot.bands | length == 1 and b.to - b.from > 24 %}<span>{{ b.text | e }}</span>{% endif %}</i>{% endfor %}
{%- if ot.lead | default(none) %}<i class="ot-lead" style="left:{{ ot.lead.from }}%;width:{{ [(ot.lead.to - ot.lead.from) | round(2), 0.6] | max }}%"{% if ot.lead.num | default('') %} data-lead="{{ ot.lead.num }}" data-lead-span="{{ ot.lead.span | default('') | e }}"{% endif %}>
{%- if ot.lead.span | default('') %}<span class="ot-lead-t">Lead-up &middot; {{ ot.lead.span | e }}</span>{% endif %}</i>{% endif %}
{%- for t in ot.ticks | default([]) %}<i class="ot-tk{{ ' w' if t.wide | default(false) else '' }}" style="left:{{ t.at }}%"></i>{% endfor %}</div>
{%- for g in ot.lanes %}
<div class="ot-row"><div class="ot-name"><b>{{ g.name | e }}</b><small>{{ g.sub | default('') | e }}</small></div>
<div class="ot-track h{{ g.rows | default(1) }}" role="list" aria-label="{{ g.name | e }}">
{%- for m in g.marks | default([]) %}
{%- set st = m.level if m.level in ['critical', 'warning', 'low', 'info', 'ok'] else 'info' %}
<i class="ot-m ot-{{ st }} r{{ m.row | default(0) }}{% if ot.subject | default('') %}{{ ' ot-rel' if m.rel | default(0) > 0 else ' ot-dim' }}{% endif %}{{ ' lead-end' if m.lead_end | default(false) else '' }}" role="listitem" style="left:{{ m.x }}%"{% if m.data | default('') %} data-ev="{{ m.data | e }}"{% endif %} data-tip="{{ m.tip | e }}" title="{{ m.tip | e }}" aria-label="{{ m.tip | replace('\n', ', ') | e }}">{{ icon(st) }}<b>{{ m.label | e }}</b></i>
{%- endfor %}
</div></div>
{%- endfor %}
</div>
<div class="ot-axis" aria-hidden="true">{% for t in ot.ticks | default([]) %}<span class="{{ 'w' if t.wide | default(false) else '' }}" style="left:{{ t.at }}%">{{ t.text | e }}</span>{% endfor %}{% if ot.zone | default('') %}<em>Time ({{ ot.zone | e }})</em>{% endif %}</div>
</div>
{%- endif %}
