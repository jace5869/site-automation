{%- set words_by_state = {'Down now':'down', 'Inaccessible in vCenter':'down', 'At risk':'risk', 'Not judged':'skip', 'Recovered':'ok'} %}
{%- set kinds = [('ds','Datastores'), ('vm','VMs'), ('host','Hosts'), ('net','Network'), ('dc','Domain controllers')] %}
{%- set counts = {} %}
{%- for key, label in kinds %}
  {%- set rows = s.issues | selectattr('kind', 'equalto', key) | list %}
  {%- if rows or key in ('ds','vm','host') %}
    {%- set _ = counts.update({key: (rows | sum(attribute='n') if key == 'vm' else rows | length)}) %}
  {%- endif %}
{%- endfor %}
<div class="ibk"><fieldset class="ibk-f"><legend class="vh">Filter issues by type</legend>
<input class="ibk-r" type="radio" id="ibk-all" name="ibk" checked>
{%- for key in counts %}<input class="ibk-r" type="radio" id="ibk-{{ key }}" name="ibk">{% endfor %}
<div class="ibk-chips"><label class="ibk-chip" for="ibk-all">All <span>{{ counts.values() | sum }}</span></label>
{%- for key, label in kinds if key in counts %}<label class="ibk-chip" for="ibk-{{ key }}">{{ label }} <span>{{ counts[key] }}</span></label>{% endfor %}
</div>
<p class="ibk-key">{% for state, cls in words_by_state.items() %}<span class="ibk-pill st-{{ cls }}">{{ state }}</span> {% endfor %} Worst first.</p>
<div class="ibk-kinds">
{%- for key, label in kinds if key in counts %}
<section class="ibk-kind k-{{ key }}"><h3>{{ label }} <span class="count">{{ counts[key] }}</span></h3>
<div class="ibk-grp">
{%- for r in s.issues | selectattr('kind','equalto',key) %}
{% if loop.changed(r.group) %}<h4>{{ r.group | e }}</h4>{% endif %}
<div class="ibk-row st-{{ words_by_state.get(r.state, 'skip') }}">
<div class="ibk-line"><span class="ibk-pill st-{{ words_by_state.get(r.state, 'skip') }}">{{ r.state | e }}</span>
<span class="ibk-name">{{ r.name | e }}</span> <span class="ibk-what">{{ r.what | e }}</span>
{% if r.host is defined %}<span>{{ r.host | e }} / {{ r.datastore | e }}</span>{% endif %}
{% if r.protected | default(false) %}<span class="ibk-tag">Protected</span>{% endif %}
{% if r.anchor | default('') %}<a class="ibk-since" href="#{{ r.anchor | e }}">{{ r.since | e }}</a>{% endif %}
{% if key == 'ds' %}<span class="ibk-n">{{ r.n }} VMs</span>{% endif %}</div>
{% if r['items'] %}<ul>{% for item in r['items'] %}<li>{{ item.name | e }} · {{ item.state | e }} · {{ item.what | e }}</li>{% endfor %}</ul>{% endif %}
</div>
{%- endfor %}</div>
{% if key == 'net' and s.network_note | default('') %}<p class="ibk-note">{{ s.network_note | e }}</p>{% endif %}</section>
{%- endfor %}</div></fieldset></div>
