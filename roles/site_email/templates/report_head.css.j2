{#- 1.82.0: the head of a report page (atlas, brief, ops): the counts as chips under the name (the status icon and the words, never colour alone),
    the scope as one muted line. Colours come from the look's own --ok/--warning/--critical, --edge, --muted and --ink. -#}
.hcounts{display:flex;flex-wrap:wrap;gap:8px 10px;margin:12px 0 0;padding:0;list-style:none}
.hcounts .hct{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--edge);border-radius:999px;padding:4px 12px 4px 9px;font-size:15px;line-height:1.3;color:var(--ink);background:var(--card-strong)}
.hcounts .hct b{font-size:19px;line-height:1;font-weight:750;font-variant-numeric:tabular-nums}
.hcounts .hct svg{width:16px;height:16px;flex:none}
.hcounts .s-ok svg{color:var(--ok)}.hcounts .s-warning svg{color:var(--warning)}.hcounts .s-critical svg{color:var(--critical)}.hcounts .s-info svg{color:var(--muted)}
.hcounts .s-ok{border-color:var(--ok-bd)}.hcounts .s-warning{border-color:var(--warning-bd)}.hcounts .s-critical{border-color:var(--critical-bd)}
.hscope{margin:12px 0 0;color:var(--muted);font-size:14px;max-width:96ch;text-wrap:pretty}
@media print{.hcounts .hct{background:none}}
{#- 1.112.0: a file the head offers (report_head_file.html.j2): a plain download link; dashed when it is not on the website -#}
.hfile{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin:14px 0 0;padding-top:12px;border-top:1px solid var(--edge)}
.hf-a{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:700;line-height:1;white-space:nowrap;color:var(--card-solid,#fff);background:var(--accent);border:1px solid var(--accent);border-radius:10px;padding:9px 14px;text-decoration:none}
.hf-a:hover{filter:brightness(1.08)}.hf-a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.hf-a svg{width:18px;height:18px;flex:none}
.hf-a.off{color:var(--muted);background:transparent;border:1px dashed var(--edge);font-weight:600;cursor:default}.hf-a.off:hover{filter:none}
.hf-m{font-size:13px;color:var(--muted);min-width:0;overflow-wrap:anywhere;line-height:1.45}.hf-why{display:block;color:var(--ink)}
.hfile .dl.off{color:var(--muted);font-size:13px}
@media print{.hfile{display:none}}
.hgrid~.hfile{margin:0;padding:12px 32px 16px}@media (max-width:900px){.hgrid~.hfile{padding:12px 20px 16px}}
