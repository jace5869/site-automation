<p>One card per pattern this outage showed, in the order it appeared. The checks below are read-only.</p>
{% if s.noc_file | default('') %}
<p class="kb-hand"><b>Hand this to the {{ s.ops_center | default('NOC') | e }}:</b> <a class="dl" href="site-report-file:{{ s.noc_file | urlencode }}" download>{{ s.noc_file | e }}</a> &middot; one page, also attached to the email.</p>
{% endif %}
{% if s.noc_error | default('') %}<p>{{ s.noc_error | e }}</p>{% endif %}
<div class="kb-grid">
{% for c in s.patterns %}
<article class="kb" id="outage-card-{{ c.title | replace(' ', '-') | e }}"><header><span class="kb-n">{{ loop.index }}</span><h3>{{ c.title | e }}</h3></header>
<p class="kb-what">{{ c.means | e }}</p>
<div class="kb-cols"><div><h4>Typical causes</h4><ul>{% for x in c.causes %}<li>{{ x | e }}</li>{% endfor %}</ul></div>
<div><h4>Check first (read only)</h4><ol>{% for x in c.checks %}<li>{{ x | e }}</li>{% endfor %}</ol></div></div>
<p class="kb-esc"><b>Escalate to:</b> {{ c.escalate | e }}</p><p class="kb-seen"><b>Seen here:</b> {{ c.seen | e }} &middot; {{ c.when | e }}</p></article>
{% else %}<p>No matching pattern in the review.</p>{% endfor %}
</div>
