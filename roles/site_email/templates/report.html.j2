{#- A report as an email, in HTML that Outlook shows as intended: tables for the layout, every style
    inline, no scripts; the only picture is the site's logo (report_logo_file), attached to the email
    (cid:). Input: _report (see roles/site_email/tasks/main.yml), the footer line _email_footer, and
    _email_logo_cid ('' = no logo) with _email_logo_size ([width, height]). Every value is escaped
    (| e). Your own look: copy this file and point report_email_html_template at the copy. -#}
{#- the report website copy failed (report_web_required false): said first, as plugins/filter/site_filters.py report_notice #}
{%- set r = dict(_report, sections=[{'title': 'Report website', 'status': 'warning', 'text': _email_notice}] + (_report.sections | default([])))
             if _email_notice | default('') else _report -%}
{#- ACT off (site_act_enabled false) in a job that would have asked it: one line, last (the website's report has it already) -#}
{%- if _act_off | default(false) and 'ACT is off (site_act_enabled false).' not in (r.sections | default([]) | map(attribute='text', default='') | list) -%}
{%- set r = dict(r, sections=(r.sections | default([])) + [{'title': 'ACT', 'status': 'info', 'text': 'ACT is off (site_act_enabled false).'}]) -%}
{%- endif -%}
{#- the web copy (report_web_dest) passes its own _page_logo_cid, _page_logo_size and _page_runs; an email links its web copy (_email_web_url) -#}
{%- set logo_cid = _page_logo_cid | default(_email_logo_cid | default('')) -%}
{%- set logo_size = _page_logo_size | default(_email_logo_size | default([0, 0])) -%}
{%- set colour = {'ok': '#15803d', 'warning': '#b45309', 'critical': '#b91c1c', 'info': '#1d4ed8', 'unknown': '#6b7280'} -%}
{#- a section may colour its rows: row_status (one status per row: a light tint of the whole row) and
    cell_status (per row, one status per cell: that cell in the full colour, white bold text) -#}
{%- set tint = {'ok': '#dcfce7', 'warning': '#fef3c7', 'critical': '#fee2e2', 'info': '#dbeafe', 'unknown': '#f3f4f6'} -%}
{%- set band = colour[r.status | default('info')] | default('#1d4ed8') -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.title | e }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f3f4f6;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:1000px;background:#ffffff;border:1px solid #d1d5db;font-family:'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;line-height:1.4;color:#111827;">
<tr><td style="background:{{ band }};color:#ffffff;padding:16px 20px;">
{%- if logo_cid %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td valign="middle" style="color:#ffffff;">
{%- endif %}
<div style="font-size:20px;font-weight:bold;">{{ r.title | e }}</div>
{%- if r.subtitle | default('') %}
<div style="font-size:14px;margin-top:4px;">{{ r.subtitle | e }}</div>
{%- endif %}
{%- if logo_cid %}
</td><td width="{{ logo_size[0] + 16 }}" align="right" valign="middle" style="padding-left:16px;"><img src="cid:{{ logo_cid }}" width="{{ logo_size[0] }}" height="{{ logo_size[1] }}" alt="" style="display:block;border:0;width:{{ logo_size[0] }}px;height:{{ logo_size[1] }}px;"></td></tr></table>
{%- endif %}
</td></tr>
{%- if r.summary | default([]) %}
<tr><td style="padding:16px 20px 4px 20px;">
{#- 1.30.0: four or more boxes - four equal columns over the width (a short last row keeps them: empty cells) #}
{%- set _four = r.summary | length >= 4 %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"{% if _four %} width="100%" style="width:100%;table-layout:fixed;"{% endif %}>
{%- for chunk in r.summary | batch(4) %}<tr>
{%- for t in chunk %}
<td{% if _four %} width="25%"{% endif %} style="padding:0 8px 8px 0;vertical-align:top;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"{% if _four %} width="100%"{% endif %} style="border:1px solid #d1d5db;border-top:4px solid {{ colour[t.status | default('')] | default('#6b7280') }};{{ 'width:100%;' if _four else 'min-width:120px;' }}">
<tr><td style="padding:8px 12px;">
<div style="font-size:22px;font-weight:bold;color:{{ colour[t.status | default('')] | default('#111827') }};">{{ t.value | string | e }}</div>
<div style="font-size:12px;color:#4b5563;">{{ t.label | e }}</div>
{%- if t.note | default('') %}
<div style="font-size:11px;color:#6b7280;margin-top:2px;">{{ t.note | e }}</div>
{%- endif %}
</td></tr></table>
</td>
{%- endfor %}
{%- if _four %}{% for _ in range(4 - chunk | length) %}<td width="25%" style="padding:0 8px 8px 0;"></td>{% endfor %}{% endif %}
</tr>
{%- endfor %}</table>
</td></tr>
{%- endif %}
{%- for s in r.sections | default([]) %}
<tr><td style="padding:12px 20px 4px 20px;">
<div style="font-size:16px;font-weight:bold;color:{{ colour[s.status | default('')] | default('#111827') }};border-bottom:2px solid #e5e7eb;padding-bottom:4px;">{{ s.title | e }}{% if s.rows is defined %} <span style="font-weight:normal;color:#6b7280;">({{ s.rows | length }})</span>{% endif %}</div>
{%- if s.text | default('') %}
<div style="padding:6px 0;color:#374151;">{{ s.text | e }}</div>
{%- endif %}
{%- if s.cards is defined %}{{ s.cards | report_cards_html('#111827', '#4b5563', '#0f6b4f') }}{% endif %}
{%- if s.columns is defined %}
{%- if s.rows | default([]) %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border:1px solid #d1d5db;font-size:13px;margin:4px 0 8px 0;">
<tr>
{%- for c in s.columns %}
<th align="left" style="background:#b8c3d4;color:#111827;padding:6px 8px;border:1px solid #9aa7bb;font-weight:bold;">{{ c | e }}</th>
{%- endfor %}
</tr>
{%- for row in s.rows %}
{%- set rs = (s.row_status[loop.index0] if s.row_status is defined and s.row_status | length > loop.index0 else '') | default('', true) %}
{%- set cs = (s.cell_status[loop.index0] if s.cell_status is defined and s.cell_status | length > loop.index0 else []) | default([], true) %}
{%- if rs in tint %}
<tr bgcolor="{{ tint[rs] }}" style="background:{{ tint[rs] }};">
{%- else %}
<tr style="background:{{ '#ffffff' if loop.index is odd else '#f9fafb' }};">
{%- endif %}
{%- for cell in row %}
{%- set st = cs[loop.index0] if cs | length > loop.index0 else '' %}
{%- if st and st in colour %}
<td bgcolor="{{ colour[st] }}" style="padding:5px 8px;border:1px solid #c9d1dd;vertical-align:top;background:{{ colour[st] }};color:#ffffff;font-weight:bold;">{{ cell | report_cell_html if s.wrap | default(false) else ('' if cell is none else cell) | string | e }}</td>
{%- else %}
<td style="padding:5px 8px;border:1px solid #c9d1dd;vertical-align:top;">{{ cell | report_cell_html if s.wrap | default(false) else ('' if cell is none else cell) | string | e }}</td>
{%- endif %}
{%- endfor %}
</tr>
{%- endfor %}
</table>
{%- else %}
<div style="padding:6px 0;color:#6b7280;">None.</div>
{%- endif %}
{%- endif %}
{%- if s.lines | default([]) %}
<ul style="margin:6px 0 8px 0;padding-left:20px;">
{%- for l in s.lines if l | trim %}
{#- 1.30.0: an item under the one above ("  - ..." in the text email) is indented, no dash #}
{%- set _sub = l[:1] == ' ' and l.lstrip()[:2] == '- ' %}
<li style="margin:2px 0;{{ ' margin-left:18px;list-style-type:circle;' if _sub else '' }}">{{ (l.lstrip()[2:] if _sub else l) | e }}</li>
{%- endfor %}
</ul>
{%- endif %}
</td></tr>
{%- endfor %}
<tr><td style="padding:12px 20px 16px 20px;border-top:1px solid #e5e7eb;font-size:12px;color:#6b7280;">
{%- if r.footer | default('') %}{{ r.footer | e }}<br>{% endif %}
{{ _email_footer | e }}{% if _email_web_url | default('') %}<br><a href="{{ _email_web_url | e }}" style="color:inherit;">Open this report in a browser</a>{% endif %}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
