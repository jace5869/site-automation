{#- A section's matrix (1.63.0, the AD replication matrix), in the atlas and brief looks only (an email gets the table of
    late links): s.matrix = {mode (dc | site), groups: [{name, n}] (the column sites), cols: [{name, key, site}], rows:
    [{name, key, site, first, span, cells: [{st, text, say, tip}]}], legend: [{st, text}], axis, dense, never}. A cell's
    status is its icon, its word in the legend and its colour; its text the age (52m, 3h, 2d; — never); its tip (data-tip,
    site-report.js) the pair, partition, times and error. st self: the DC itself (hatched); none: not partners (a dot).
    DC mode: a band row with each site's name over its DCs. Site mode: the columns numbered, each number the row's site.
    dense: the icon over the age. The table's min-width keeps every cell whole: narrower, its box scrolls (a phone).
    Tokens of the look (.s-*), so light and dark follow. #}
{%- set mx = s.matrix %}
{%- set n = mx.cols | length %}
<div class="rm-legend">
{%- for l in mx.legend | default([]) %}<span>{{ chip(l.st, chipword[l.st] if l.st != 'unknown' else 'Not read') }} {{ l.text | e }}</span>{% endfor %}
<span>Ages: m minutes, h hours, d days</span>
{%- if mx.never | default(false) %}<span><b class="rm-mk" aria-hidden="true">&mdash;</b> never replicated</span>{% endif %}
{%- if mx.mode == 'dc' %}<span><i class="rm-dot" aria-hidden="true">&middot;</i> not replication partners</span>{% endif %}</div>
<div class="rm-wrap"><table class="rm rm-{{ mx.mode | e }}{{ ' rm-dense' if mx.dense | default(false) else '' }}" style="min-width:{{ 120 + n * 40 }}px" aria-label="{{ s.title | e }}">
<colgroup><col class="rm-cn">{% for c in mx.cols %}<col>{% endfor %}</colgroup>
<thead>
{%- if mx.mode == 'dc' %}
<tr class="rm-gr"><td></td>{% for g in mx.groups %}<th scope="colgroup" colspan="{{ g.n }}" title="{{ g.name | e }}"><span>{{ g.name | e }}</span></th>{% endfor %}</tr>
{%- endif %}
<tr><th class="rm-ax" scope="col">{{ mx.axis | e }}</th>{% for c in mx.cols %}
{%- if c.key is defined %}<th scope="col" class="rm-h" title="{{ c.name | e }}"><span aria-hidden="true">{{ c.key | e }}</span><span class="rm-sr">{{ c.name | e }}</span></th>
{%- else %}<th scope="col" class="rm-h">{{ c.name | e }}</th>{% endif %}{% endfor %}</tr>
</thead>
<tbody>
{%- for row in mx.rows %}
{%- if mx.mode == 'dc' and row.first %}
<tr class="rm-band"><th scope="rowgroup" colspan="{{ n + 1 }}">{{ row.site | e }}</th></tr>
{%- endif %}
<tr>
<th scope="row" class="rm-dc">{% if row.key is defined %}<b class="rm-k">{{ row.key | e }}</b> {% endif %}{{ row.name | e }}</th>
{%- for c in row.cells %}
{%- if c.st == 'self' %}
<td class="rm-c rm-self" aria-label="{{ row.name | e }} itself"></td>
{%- elif c.st == 'none' %}
<td class="rm-c rm-none" data-tip="{{ c.tip | e }}" aria-label="{{ c.tip | replace('\n', ': ') | e }}"><i aria-hidden="true">&middot;</i></td>
{%- else %}
{%- set k = c.st if c.st in words else 'unknown' %}
<td class="rm-c s-{{ k }}" data-tip="{{ c.tip | e }}" aria-label="{{ chipword[k] if k != 'unknown' else 'Not read' }}, {{ c.say | default(c.text) | e }}: {{ c.tip | replace('\n', '; ') | e }}">{{ icon(k) }}<span>{{ c.text | e }}</span></td>
{%- endif %}
{%- endfor %}
</tr>
{%- endfor %}
</tbody>
</table></div>
