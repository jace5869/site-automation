{#- The "atlas" look - the report website only (report_web_theme: atlas), never an email (mail programs draw none of
    this). 0.53.0: a wide page (up to 1760px, its margins growing with the window) whose words stay short enough to
    read (about 80 characters a line) while its tables use all of it; a bar at the top that stays - the report's name,
    its sections (the one in view marked), Compact / Comfortable rows, Light / Auto / Dark (both kept in this browser),
    Print; status chips always with their icon and word (a check mark for OK, ! for a warning, x for critical); "Start
    here" cards with a Copy button for their command; a Copy button on every tile and every section (as text and, where
    the browser allows it, as HTML that pastes as a table or list into Word, Outlook or Excel); tables whose columns
    are sized by what they hold - numbers right-aligned in figures of one width, short values (ids, dates, hosts) never
    broken, titles and findings given room to wrap, paths and hashes broken at / and \ (never off the edge) - with
    headings that stay at the top, rows that sort when a heading is clicked and, past 8 rows, a box to filter them; on a
    phone, each row a card. Printed: white, landscape, every section open. One file: the styles and the small script
    inline, no fonts or scripts from elsewhere (the page opens from a share too, file://). Without the script it reads
    the same: only the switches, sorting, filtering and the Copy buttons need it (hidden without it). Input as
    report_portal: _report, _page_logo_cid/_page_logo_size, _page_runs, _page_job/_page_template, _email_footer. Every
    value is escaped. Design notes and their sources: docs/WEB_REPORTS.md, "The look". -#}
{%- set r = _report -%}
{%- set logo_cid = _page_logo_cid | default(_email_logo_cid | default('')) -%}
{%- set logo_size = _page_logo_size | default(_email_logo_size | default([0, 0])) -%}
{%- set runs = _page_runs | default(_email_runs | default([])) -%}
{%- set job_id = _page_job | default(awx_job_id | default(tower_job_id | default(''))) | string -%}
{%- set job_name = _page_template | default(awx_job_template_name | default(tower_job_template_name | default(''))) | string -%}
{%- set words = {'ok': 'All good', 'warning': 'Needs attention', 'critical': 'Action required', 'info': 'For information', 'unknown': 'Unknown'} -%}
{%- set chipword = {'ok': 'OK', 'warning': 'Warning', 'critical': 'Critical', 'info': 'Info', 'unknown': 'Unknown'} -%}
{#- a cell whose whole text is one of these words gets its chip (and icon) even without a cell_status -#}
{%- set cellword = {'ok': 'ok', 'passed': 'ok', 'pass': 'ok', 'success': 'ok', 'successful': 'ok', 'healthy': 'ok', 'compliant': 'ok',
                    'valid': 'ok', 'up': 'ok', 'connected': 'ok',
                    'warning': 'warning', 'warn': 'warning', 'at risk': 'warning', 'expiring': 'warning', 'degraded': 'warning',
                    'critical': 'critical', 'failed': 'critical', 'fail': 'critical', 'error': 'critical', 'breached': 'critical',
                    'expired': 'critical', 'down': 'critical', 'unreachable': 'critical', 'not compliant': 'critical',
                    'info': 'info', 'unknown': 'unknown'} -%}
{%- set st = r.status | default('info') if r.status | default('info') in words else 'info' -%}
{%- macro icon(k) -%}
{%- if k == 'ok' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M4.7 8.4l2.1 2.1 4.5-4.7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif k == 'warning' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6l6.6 11.6H1.4z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 6v3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.4" r=".95" fill="currentColor"/></svg>
{%- elif k == 'critical' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
{%- elif k == 'info' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M8 7.2v4.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="8" cy="4.8" r="1" fill="currentColor"/></svg>
{%- else -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M6.2 6.2a1.9 1.9 0 113 1.5c-.8.5-1.2.9-1.2 1.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="11.6" r=".95" fill="currentColor"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- macro copyicons() -%}
<svg class="ic i1" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.2" y="5.2" width="8.6" height="8.6" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.8 3.2V3a1.6 1.6 0 00-1.6-1.6H3.4A1.6 1.6 0 001.8 3v5.8a1.6 1.6 0 001.6 1.6h.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="ic i2" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 8.6l3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro -%}
{%- macro chip(k, text) -%}
<span class="chip s-{{ k }}">{{ icon(k) }}<span>{{ text | e }}</span></span>
{%- endmacro -%}
{#- a path, address or hash: escaped, with a place to break after each / and \ (no hyphen is added) -#}
{%- macro breakable(text) -%}
{{ text | e | replace('/', '/<wbr>') | replace('\\', '\\<wbr>') }}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ r.title | e }}</title>
<script>try{var t=localStorage.getItem('site-report-theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);
var d=localStorage.getItem('site-report-density');if(d==='compact')document.documentElement.setAttribute('data-density',d)}catch(e){}</script>
<style>
:root{
  --ink:#111827;--muted:#4b5563;--label:#374151;--accent:#0b7352;--accent-ink:#ffffff;--accent-soft:#e3f3ec;
  --bg:#f3f5f7;--bg2:#e9eef2;--card:#ffffff;--card-solid:#ffffff;--card-strong:#f7f9fb;--edge:#dde3ea;--line:#e8ecf1;
  --zebra:#fafbfc;--hover:#eef6f2;--code:#f1f4f7;--bar:rgba(255,255,255,.82);
  --shadow:0 1px 2px rgba(16,24,40,.05),0 6px 20px rgba(16,24,40,.06);
  --glow1:rgba(16,163,113,.14);--glow2:rgba(59,130,246,.10);
  --ok:#0a6b45;--ok-bg:#e6f5ed;--ok-bd:#9ad3b6;
  --warning:#8a4b00;--warning-bg:#fdf1dc;--warning-bd:#eec27c;
  --critical:#b42318;--critical-bg:#fdeceb;--critical-bd:#f0a59c;
  --info:#1d4ed8;--info-bg:#e9effd;--info-bd:#a9c0f5;
  --unknown:#4b5563;--unknown-bg:#eef1f4;--unknown-bd:#c9d1da;
  --critical-row:#fff6f5;--warning-row:#fffaf0;
  color-scheme:light;
}
{%- set dark %}
  --ink:#e6edf3;--muted:#9aa7b4;--label:#c2ccd6;--accent:#3ecf98;--accent-ink:#04221a;--accent-soft:#12302a;
  --bg:#0b0f14;--bg2:#0e141b;--card:#121820;--card-solid:#121820;--card-strong:#171f29;--edge:#263243;--line:#1e2834;
  --zebra:#141b24;--hover:#15241f;--code:#0d1319;--bar:rgba(14,19,26,.84);
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.30);
  --glow1:rgba(62,207,152,.13);--glow2:rgba(96,140,255,.11);
  --ok:#4fd69a;--ok-bg:rgba(79,214,154,.12);--ok-bd:rgba(79,214,154,.36);
  --warning:#f2b450;--warning-bg:rgba(242,180,80,.12);--warning-bd:rgba(242,180,80,.38);
  --critical:#ff8a80;--critical-bg:rgba(255,138,128,.12);--critical-bd:rgba(255,138,128,.40);
  --info:#8ab4ff;--info-bg:rgba(138,180,255,.12);--info-bd:rgba(138,180,255,.36);
  --unknown:#a8b3bf;--unknown-bg:rgba(168,179,191,.11);--unknown-bd:rgba(168,179,191,.30);
  --critical-row:rgba(255,138,128,.06);--warning-row:rgba(242,180,80,.05);
  color-scheme:dark;
{%- endset %}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){ {{- dark -}} }}
:root[data-theme="dark"]{ {{- dark -}} }
:root{--cy:10px;--cx:14px;--fs:14px;--appbar:58px}
:root[data-density="compact"]{--cy:5px;--cx:10px;--fs:13.5px}
*{box-sizing:border-box}
html{background:var(--bg);scroll-padding-top:calc(var(--appbar) + 12px)}
body{margin:0;color:var(--ink);font:15px/1.55 "Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
  background:radial-gradient(1200px 520px at 0% -10%,var(--glow1),transparent 60%),radial-gradient(1000px 520px at 100% -6%,var(--glow2),transparent 60%),
  linear-gradient(180deg,var(--bg),var(--bg2));background-attachment:fixed;min-height:100vh;-webkit-font-smoothing:antialiased}
a{color:var(--accent)}
.mono,code,pre,td.lk,td.k-path{font-family:ui-monospace,"Cascadia Mono","Cascadia Code",Consolas,"SF Mono",Menlo,"DejaVu Sans Mono",monospace}
.ic{width:15px;height:15px;flex:none;display:block}
.c-ok{color:var(--ok)}.c-warning{color:var(--warning)}.c-critical{color:var(--critical)}.c-info{color:var(--info)}.c-unknown{color:var(--unknown)}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px 2px 6px;font-size:12.5px;font-weight:650;line-height:1.5;white-space:nowrap;border:1px solid}
.s-ok{color:var(--ok);background:var(--ok-bg);border-color:var(--ok-bd)}
.s-warning{color:var(--warning);background:var(--warning-bg);border-color:var(--warning-bd)}
.s-critical{color:var(--critical);background:var(--critical-bg);border-color:var(--critical-bd)}
.s-info{color:var(--info);background:var(--info-bg);border-color:var(--info-bd)}
.s-unknown{color:var(--unknown);background:var(--unknown-bg);border-color:var(--unknown-bd)}
.card{background:var(--card);border:1px solid var(--edge);border-radius:16px;box-shadow:var(--shadow)}
.wrap{max-width:1760px;margin:0 auto;padding:20px clamp(14px,2.6vw,40px) 48px}
/* the bar at the top: the report, its sections, the switches */
.appbar{position:sticky;top:0;z-index:20;background:var(--bar);border-bottom:1px solid var(--edge);
  -webkit-backdrop-filter:saturate(160%) blur(14px);backdrop-filter:saturate(160%) blur(14px)}
.appbar-in{max-width:1760px;margin:0 auto;padding:0 clamp(14px,2.6vw,40px);min-height:var(--appbar);display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:10px;min-width:0;flex:none;max-width:34%}
.logo{display:block;border-radius:8px;height:auto;max-height:34px;width:auto}
.brand b{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav{flex:1;min-width:0;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:10px 0;mask-image:linear-gradient(90deg,#000 94%,transparent)}
.nav::-webkit-scrollbar{display:none}
.nav a{flex:none;display:inline-flex;align-items:center;gap:7px;text-decoration:none;color:var(--muted);font-size:13px;font-weight:600;
  border:1px solid transparent;border-radius:999px;padding:5px 11px;white-space:nowrap}
.nav a:hover{color:var(--ink);background:var(--card-strong);border-color:var(--edge)}
.nav a.on{color:var(--ink);background:var(--card);border-color:var(--edge);box-shadow:var(--shadow)}
.nav .n{font-weight:500;color:var(--muted);font-variant-numeric:tabular-nums}
.dot{width:8px;height:8px;border-radius:50%;background:currentColor;flex:none}
.tools{display:flex;gap:8px;align-items:center;flex:none;margin-left:auto}
.btn{font:inherit;font-size:13px;font-weight:600;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:10px;padding:6px 11px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.btn:hover{border-color:var(--accent)}
.seg{display:inline-flex;background:var(--card-strong);border:1px solid var(--edge);border-radius:10px;padding:2px;gap:2px}
.seg button{font:inherit;font-size:12.5px;font-weight:600;color:var(--muted);background:none;border:0;border-radius:8px;padding:5px 10px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.seg button:hover{color:var(--ink)}
.seg button[aria-checked="true"]{background:var(--card);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12),inset 0 0 0 1px var(--edge)}
.seg button:focus-visible,.btn:focus-visible,summary:focus-visible,th button:focus-visible,.nav a:focus-visible,.filter:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
/* the header */
.hero{padding:26px clamp(18px,2.4vw,32px) 22px;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:var(--unknown)}
.hero.h-ok:before{background:var(--ok)}.hero.h-warning:before{background:var(--warning)}.hero.h-critical:before{background:var(--critical)}.hero.h-info:before{background:var(--info)}
.hero:after{content:"";position:absolute;right:-120px;top:-160px;width:520px;height:420px;border-radius:50%;background:radial-gradient(closest-side,var(--glow1),transparent);pointer-events:none}
.hero>*{position:relative;z-index:1}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
h1{margin:6px 0 0;font-size:clamp(23px,2.6vw,34px);line-height:1.18;letter-spacing:-.015em;font-weight:750;max-width:62ch;text-wrap:balance}
.sub{color:var(--muted);margin-top:8px;font-size:15px;max-width:90ch;text-wrap:pretty}
.state{display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;margin-top:20px;padding-top:16px;border-top:1px solid var(--line)}
.state .chip{font-size:14px;padding:5px 14px 5px 9px}
.state .chip .ic{width:18px;height:18px}
.meta{color:var(--muted);font-size:13px;display:flex;flex-wrap:wrap;gap:4px 14px}
.runs{margin-left:auto;display:flex;align-items:flex-end;gap:4px;height:42px}
.runs .lbl{font-size:11px;font-weight:700;letter-spacing:.12em;color:var(--label);margin-right:8px;align-self:center;text-transform:uppercase}
.bar{width:10px;border-radius:3px 3px 1px 1px;background:currentColor;opacity:.8;position:relative}
.bar.now{outline:2px solid var(--ink);outline-offset:1px;opacity:1}
.bar:hover{opacity:1}
.bar[data-tip]:hover:after{content:attr(data-tip);position:absolute;bottom:calc(100% + 8px);right:-6px;white-space:nowrap;background:var(--card-solid);color:var(--ink);
  border:1px solid var(--edge);border-radius:8px;padding:4px 8px;font-size:12px;box-shadow:var(--shadow);z-index:5}
/* the tiles */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:16px 0}
.tile{padding:16px 18px 15px;position:relative;overflow:hidden}
.tile .k{font-size:12px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--label);display:flex;align-items:center;gap:7px;padding-right:28px}
.tile .v{font-size:36px;font-weight:750;line-height:1.05;margin-top:8px;font-variant-numeric:tabular-nums;letter-spacing:-.02em;overflow-wrap:anywhere}
.tile .v.long{font-size:20px;letter-spacing:0;line-height:1.25}
.tile .n{color:var(--muted);font-size:13px;margin-top:6px}
.tile.hot-critical{border-color:var(--critical-bd);background:linear-gradient(180deg,var(--critical-bg),var(--card) 70%)}
.tile.hot-warning{border-color:var(--warning-bd);background:linear-gradient(180deg,var(--warning-bg),var(--card) 70%)}
.tile.hot-critical:before,.tile.hot-warning:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--critical)}
.tile.hot-warning:before{background:var(--warning)}
/* the sections */
.sec{margin-top:16px}
.sec>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;padding:16px clamp(16px,2vw,24px)}
.sec>summary::-webkit-details-marker{display:none}
.sec>summary h2{margin:0;font-size:17px;font-weight:700;flex:1;min-width:0;line-height:1.3;text-wrap:balance}
.sec>summary .count{display:inline-block;font-size:12.5px;font-weight:700;color:var(--muted);background:var(--card-strong);border:1px solid var(--line);border-radius:999px;padding:0 9px;margin-left:8px;vertical-align:2px;font-variant-numeric:tabular-nums}
.sec[open]>summary{border-bottom:1px solid var(--line)}
.caret{width:18px;height:18px;flex:none;color:var(--muted);transition:transform .15s}
.sec:not([open]) .caret{transform:rotate(-90deg)}
.body{padding:14px clamp(16px,2vw,24px) 20px}
.body>p{margin:0 0 12px;color:var(--muted);max-width:88ch;text-wrap:pretty}
ul.lines{margin:2px 0 0;padding:0;list-style:none;max-width:140ch}
ul.lines li{position:relative;padding:7px 0 7px 22px;border-top:1px solid var(--line);overflow-wrap:anywhere;white-space:pre-line}
ul.lines li:first-child{border-top:0}
ul.lines li:before{content:"";position:absolute;left:5px;top:15px;width:6px;height:6px;border-radius:50%;background:var(--accent);opacity:.8}
.passed-checks{display:flex;flex-wrap:wrap;align-items:center;gap:6px;color:var(--muted);font-size:14px;margin-bottom:12px}
.passed-checks .chip{font-size:12px}
ul.passed{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px}
ul.passed li{display:flex;align-items:center;gap:8px;background:var(--card-strong);border:1px solid var(--line);border-radius:10px;padding:8px 12px;font-size:13.5px;min-width:0}
ul.passed li .mono{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
ul.passed .ic{width:17px;height:17px}
/* Start here */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,380px),1fr));gap:14px}
.todo{background:var(--card);border:1px solid var(--edge);border-radius:14px;padding:16px 18px 16px 20px;position:relative;overflow:hidden;color:var(--ink);display:flex;flex-direction:column}
.todo:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--unknown)}
.todo.c-ok:before{background:var(--ok)}.todo.c-warning:before{background:var(--warning)}.todo.c-critical:before{background:var(--critical)}.todo.c-info:before{background:var(--info)}
.todo .row1{display:flex;align-items:center;gap:8px;justify-content:space-between}
.todo .meta{color:var(--muted);font-size:12.5px;text-align:right;font-weight:600;text-transform:uppercase;letter-spacing:.06em}
.todo h3{margin:12px 0 0;font-size:16px;line-height:1.38;text-wrap:balance}
.todo .subj{color:var(--muted);font-size:13px;margin-top:6px;overflow-wrap:anywhere}
.todo .next{margin-top:10px;font-size:14px;overflow-wrap:anywhere}
.todo .next b{color:var(--accent)}
.code{display:flex;align-items:flex-start;gap:8px;margin-top:12px;background:var(--code);border:1px solid var(--line);border-radius:10px;padding:9px 9px 9px 12px}
.code pre{margin:0;flex:1;white-space:pre-wrap;overflow-wrap:anywhere;font-size:12.8px;line-height:1.5}
.copy{font:inherit;font-size:12px;font-weight:650;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:8px;padding:3px 9px;cursor:pointer}
.copy:hover{border-color:var(--accent)}
/* Copy on a tile (its line) and on a section (all of it: a table as rows, the lines as a list) */
.scopy{flex:none;display:inline-flex;align-items:center;gap:5px}
.scopy .ic{width:14px;height:14px}
.tcopy{position:absolute;top:10px;right:10px;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;
  color:var(--muted);background:none;border:1px solid transparent;border-radius:8px;cursor:pointer;opacity:.5}
.tcopy .ic{width:15px;height:15px}
.tile:hover .tcopy,.tcopy:focus-visible{opacity:1}
.tcopy:hover{color:var(--ink);background:var(--card-strong);border-color:var(--edge)}
.copy.done,.tcopy.done{color:var(--ok);border-color:var(--ok-bd);opacity:1}
.tcopy .i2,.scopy .i2,.done .i1{display:none}.done .i2{display:block}
.copy[hidden],.tcopy[hidden]{display:none}
@media (hover:none){.tcopy{opacity:.8}}
/* tables: the columns sized by what they hold (k-num, k-nw, k-mid, k-long, k-path); the headings stay at the top */
.tools2{display:flex;align-items:center;gap:10px;margin:0 0 10px}
.filter{font:inherit;font-size:14px;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:10px;padding:7px 12px;width:min(340px,100%)}
.shown{color:var(--muted);font-size:13px}
.tw{border:1px solid var(--edge);border-radius:12px;background:var(--card)}
.tw.scroll{overflow-x:auto;background:linear-gradient(90deg,var(--card) 30%,transparent) left/40px 100% no-repeat local,
  linear-gradient(270deg,var(--card) 30%,transparent) right/40px 100% no-repeat local,
  radial-gradient(farthest-side at 0 50%,rgba(0,0,0,.18),transparent) left/12px 100% no-repeat scroll,
  radial-gradient(farthest-side at 100% 50%,rgba(0,0,0,.18),transparent) right/12px 100% no-repeat scroll,var(--card)}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:var(--fs)}
th{position:sticky;top:var(--appbar);z-index:2;background:var(--card-strong);text-align:left;font-size:11.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--label);
  border-bottom:1px solid var(--edge);padding:0;vertical-align:bottom}
.tw.scroll th{position:static}
th:first-child{border-top-left-radius:11px}th:last-child{border-top-right-radius:11px}
th button{all:unset;display:flex;align-items:center;gap:6px;padding:10px var(--cx);cursor:pointer;width:100%;box-sizing:border-box;text-wrap:balance}
th.k-num button{justify-content:flex-end}
th.k-num,th.k-nw{white-space:nowrap}
th .sort{opacity:.35;font-size:10px}
th[aria-sort] .sort{opacity:1;color:var(--accent)}
td{padding:var(--cy) var(--cx);border-top:1px solid var(--line);vertical-align:top;white-space:pre-line;line-height:1.5}
tbody tr:first-child td{border-top:0}
tbody tr:nth-child(even) td{background:var(--zebra)}
tbody tr:hover td{background:var(--hover)}
tbody tr:last-child td:first-child{border-bottom-left-radius:11px}tbody tr:last-child td:last-child{border-bottom-right-radius:11px}
td.k-num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
td.k-nw,td.nw{white-space:nowrap}
td.k-mid{min-width:16ch}td.k-mid .w{white-space:nowrap}
td.k-long{min-width:28ch;text-wrap:pretty}
td.k-path,td.lk{font-size:.92em;min-width:30ch;overflow-wrap:anywhere;color:var(--ink)}
td.lk{color:var(--muted)}
td .chip{white-space:normal;border-radius:10px}td.nw .chip{white-space:nowrap}
tr.r-critical td{background:var(--critical-row)}tr.r-critical td:first-child{box-shadow:inset 3px 0 0 var(--critical)}
tr.r-warning td{background:var(--warning-row)}tr.r-warning td:first-child{box-shadow:inset 3px 0 0 var(--warning)}
tr.r-ok td:first-child{box-shadow:inset 3px 0 0 var(--ok)}
tr.r-info td:first-child{box-shadow:inset 3px 0 0 var(--info)}
tr.r-critical:hover td,tr.r-warning:hover td{background:var(--hover)}
.none{color:var(--muted);padding:4px 0}
footer{margin-top:28px;text-align:center;color:var(--muted);font-size:13px;line-height:1.7}
@media (max-width:1000px){.brand{max-width:none}.brand b{display:none}}
@media (max-width:640px){
  :root{--appbar:0px}
  .appbar{position:static}.appbar-in{flex-wrap:wrap;gap:8px;padding:8px 12px}.nav{order:3;flex-basis:100%;padding:0 0 4px}
  .wrap{padding:12px 12px 30px}.hero{padding:20px 16px 16px}.runs{margin-left:0;width:100%}
  .tiles{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.tile .v{font-size:28px}
  .sec>summary{padding:14px 16px}.body{padding:12px 14px 14px}
  .seg button span,.tools .btn span{display:none}.seg button{padding:6px 8px}
  /* a table's rows as small cards, each value under its column's name */
  .tw,.tw.scroll{border:0;background:none;overflow:visible}
  .tw table,.tw tbody,.tw tr,.tw td{display:block;width:100%}
  .tw thead{display:none}
  .tw tbody tr{background:var(--card-strong);border:1px solid var(--line);border-radius:12px;padding:6px 0;margin-bottom:8px}
  .tw td,.tw td.k-nw,.tw td.nw,.tw td.k-num{white-space:normal;text-align:left;min-width:0}
  .tw td{border:0;padding:4px 14px;display:grid;grid-template-columns:minmax(90px,34%) 1fr;gap:10px;align-items:start;background:none!important}
  .tw td:before{content:attr(data-l);font-family:"Segoe UI",system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label);padding-top:3px}
  .tw td .chip{justify-self:start}
  tr.r-critical td:first-child,tr.r-warning td:first-child,tr.r-ok td:first-child,tr.r-info td:first-child{box-shadow:none}
  tr.r-critical{box-shadow:inset 4px 0 0 var(--critical)}tr.r-warning{box-shadow:inset 4px 0 0 var(--warning)}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}html{scroll-behavior:auto}}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
@page{size:landscape;margin:12mm}
@media print{
  :root{--appbar:0px}
  html,body{background:#fff!important;color:#000}.card,.todo,.tw,.tile{background:#fff!important;box-shadow:none!important;border-color:#bbb!important}
  .appbar,.tools2,.copy,.tcopy,.hero:after{display:none!important}.sec{break-inside:auto}th{position:static}thead{display:table-header-group}
  tr,.todo,.tile{break-inside:avoid}.tw.scroll{overflow:visible}.chip,.hero:before,.todo:before,.tile:before{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
<body>
{%- set secs = r.sections | default([]) %}
<div class="appbar"><div class="appbar-in">
<div class="brand">
{%- if logo_cid %}
<img class="logo" src="cid:{{ logo_cid }}" width="{{ logo_size[0] }}" height="{{ logo_size[1] }}" alt="">
{%- endif %}
<b>{{ report_email_header_text | default('Site automation report') | e }}</b></div>
{%- if secs | length > 2 %}
<nav class="nav" aria-label="Sections">
{%- for s in secs %}
{%- set ss = s.status | default('') %}
<a href="#s{{ loop.index }}">{% if ss in words %}<span class="dot c-{{ ss }}"></span>{% endif %}{{ s.title | e }}{% if s.rows is defined and s.rows %} <span class="n">{{ s.rows | length }}</span>{% endif %}</a>
{%- endfor %}
</nav>
{%- endif %}
<div class="tools">
<div class="seg" id="density" role="radiogroup" aria-label="Row height" hidden>
<button type="button" role="radio" data-d="compact" title="Compact rows"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 6.5h12M2 9.5h12M2 12.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Compact</span></button>
<button type="button" role="radio" data-d="comfortable" title="Comfortable rows"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Comfortable</span></button>
</div>
<div class="seg" id="theme" role="radiogroup" aria-label="Light or dark" hidden>
<button type="button" role="radio" data-t="light" title="Light"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="currentColor"/><path d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3 3l1.3 1.3M11.7 11.7L13 13M3 13l1.3-1.3M11.7 4.3L13 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Light</span></button>
<button type="button" role="radio" data-t="auto" title="As this device is set"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.6a6.4 6.4 0 010 12.8z" fill="currentColor"/></svg><span>Auto</span></button>
<button type="button" role="radio" data-t="dark" title="Dark"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.6 10.2A6 6 0 015.8 2.4a6 6 0 107.8 7.8z" fill="currentColor"/></svg><span>Dark</span></button>
</div>
<button class="btn" type="button" id="print" hidden><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6V1.8h8V6M4 11.5H2.4V6h11.2v5.5H12M4.2 9.2h7.6v5H4.2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><span>Print</span></button>
</div>
</div></div>
<main class="wrap">
<header class="card hero h-{{ st }}">
{%- if job_name %}
<div class="eyebrow">{{ job_name | e }}</div>
{%- endif %}
<h1>{{ r.title | e }}</h1>
{%- if r.subtitle | default('') %}
<div class="sub">{{ r.subtitle | e }}</div>
{%- endif %}
<div class="state">
{{ chip(st, words[st]) }}
<span class="meta">{%- if job_id %}<span>AAP job {{ job_id | e }}</span>{% endif %}{% if awx_user_name | default('') %}<span>run by {{ awx_user_name | e }}</span>{% endif %}</span>
{%- if runs %}
<div class="runs" role="img" aria-label="The last {{ runs | length }} runs">
<span class="lbl">Last {{ runs | length }} run{{ 's' if runs | length != 1 else '' }}</span>
{%- for b in runs %}
<span class="bar c-{{ b.status if b.status in words else 'unknown' }}{{ ' now' if b.current else '' }}" style="height:{{ [b.height | default(18) | int, 4] | max }}px" data-tip="{{ b.text | default('') | e }}{{ (' (' ~ b.ago ~ ' ago)') if b.ago | default('') else '' }}" title="{{ b.text | default('') | e }}"></span>
{%- endfor %}
</div>
{%- endif %}
</div>
</header>
{%- if r.summary | default([]) %}
<div class="tiles">
{%- for t in r.summary %}
{%- set ts = t.status | default('') %}
{%- set v = ('' if t.value is none else t.value) | string %}
<div class="card tile{{ ' hot-' ~ ts if ts in ['critical', 'warning'] and v not in ['0', ''] else '' }}">
<button class="tcopy" type="button" hidden title="Copy" aria-label="Copy {{ t.label | e }}" data-copy="{{ t.label | e }}: {{ v | e }}{{ (' (' ~ t.note ~ ')') | e if t.note | default('') else '' }}">{{ copyicons() }}</button>
<div class="k">{% if ts in words %}<span class="c-{{ ts }}">{{ icon(ts) }}</span>{% endif %}{{ t.label | e }}</div>
<div class="v{{ ' long' if v | length > 9 else '' }}{{ (' c-' ~ ts) if ts in ['critical', 'warning'] and v not in ['0', ''] else '' }}">{{ v | e }}</div>
{%- if t.note | default('') %}
<div class="n">{{ t.note | e }}</div>
{%- endif %}
</div>
{%- endfor %}
</div>
{%- endif %}
{%- for s in secs %}
{%- set ss = s.status | default('') %}
{%- set si = loop.index %}
<details class="card sec" id="s{{ si }}" open>
<summary><h2>{{ s.title | e }}{% if s.rows is defined %}<span class="count">{{ s.rows | length }}</span>{% endif %}</h2>
{%- if ss in words %}{{ chip(ss, chipword[ss]) }}{% endif %}
<button class="copy scopy" type="button" hidden title="Copy this section" aria-label="Copy {{ s.title | e }}">{{ copyicons() }}<span class="t">Copy</span></button>
<svg class="caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
<div class="body">
{%- if s.passed | default([]) %}
{%- if s.passed_checks | default([]) %}
<div class="passed-checks">Every check passed: {% for c in s.passed_checks %}{{ chip('ok', c) }} {% endfor %}</div>
{%- endif %}
<ul class="passed">
{%- for h in s.passed %}
<li><span class="c-ok">{{ icon('ok') }}</span><span class="mono">{{ h | e }}</span></li>
{%- endfor %}
</ul>
{%- elif s.text | default('') %}
<p>{{ s.text | e }}</p>
{%- endif %}
{%- if s.cards | default([]) %}
<div class="cards">
{%- for c in s.cards %}
{%- set cst = c.status if c.status in words else 'info' %}
<article class="todo c-{{ cst }}">
<div class="row1">{{ chip(cst, c.chip | default(chipword[cst], true)) }}{% if c.meta | default('') %}<span class="meta">{{ c.meta | e }}</span>{% endif %}</div>
<h3>{{ c.title | default('') | e }}</h3>
{%- if c.subject | default('') %}
<div class="subj mono">{{ c.subject | e }}</div>
{%- endif %}
{%- if c.next | default('') %}
<div class="next"><b>Next &rarr;</b> {{ c.next | e }}</div>
{%- endif %}
{%- if c.code | default('') %}
<div class="code"><pre>{{ c.code | e }}</pre><button class="copy" type="button" hidden>Copy</button></div>
{%- endif %}
</article>
{%- endfor %}
</div>
{%- endif %}
{%- if s.columns is defined %}
{%- if s.rows | default([]) %}
{#- each column's kind, from what it holds (its first 300 rows): num - every value a number; path - mostly paths,
    addresses or one long token; nw - nothing longer than 24 characters (ids, dates, hosts, words); long - prose over
    70; mid - the rest -#}
{%- set kinds = [] %}
{%- for c in s.columns %}
{%- set j = loop.index0 %}
{%- set ns = namespace(n=0, mx=0, num=0, path=0) %}
{%- for row in s.rows[:300] %}
{%- set v = row[j] if row | length > j else none %}
{%- set t = ('' if v is none else v) | string | trim %}
{%- if t %}
{%- set ns.n = ns.n + 1 %}
{%- if t | length > ns.mx %}{% set ns.mx = t | length %}{% endif %}
{%- if t.replace(',', '').replace('%', '').strip().lstrip('-').replace('.', '', 1).isdigit() %}{% set ns.num = ns.num + 1 %}{% endif %}
{%- if t.startswith('/') or t[1:3] == ':\\' or t.startswith('\\\\') or t.startswith('http') or (' ' not in t and t | length > 30) %}{% set ns.path = ns.path + 1 %}{% endif %}
{%- endif %}
{%- endfor %}
{%- set _ = kinds.append('num' if ns.n and ns.num == ns.n else ('path' if ns.n and ns.path * 2 >= ns.n else ('nw' if ns.mx <= 24 else ('long' if ns.mx > 70 else 'mid')))) %}
{%- endfor %}
{%- if s.rows | length > 8 %}
<div class="tools2" hidden><input class="filter" type="search" placeholder="Filter these {{ s.rows | length }} rows" aria-label="Filter the rows of {{ s.title | e }}"><span class="shown"></span></div>
{%- endif %}
<div class="tw"><table>
<thead><tr>
{%- for c in s.columns %}
<th class="k-{{ kinds[loop.index0] }}" scope="col"><button type="button">{{ c | e }}<span class="sort" aria-hidden="true">&#8597;</span></button></th>
{%- endfor %}
</tr></thead>
<tbody>
{%- for row in s.rows %}
{%- set rs = (s.row_status[loop.index0] if s.row_status is defined and s.row_status | length > loop.index0 else '') | default('', true) %}
{%- set cs = (s.cell_status[loop.index0] if s.cell_status is defined and s.cell_status | length > loop.index0 else []) | default([], true) %}
<tr{% if rs in words %} class="r-{{ rs }}"{% endif %}>
{%- for cell in row %}
{%- set text = ('' if cell is none else cell) | string %}
{%- set lbl = s.columns[loop.index0] | default('') | string %}
{%- set kd = kinds[loop.index0] | default('mid') %}
{%- set cst = (cs[loop.index0] if cs | length > loop.index0 else '') | default('', true) %}
{%- set cst = cst if cst in words else cellword.get(text | trim | lower, '') %}
{#- a Status or Severity column of a row with its status: that status's chip (upper case - FAIL - as Fail; a STIG CAT I stays) #}
{%- set cst = cst or (rs if rs in words and lbl | lower in ['status', 'severity', 'result'] and text | trim else '') %}
{%- if cst %}
<td data-l="{{ lbl | e }}" data-v="{{ text | e }}"{% if text | length <= 32 %} class="nw"{% else %} class="k-mid"{% endif %}>{{ chip(cst, text | capitalize if text.isupper() and not text.startswith('CAT ') else text) }}</td>
{%- elif lbl | lower in ['look further', 'command', 'hint', 'next step'] %}
<td class="lk" data-l="{{ lbl | e }}">{{ breakable(text) }}</td>
{%- elif kd == 'path' %}
<td class="k-path" data-l="{{ lbl | e }}" data-v="{{ text | e }}">{{ breakable(text) }}</td>
{%- elif kd == 'mid' %}
{#- each word kept whole: a line breaks at a space, never at a hyphen inside an id (RHEL-09-412035) #}
<td class="k-mid" data-l="{{ lbl | e }}">{% for w in text.split(' ') %}{{ ' ' if not loop.first else '' }}{% if w | length <= 24 %}<span class="w">{{ w | e }}</span>{% else %}{{ w | e }}{% endif %}{% endfor %}</td>
{%- else %}
<td class="k-{{ kd }}" data-l="{{ lbl | e }}">{{ text | e }}</td>
{%- endif %}
{%- endfor %}
</tr>
{%- endfor %}
</tbody>
</table></div>
{%- else %}
<div class="none">None.</div>
{%- endif %}
{%- endif %}
{%- if s.lines | default([]) %}
<ul class="lines">
{%- for l in s.lines if l | trim %}
<li>{{ l | e }}</li>
{%- endfor %}
</ul>
{%- endif %}
</div>
</details>
{%- endfor %}
<footer>
{%- if r.footer | default('') %}{{ r.footer | e }}<br>{% endif %}
{{ _email_footer | default('') | e }}
</footer>
</main>
<script>
(function(){
  var root=document.documentElement;
  /* a switch of the bar: its buttons, what is set now, and what a click sets (kept in this browser) */
  function seg(id,attr,key,def){var g=document.getElementById(id);if(!g)return;
    function cur(){return root.getAttribute(attr)||def}
    function show(){g.querySelectorAll('button').forEach(function(x){x.setAttribute('aria-checked',x.getAttribute(attr==='data-theme'?'data-t':'data-d')===cur()?'true':'false')})}
    g.hidden=false;show();g.querySelectorAll('button').forEach(function(x){x.addEventListener('click',function(){
      var n=x.getAttribute(attr==='data-theme'?'data-t':'data-d');
      if(n===def)root.removeAttribute(attr);else root.setAttribute(attr,n);
      try{if(n===def)localStorage.removeItem(key);else localStorage.setItem(key,n)}catch(e){}
      show();fit()})})}
  seg('theme','data-theme','site-report-theme','auto');
  seg('density','data-density','site-report-density','comfortable');
  var p=document.getElementById('print');if(p){p.hidden=false;p.addEventListener('click',function(){
    document.querySelectorAll('details.sec').forEach(function(d){d.open=true});window.print()})}
  /* a table wider than its card scrolls sideways (its headings then stay in it); one that fits keeps them at the top */
  function fit(){document.querySelectorAll('.tw').forEach(function(w){w.classList.remove('scroll');
    var t=w.querySelector('table');if(t&&t.scrollWidth>w.clientWidth+1)w.classList.add('scroll')})}
  fit();var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(fit,120)});
  document.querySelectorAll('details.sec').forEach(function(d){d.addEventListener('toggle',fit)});
  /* the section in view, marked in the bar */
  var links={};document.querySelectorAll('.nav a').forEach(function(a){links[a.getAttribute('href').slice(1)]=a});
  if(window.IntersectionObserver&&Object.keys(links).length){var seen={};
    var io=new IntersectionObserver(function(es){es.forEach(function(e){seen[e.target.id]=e.isIntersecting});
      var first=null;document.querySelectorAll('details.sec').forEach(function(d){if(!first&&seen[d.id])first=d.id});
      Object.keys(links).forEach(function(k){links[k].classList.toggle('on',k===first)});
      if(first&&links[first].scrollIntoView&&links[first].parentNode.scrollWidth>links[first].parentNode.clientWidth){
        var n=links[first].parentNode,l=links[first];n.scrollLeft=l.offsetLeft-n.clientWidth/3}},{rootMargin:'-70px 0px -55% 0px'});
    document.querySelectorAll('details.sec').forEach(function(d){io.observe(d)})}
  /* Copy: the text, and with it the same as HTML where the browser allows it (a table pastes as a table in Word,
     Outlook and Excel, the lines as a list); over plain http or from a share the old way, text only */
  function put(b,plain,html){
    var c=navigator.clipboard,s=b.querySelector('.t');
    function ok(){b.classList.add('done');if(s)s.textContent='Copied';else if(!b.querySelector('.i1'))b.textContent='Copied';
      setTimeout(function(){b.classList.remove('done');if(s)s.textContent='Copy';else if(!b.querySelector('.i1'))b.textContent='Copy'},1500)}
    function old(){var a=document.createElement('textarea');a.value=plain;a.setAttribute('readonly','');a.style.position='fixed';a.style.opacity='0';
      document.body.appendChild(a);a.select();try{if(document.execCommand('copy'))ok()}catch(e){}a.remove()}
    function txt(){if(c&&c.writeText)c.writeText(plain).then(ok,old);else old()}
    if(html&&c&&c.write&&window.ClipboardItem){try{c.write([new ClipboardItem({'text/plain':new Blob([plain],{type:'text/plain'}),
      'text/html':new Blob([html],{type:'text/html'})})]).then(ok,txt)}catch(e){txt()}}
    else txt()}
  function esc(t){return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
  function one(el){return (el?el.textContent:'').replace(/\s+/g,' ').trim()}
  function head(th){var b=th.querySelector('button'),f=b&&b.firstChild;return f&&f.nodeType===3?f.textContent.trim():one(th)}
  function tr(r,t){return '<tr>'+r.map(function(x){return '<'+t+' style="border:1px solid #999;padding:3px 6px;text-align:left">'+esc(x)+'</'+t+'>'}).join('')+'</tr>'}
  /* a section as text and HTML: its lines as a list, its table (the rows shown, in their order) as rows with tabs
     between the columns, its cards one after the other; its words (what the section is) only when it has nothing else */
  function grab(body){var P=[],H=[],W=[],WH=[];
    [].forEach.call(body.children,function(el){
      if(el.classList.contains('tools2'))return;
      if(el.tagName==='UL'){var li=[].map.call(el.children,one).filter(Boolean);
        P.push(li.map(function(x){return '- '+x}).join('\n'));H.push('<ul>'+li.map(function(x){return '<li>'+esc(x)+'</li>'}).join('')+'</ul>');return}
      if(el.classList.contains('tw')){var tb=el.querySelector('table'),hd=[].map.call(tb.tHead.rows[0].cells,head),
          rs=[].filter.call(tb.tBodies[0].rows,function(r){return !r.hidden}).map(function(r){return [].map.call(r.cells,one)});
        P.push([hd].concat(rs).map(function(r){return r.join('\t')}).join('\n'));
        H.push('<table style="border-collapse:collapse">'+tr(hd,'th')+rs.map(function(r){return tr(r,'td')}).join('')+'</table>');return}
      if(el.classList.contains('cards')){[].forEach.call(el.querySelectorAll('.todo'),function(a){
          var l=[one(a.querySelector('.row1')),one(a.querySelector('h3')),one(a.querySelector('.subj')),one(a.querySelector('.next'))].filter(Boolean),
              pre=a.querySelector('pre'),code=pre?pre.textContent:'';
          P.push(l.join('\n')+(code?'\n'+code:''));H.push(l.map(function(x){return '<p>'+esc(x)+'</p>'}).join('')+(code?'<pre>'+esc(code)+'</pre>':''))});return}
      var t=one(el);if(t){W.push(t);WH.push('<p>'+esc(t)+'</p>')}});
    return P.length?[P.join('\n\n'),H.join('')]:[W.join('\n\n'),WH.join('')]}
  document.querySelectorAll('.code .copy').forEach(function(c){c.hidden=false;c.addEventListener('click',function(){
    put(c,c.previousElementSibling.textContent,'')})});
  document.querySelectorAll('.tcopy').forEach(function(c){c.hidden=false;c.addEventListener('click',function(){put(c,c.getAttribute('data-copy'),'')})});
  document.querySelectorAll('.scopy').forEach(function(c){c.hidden=false;c.addEventListener('click',function(e){
    e.preventDefault();e.stopPropagation();var g=grab(c.closest('details').querySelector('.body'));put(c,g[0],g[1])})});
  document.querySelectorAll('.tw table').forEach(function(tb){
    var body=tb.tBodies[0],rows=[].slice.call(body.rows);
    tb.querySelectorAll('th button').forEach(function(btn,i){btn.addEventListener('click',function(){
      var th=btn.parentNode,asc=th.getAttribute('aria-sort')!=='ascending';
      tb.querySelectorAll('th').forEach(function(h){h.removeAttribute('aria-sort');h.querySelector('.sort').innerHTML='&#8597;'});
      th.setAttribute('aria-sort',asc?'ascending':'descending');btn.querySelector('.sort').innerHTML=asc?'&#9650;':'&#9660;';
      function key(r){var c=r.cells[i];var v=c?(c.getAttribute('data-v')||c.textContent).trim():'';var n=parseFloat(v.replace(/[, %]/g,''));
        return /^-?[\d.,]+\s*%?$/.test(v)&&!isNaN(n)?[0,n]:[1,v.toLowerCase()]}
      rows.slice().sort(function(a,b){var x=key(a),y=key(b);var r=x[0]-y[0]||(x[1]<y[1]?-1:x[1]>y[1]?1:0);return asc?r:-r})
        .forEach(function(r){body.appendChild(r)})})});
    var tools=tb.parentNode.previousElementSibling;
    if(tools&&tools.classList.contains('tools2')){tools.hidden=false;var f=tools.querySelector('.filter'),n=tools.querySelector('.shown');
      f.addEventListener('input',function(){var q=f.value.trim().toLowerCase(),k=0;
        rows.forEach(function(r){var on=!q||r.textContent.toLowerCase().indexOf(q)>=0;r.hidden=!on;if(on)k++});
        n.textContent=q?k+' of '+rows.length:''})}
  });
})();
</script>
</body>
</html>
