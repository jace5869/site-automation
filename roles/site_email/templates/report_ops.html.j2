{%- elif clu %}
{%- set cpy = (cl.copies[ri] if cl.copies is defined and cl.copies | length > ri else '') | default('', true) %}
<td class="k-{{ kd | e }} k-cl" data-l="{{ lbl | e }}" data-v="{{ text | e }}">{% if cpy %}<span class="clw">{% endif %}<a class="hl cv" href="{{ clu | e }}" target="_blank" rel="noopener" title="{{ (cl.titles[ri] if cl.titles is defined and cl.titles | length > ri else cl.title | default('')) | e }}">{% if kd == 'wrap' %}{% set ws = text.split(' ') %}{% for w in ws[:-1] %}<span class="w">{{ nbw(w) }}</span> <wbr>{% endfor %}{% if ws[-1] | length <= 16 %}<span class="w">{{ nbw(ws[-1]) }}<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% else %}{{ dw(ws[-1], false) }}<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}{% else %}{{ breakable(text) }}<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>{% if cpy %}<button class="ccopy" type="button" hidden title="Copy {{ cpy | e }}" aria-label="Copy {{ cpy | e }}" data-copy="{{ cpy | e }}">{{ copyicons() }}</button></span>{% endif %}</td>
{%- elif kd == 'buttons' %}
{#- 1.67.0 part C: a finding's buttons (the site portal's actions of its kind) - two shown, the rest under More #}
{%- set bs = (s.buttons[ri] if s.buttons is defined and s.buttons | length > ri else []) | default([], true) %}
<td class="k-buttons" data-l="{{ lbl | e }}" data-v="{{ text | e }}">{% if bs %}<span class="bts">{% for b in bs[:2] %}<a class="btn pl" href="{{ b.url | e }}" target="_blank" rel="noopener" title="Opens the site portal: you check and press Run there"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ b.label | e }}</span></a>{% endfor %}{% if bs | length > 2 %}<details class="more"><summary class="btn">More</summary><span class="menu">{% for b in bs[2:] %}<a class="btn pl" href="{{ b.url | e }}" target="_blank" rel="noopener" title="Opens the site portal: you check and press Run there"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ b.label | e }}</span></a>{% endfor %}</span></details>{% endif %}</span>{% endif %}</td>
{%- elif kd == 'link' %}
{%- set url = (s.links[ri] if s.links is defined and s.links | length > ri else '') | default('', true) %}
<td class="k-link" data-l="{{ lbl | e }}" data-v="{{ url | e }}">{% if url and text | trim %}<a class="btn pl" href="{{ url | e }}" target="_blank" rel="noopener" title="Opens the site portal: you check and press Run there"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ text | e }}</span></a>{% endif %}</td>
{%- elif kd == 'spark' %}
{%- set sp = (s.sparks[ri] if s.sparks is defined and s.sparks | length > ri else {}) | default({}, true) %}
<td class="k-spark" data-l="{{ lbl | e }}" data-v="{{ text | e }}">{% if sp.points is defined %}{% set dp = [] %}{% for p in sp.data_points | default([]) %}{% set _ = dp.append([p.x, p.y, p.label, p.text]) %}{% endfor %}<svg class="spark{{ (' hu' ~ sp.hue) if sp.hue is defined else '' }}" viewBox="0 0 {{ sp.w }} {{ sp.h }}" width="{{ sp.w }}" height="{{ sp.h }}" role="img" aria-label="{{ sp.label | e }}"{% if dp %} tabindex="0" data-label="{{ sp.name | default('') | e }}" data-points='{{ dp | tojson }}'>{% else %}><title>{{ sp.label | e }}</title>{% endif %}{% for y in sp.lines | default([]) %}<line class="lv" x1="0" x2="{{ sp.w }}" y1="{{ y }}" y2="{{ y }}"/>{% endfor %}{% if sp.mark is defined and sp.mark is not none %}<line class="mk" x1="{{ sp.mark }}" x2="{{ sp.mark }}" y1="0" y2="{{ sp.h }}"/>{% endif %}<polyline class="ln" points="{{ sp.points }}"/><circle class="pt" cx="{{ sp.last[0] }}" cy="{{ sp.last[1] }}" r="4"/></svg>{% endif %}</td>
{%- elif cst %}
<td data-l="{{ lbl | e }}" data-v="{{ text | e }}"{% if kd == 'wrap' and text | length > 12 %} class="k-wrap"{% elif text | length <= 32 %} class="nw{{ " k-rc" if kd == "num" else "" }}"{% else %} class="k-mid"{% endif %}>{{ chip(cst, text | capitalize if text.isupper() and not text.startswith('CAT ') and not s.keep_case | default(false) else text) }}</td>
{%- elif lbl | lower in ['look further', 'command', 'hint', 'next step'] %}
<td class="lk" data-l="{{ lbl | e }}" data-v="{{ text | e }}">{% if text | trim %}<span class="cv"><span class="cmd">{{ breakable(text) }}</span><button class="ccopy" type="button" hidden title="Copy" aria-label="Copy the command">{{ copyicons() }}</button></span>{% endif %}</td>
{%- elif kd == 'path' %}
<td class="k-path" data-l="{{ lbl | e }}" data-v="{{ text | e }}"><span class="cv">{{ breakable(text) }}</span></td>
{%- elif kd == 'wrap' %}
{#- a column the report says wraps (1.12.0): its lines kept, a word up to 16 characters kept whole (cluster1-01, AFF-A400),
    a longer one breaks at its hyphens rather than widen the table (na-cluster-site-a-prod) #}
<td class="k-wrap" data-l="{{ lbl | e }}" data-v="{{ text | e }}"><span class="cv">{% for ln in text.split('\n') %}{% if not loop.first %}{{ '\n' }}{% endif %}{% for w in ln.split(' ') %}{{ ' ' if not loop.first else '' }}{% if s.details is defined and w.isascii() and w.isalpha() and w | length <= 12 %}{{ w | e }}{% elif w | length <= 16 %}<span class="w">{{ nbw(w) }}</span>{% else %}{{ dw(w, ('link' in kinds or 'buttons' in kinds)) }}{% endif %}{% endfor %}{% endfor %}</span></td>
{%- elif kd == 'mid' %}
{#- each word kept whole: a line breaks at a space, never at a hyphen inside an id (RHEL-09-412035) #}
<td class="k-mid" data-l="{{ lbl | e }}"><span class="cv">{% for ln in text.split('\n') %}{{ '\n' if not loop.first else '' }}{% for w in ln.split(' ') %}{{ ' ' if not loop.first else '' }}{% if s.details is defined and w.isascii() and w.isalpha() and w | length <= 12 %}{{ w | e }}{% elif w | length <= 24 %}<span class="w">{{ nbw(w) }}</span>{% else %}{{ dw(w, ('link' in kinds or 'buttons' in kinds)) }}{% endif %}{% endfor %}{% endfor %}</span></td>
{%- else %}
<td class="k-{{ ('num' if kd == 'pct' else kd) | e }}" data-l="{{ lbl | e }}">{% if ('link' in kinds or 'buttons' in kinds) and kd == 'long' and '\n' not in text and text | length > 24 %}<span class="cv">{% for w in text.split(' ') %}{{ ' ' if not loop.first else '' }}{{ dw(w, true) }}{% endfor %}</span>{% else %}{% set kv = text | e if kd in ['num', 'pct'] else keep(text) %}{% if '<' in kv %}<span class="cv">{{ kv }}</span>{% else %}{{ kv }}{% endif %}{% endif %}</td>
{%- endif %}
{%- endif %}
{%- endfor %}
</tr>
{%- if dt %}
<!--defer-detail--><tr class="xr" hidden><td class="xd" colspan="{{ s.columns | length }}">{% for t in (dt if dt is sequence and dt is not string and dt is not mapping else [dt]) %}{{ xmini(t) }}{% endfor %}</td></tr><!--/defer-detail-->
{%- endif %}
{%- endfor %}
{%- if s.rows | length > 100 %}<!--/defer-main-->{% endif %}
</tbody>
</table></div>
{%- else %}
<div class="none">None.</div>
{%- endif %}
{%- endif %}
{#- 1.67.0: rows that open (the STIG scorecard's collections) - each its own details: its counts, then small tables #}
{%- if s.groups | default([]) %}
<div class="grps">
{%- if s.groups_text | default('') %}
<p class="gt">{{ s.groups_text | e }}</p>
{%- endif %}
{%- for g in s.groups %}
{%- set gt = g.tags | default({}, true) %}
<details class="grp" id="{{ g.id | e }}"{% if gt.pf | default('') %} data-pf="{{ gt.pf | e }}"{% endif %}{% if gt.col | default('') %} data-col="{{ gt.col | e }}"{% endif %}>
<summary><span class="gn">{{ g.title | e }}</span>{% for c in g.counts | default([]) %}<span class="gc{{ ' c-' ~ c[2] if c[2] in words else '' }}">{% if c[2] in words %}{{ icon(c[2]) }}{% endif %}{{ c[0] | e }} <b>{{ c[1] | e }}</b></span>{% endfor %}<span class="gm">{{ g.meta | default('') | e }}</span><svg class="caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
<div class="gb">
{%- for l in g.lines | default([]) %}
<p class="gl">{{ l | e }}</p>
{%- endfor %}
{%- for t in g.tables | default([]) %}
<h3 class="gh">{{ t.title | e }}</h3>
<div class="tw"><table class="mini">
<thead><tr>{% for c in t.columns %}<th class="{{ 'k-num' if t.kinds[loop.index0] | default('') == 'num' else 'k-mid' }}" scope="col">{{ c | e }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for row in t.rows %}
{%- if loop.index == 101 %}<!--defer-mini {{ loop.length }}-->{% endif %}
{%- set gr = (t.row_status[loop.index0] if t.row_status is defined and t.row_status | length > loop.index0 else '') | default('', true) %}
<tr{% if gr in words %} class="r-{{ gr }}"{% endif %}>{% for cell in row %}{% set kd = t.kinds[loop.index0] | default('') %}<td class="{{ 'k-num' if kd == 'num' else ('k-wrap' if kd == 'wrap' else 'nw') }}" data-l="{{ t.columns[loop.index0] | e }}">{% if gr in words and (cell | string).startswith('CAT ') %}{{ chip(gr, cell | string) }}{% elif kd == 'wrap' %}<span class="cv">{% for w in (cell | string).split(' ') %}{{ ' ' if not loop.first else '' }}{% if w.isascii() and w.isalpha() and w | length <= 12 %}{{ w | e }}{% elif w | length <= 16 %}<span class="w">{{ nbw(w) }}</span>{% else %}{{ w | e }}{% endif %}{% endfor %}</span>{% else %}{{ cell | e }}{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
{%- if t.rows | length > 100 %}<!--/defer-mini-->{% endif %}
</tbody>
</table></div>
{%- endfor %}
</div>
</details>
{%- endfor %}
</div>
{%- endif %}
{%- if s.note | default('') %}
<div class="snote"><p>{{ s.note | e }}</p>{% if s.note_more | default('') %}<details class="snm"><summary>More</summary><p>{{ s.note_more | e }}</p></details>{% endif %}</div>
{%- endif %}
{%- if (s.lines | default([]) or s.line_folds | default([])) and not s.glance | default([]) %}
<ul class="lines">
{%- for l in s.lines | default([]) if l | trim %}
<li>{{ l | e }}</li>
{%- endfor %}
{#- 1.118.5: a line whose long list opens with a click (the STIG scorecard's Other) - details, no script #}
{%- for fl in s.line_folds | default([]) if fl.text | default('') %}
<li><details class="snm"><summary>{{ fl.text | e }}</summary><p>{{ fl.more | default('') | e }}</p></details></li>
{%- endfor %}
</ul>
{%- endif %}
</div>
{%- if not start %}
<div class="cf"><span class="src">{{ s.source | default(src, true) | e }}{{ (' · ' ~ when) | e if when else '' }}</span>
{%- for a in s.actions | default([]) if a.url | default('') %}
<a class="btn pl" href="{{ a.url | e }}" target="_blank" rel="noopener" title="Opens the site portal: you check and press Run there"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{{ a.label | e }}</span></a>
{%- endfor %}
{%- if xp %}<label class="xpl" for="xp{{ si }}"><span class="o">Explore &rarr;</span><span class="c">Less &uarr;</span></label>{% endif %}</div>
{%- endif %}
</details>
{%- endif %}
{%- endfor %}
{%- if run.open %}
</div>
{%- endif %}
</div>
<footer>
{%- if rhead.method %}{{ rhead.method | e }}<br>{% endif %}
{%- if r.footer | default('') %}{{ r.footer | e }}<br>{% endif %}
{{ _email_footer | default('') | e }}
</footer>
</main>
</div>
<script id="site-report-js">
{% include 'site_report.js' %}
{% include 'report_pop.js' %}
</script>
</body>
</html>
