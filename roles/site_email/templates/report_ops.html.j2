<!--[if mso]><style>*{letter-spacing:normal!important}</style><![endif]--><!-- 1.87.2: classic Outlook (Word) mis-measures negative em letter-spacing: none there -->
</head>
<body>
{%- set secs = r.sections | default([]) %}
{#- the run's time, for the cards' footers: the footer line's last part (AAP job N (template), started by X, TIME.) #}
{%- set ft = _email_footer | default('') | string %}
{%- set when = ((ft.split(' started by ', 1)[1].split(', ', 1)[1] if ', ' in ft.split(' started by ', 1)[1] else '') if ' started by ' in ft else '').split('. ')[0].strip().rstrip('.') %}
{%- set src = job_name or (('AAP job ' ~ job_id) if job_id else report_email_header_text | default('Site automation report')) %}
<div class="appbar"><div class="appbar-in"><!--site-report-back-->
<div class="brand">
{%- if logo_cid %}
<img class="logo" src="cid:{{ logo_cid }}" width="{{ logo_size[0] }}" height="{{ logo_size[1] }}" alt="">
{%- endif %}
<b>{{ report_email_header_text | default('Site automation report') | e }}</b></div>
{%- if secs | length > 2 %}
<nav class="nav railed" aria-label="Sections">
{%- for s in secs %}
{%- if s.rail | default(true) %}
{%- set ss = s.status | default('') %}
<a href="#s{{ loop.index }}">{% if ss in words %}<span class="dot c-{{ ss }}" data-g="{{ {'critical': '!', 'warning': '\u25b4', 'ok': '\u2713', 'info': 'i', 'low': '-', 'unknown': '?'}[ss] }}" aria-hidden="true"></span><span class="vh">{{ words[ss] }}: </span>{% endif %}{{ s.title | e }}{% if s.rows is defined and s.rows %} <span class="n">{{ s.rows | length }}</span>{% endif %}</a>
{%- endif %}
{%- endfor %}
</nav>
{%- endif %}
<div class="find" role="search" hidden><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.4 10.4L14 14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><input id="find" type="search" placeholder="Search this report" aria-label="Search this report" autocomplete="off" spellcheck="false"><span class="found" aria-live="polite"></span></div>
<div class="tools">
<div class="seg" id="density" role="radiogroup" aria-label="Row height">
<input type="radio" name="site-report-density" id="density-compact" value="compact"><label for="density-compact" title="Compact rows"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 6.5h12M2 9.5h12M2 12.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Compact</span></label>
<input type="radio" name="site-report-density" id="density-comfortable" value="comfortable" checked><label for="density-comfortable" title="Comfortable rows"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Comfortable</span></label>
</div>
<div class="seg" id="theme" role="radiogroup" aria-label="Light or dark">
<input type="radio" name="site-report-theme" id="theme-light" value="light"><label for="theme-light" title="Light"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="currentColor"/><path d="M8 1v1.8M8 13.2V15M1 8h1.8M13.2 8H15M3 3l1.3 1.3M11.7 11.7L13 13M3 13l1.3-1.3M11.7 4.3L13 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Light</span></label>
<input type="radio" name="site-report-theme" id="theme-auto" value="auto" checked><label for="theme-auto" title="As this device is set"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.6a6.4 6.4 0 010 12.8z" fill="currentColor"/></svg><span>Auto</span></label>
<input type="radio" name="site-report-theme" id="theme-dark" value="dark"><label for="theme-dark" title="Dark"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.6 10.2A6 6 0 015.8 2.4a6 6 0 107.8 7.8z" fill="currentColor"/></svg><span>Dark</span></label>
</div>
<button class="btn" type="button" id="print" hidden><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6V1.8h8V6M4 11.5H2.4V6h11.2v5.5H12M4.2 9.2h7.6v5H4.2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><span>Print</span></button>
</div>
</div></div>
<div class="wrap{{ ' has-rail' if secs | length > 2 else '' }}">
{#- the sections' rail (a wide screen, 1200 px and over): it stays in view under the bar (sticky, as tall as the screen
    under it, its own scroll), each group folds (what needs attention, then the rest), one button puts it all away
    (kept in this browser by site-report.js); a section picked lands under the bar (scroll-margin-top). Narrower: the
    bar's list of sections, which stays at the top #}
{%- if secs | length > 2 %}
{%- set hot = [] %}{% set rest = [] %}
{%- for s in secs %}{% if s.rail | default(true) %}{% set _ = (hot if s.status | default('') in ['critical', 'warning'] else rest).append(loop.index) %}{% endif %}{% endfor %}
<nav class="card rail" aria-label="Sections of this report">
<div class="top"><div class="lbl">Sections</div><input type="checkbox" id="rail-hide" aria-label="Put the sections away (wider tables)"><label class="railx" for="rail-hide" title="Put the sections away - the tables get the width; again to bring them back"><svg class="ic ic-hide" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 3.5L5 8l4.5 4.5M13 3.5L8.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><svg class="ic ic-show" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5L11 8l-4.5 4.5M3 3.5L7.5 8 3 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></label></div>
<a class="up" href="#top"><span class="t">&uarr; Top</span></a>
{%- for g in [('Needs attention', hot), ('Everything else' if hot else 'Every section', rest)] if g[1] %}
<details class="rg" open><summary><span class="rgt">{{ g[0] }}</span><span class="rgn">{{ g[1] | length }}</span><svg class="caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
{%- for i in g[1] %}
{%- set s = secs[i - 1] %}
{%- set ss = s.status | default('') %}
<a href="#s{{ i }}">{% if ss in words %}<span class="dot c-{{ ss }}" data-g="{{ {'critical': '!', 'warning': '\u25b4', 'ok': '\u2713', 'info': 'i', 'low': '-', 'unknown': '?'}[ss] }}" aria-hidden="true"></span><span class="vh">{{ words[ss] }}: </span>{% endif %}<span class="t">{{ s.title | e }}</span><span class="m"></span>{% if s.rows is defined and s.rows %}<span class="n">{{ s.rows | length }}</span>{% endif %}</a>
{%- endfor %}
</details>
{%- endfor %}
</nav>
{%- endif %}
<main class="main" id="top">
{#- the header card: the status, the verdict (the report's title) and what to do; the headline number - the first tile
    that is Critical, else Warning (not 0), else the first number (1.97.0: never a tile with counted: false, another system's); under it the subtitle and SHOW: the job, the runs #}
{%- set hd = namespace(t=none) %}
{%- for k in ['critical', 'warning'] %}
{%- for t in r.summary | default([]) %}
{%- if hd.t is none and t.counted | default(true) and t.status | default('') == k and (('' if t.value is none else t.value) | string) not in ['0', ''] %}{% set hd.t = t %}{% endif %}
{%- endfor %}
{%- endfor %}
{%- for t in r.summary | default([]) %}
{%- if hd.t is none and t.counted | default(true) and (('' if t.value is none else t.value) | string).replace(',', '').replace('.', '', 1).isdigit() %}{% set hd.t = t %}{% endif %}
{%- endfor %}
{%- set say = {'critical': 'Review what needs attention, worst first.', 'warning': 'Some items need a look.', 'ok': 'Nothing needs action.',
               'low': 'Nothing urgent - worth knowing.', 'unknown': 'Its state could not be read.'}.get(st, '') %}
<header class="hero card h-{{ st }}{{ ' dash-hero' if r.dashboard | default({}) else '' }}">
<div class="hgrid">
<div class="hl">
<span class="stc s-{{ st }}"><span class="d" aria-hidden="true"></span>{{ r.status_prefix | default('') }}{{ opsword[st] }}</span>
<h1>{{ rhead.name | e }}</h1>
{%- set head_scope = false %}
{%- include 'report_head.html.j2' %}
{%- if say and not r.dashboard | default({}) and not r.status_prefix | default('') %}
<p class="say">{{ say }}</p>
{%- endif %}
</div>
{%- if hd.t is not none and not r.dashboard | default({}) %}
{%- set hv = ('' if hd.t.value is none else hd.t.value) | string %}
<div class="hn"><div class="bn{{ ' long' if hv | length > 6 else '' }}{{ (' c-' ~ hd.t.status) if hd.t.status | default('') in ['critical', 'warning'] else '' }}">{{ hv | e }}</div><div class="cap">{{ hd.t.label | e }}{{ (' - ' ~ hd.t.note) | e if hd.t.note | default('') else '' }}</div></div>
{%- endif %}
</div>
{%- set crumbs = job_name or job_id or awx_user_name | default('') %}
{%- if rhead.scope_text or crumbs or runs %}
<details class="hstrip">
<summary><span class="ln1">{{ (rhead.scope_text or ((job_name ~ ' - ') if job_name else '') ~ ('AAP job ' ~ job_id if job_id else 'The run')) | e }}</span><span class="tog" aria-hidden="true"><span class="sh">SHOW</span><span class="hd">HIDE</span></span><span class="vh">Show the details</span></summary>
<div class="hmore">
{%- if crumbs %}
<div class="crumb">
{%- if job_name %}<span class="eyebrow">{{ job_name | e }}</span>{% endif %}
{%- if job_id %}<span>AAP job {{ job_id | e }}</span>{% endif %}
{%- if awx_user_name | default('') %}<span>run by {{ awx_user_name | e }}</span>{% endif %}
{%- if when %}<span>{{ when | e }}</span>{% endif %}</div>
{%- endif %}
{%- if runs %}
<div class="runs" role="img" aria-label="The last {{ runs | length }} runs">
<span class="lbl">Last {{ runs | length }} run{{ 's' if runs | length != 1 else '' }}</span>
{%- for b in runs %}
<span class="bar c-{{ b.status if b.status in words else 'unknown' }}{{ ' now' if b.current else '' }}" style="height:{{ [b.height | default(18) | int, 4] | max }}px" data-tip="{{ b.text | default('') | e }}{{ ((' (' ~ b.ago ~ ' ago)') if b.ago | default('') else '') | e }}" title="{{ b.text | default('') | e }}"></span>
{%- endfor %}
</div>
{%- endif %}
</div>
</details>
{%- endif %}
{%- include 'report_head_file.html.j2' %}
</header>
<!--site-report-files-->
{%- if r.summary | default([]) and not r.dashboard | default({}) and r.teams is not defined %}
{#- the row of tiles (1.71.0: a dashboard has its own, in At a glance) by their count (the user: no tile alone on a row): 5 in one row, 6 as 3 + 3, 7 and 8 as 4 + 4 (or
    + 3), 9 and 10 as 5 + 5 (or + 4); 2 to a row at 900 px and under #}
<div class="tiles t{{ r.summary | length if r.summary | length <= 10 else 'x' }}">
{%- for t in r.summary %}
{%- set ts = t.status | default('') %}
{%- set v = ('' if t.value is none else t.value) | string %}
{%- set hot = ts in ['critical', 'warning'] and v not in ['0', ''] %}
<div class="tile{{ (' tc k' ~ t.cat) if t.cat is defined else '' }}{{ ' hot-' ~ ts if hot else '' }}{{ ' tipped' if t.tip | default('') else '' }}"{% if t.tip | default('') %} tabindex="0" data-tip="{{ t.tip | e }}"{% endif %}>
<button class="tcopy" type="button" hidden title="Copy" aria-label="Copy {{ t.label | e }}" data-copy="{{ t.label | e }}: {{ v | e }}{{ (' (' ~ t.note ~ ')') | e if t.note | default('') else '' }}">{{ copyicons() }}</button>
<div class="k"><span class="d c-{{ ts if ts in words else 'unknown' }}" aria-hidden="true"></span>{{ t.label | e }}</div>
<div class="v{{ ' long' if v | length > 9 else '' }}{{ (' c-' ~ ts) if hot else '' }}">{{ v | e }}</div>
{%- if t.note | default('') %}
<div class="n">{{ t.note | e }}</div>
{%- elif ts in ['critical', 'warning', 'ok', 'low'] %}
<div class="n">{{ {'critical': 'Critical - needs action', 'warning': 'Warning - needs a look', 'ok': 'Healthy', 'low': 'Low - worth knowing'}[ts] if v not in ['0', ''] or ts == 'ok' else 'None' }}</div>
{%- endif %}
</div>
{%- endfor %}
</div>
{%- endif %}
{%- if not r.dashboard | default({}) %}
{#- 1.67.0: the page's filter buttons (r.facets: the STIG scorecard's Platform and Collection) - site-report.js shows
    them and hides the rows and the collections that are not the choice; without the script they are not shown #}
{%- set fx = r.facets | default({}, true) %}
{%- if fx.platforms | default([]) or fx.collections | default([]) %}
<div class="facets" hidden role="group" aria-label="Choose the rows shown">
{%- if fx.platforms | default([]) %}
<span class="fl" id="fl-pf">{{ fx.pf_label | default('Platform', true) | e }}</span>
<span class="fbs" role="group" aria-labelledby="fl-pf"><button type="button" class="fb" data-fk="pf" data-fv="" aria-pressed="true">All</button>{% for p in fx.platforms %}<button type="button" class="fb hu{{ p.hue | default(0) }}" data-fk="pf" data-fv="{{ p.key | e }}" aria-pressed="false"><span class="sw" aria-hidden="true"></span>{{ p.name | e }}</button>{% endfor %}</span>
<select class="fsel fsel-pf" data-fk="pf" aria-labelledby="fl-pf"><option value="">All</option>{% for p in fx.platforms %}<option value="{{ p.key | e }}">{{ p.name | e }}</option>{% endfor %}</select>
{%- endif %}
<span class="fbr" aria-hidden="true"></span>
{%- if fx.collections | default([]) %}
<label class="fl" for="fsel-col">Collection</label>
<select class="fsel" id="fsel-col" data-fk="col"><option value="">All</option>{% for c in fx.collections %}<option value="{{ c.key | e }}">{{ c.name | e }}</option>{% endfor %}</select>
{%- endif %}
{%- if fx.cats | default([]) %}
<span class="fl" id="fl-cat">CAT</span>
<span class="fbs fbs-cat" role="group" aria-labelledby="fl-cat"><button type="button" class="fb" data-fk="cat" data-fv="" aria-pressed="true">All</button>{% for k in fx.cats %}<button type="button" class="fb k{{ k.cat }}" data-fk="cat" data-fv="{{ k.key | e }}" aria-pressed="false"><span class="sw2" aria-hidden="true"></span>{{ k.name | e }}</button>{% endfor %}</span>
{%- endif %}
{%- if fx.host | default(false) %}
<label class="fl" for="fhost">{{ fx.h_label | default('Host', true) | e }}</label>
<input class="fsel fhost" id="fhost" type="search" data-fk="h" placeholder="{{ fx.h_placeholder | default("A host's name, or part of it", true) | e }}" autocomplete="off">
{%- endif %}
{%- if fx.note | default('') %}
<p class="fnote">{{ fx.note | e }}</p>
{%- endif %}
</div>
{%- endif %}
{%- endif %}
{%- macro xmini(t) %}
{%- if t.text | default('') %}<p class="xt0">{{ t.text | e }}</p>{% endif %}
{%- if t.rows | default([]) %}
<div class="tw"><table class="mini">
<thead><tr>{% for c in t.columns %}<th class="{{ 'k-num' if t.kinds[loop.index0] | default('') in ['num', 'cat1', 'cat2', 'cat3'] else 'k-mid' }}" scope="col">{{ c | e }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for row in t.rows %}
{%- if loop.index == 101 %}<!--defer-mini {{ loop.length }}-->{% endif %}
{%- set xl = (t.links[loop.index0] if t.links is defined and t.links | length > loop.index0 else '') | default('', true) %}{#- 1.69.2: a second link column (links2, at link2_col: a host's Collection opens the collection) #}{%- set xl2 = (t.links2[loop.index0] if t.links2 is defined and t.links2 | length > loop.index0 else '') | default('', true) %}
{%- set xt = (t.link_titles[loop.index0] if t.link_titles is defined and t.link_titles | length > loop.index0 else '') | default('', true) %}{%- set xt2 = (t.link2_titles[loop.index0] if t.link2_titles is defined and t.link2_titles | length > loop.index0 else '') | default('', true) %}
{%- set gr = (t.row_status[loop.index0] if t.row_status is defined and t.row_status | length > loop.index0 else '') | default('', true) %}
<tr{% if gr in words %} class="r-{{ gr }}"{% endif %}>{% for cell in row %}{% set kd = t.kinds[loop.index0] | default('') %}{% set cu = xl if loop.first else (xl2 if loop.index0 == t.link2_col | default(1) else '') %}{% set ct = xt if loop.first else xt2 %}{% set tx = ('' if cell is none else cell) | string %}<td class="{{ 'k-num' if kd in ['num', 'cat1', 'cat2', 'cat3'] else ('k-wrap' if kd == 'wrap' else 'nw') }}" data-l="{{ t.columns[loop.index0] | e }}">{% if cu %}<a class="hl" href="{{ cu | e }}" target="_blank" rel="noopener" title="{{ ct | e }}">{% endif %}{% if tx in {'CAT I': 1, 'CAT II': 2, 'CAT III': 3} %}<span class="catc k{{ {'CAT I': 1, 'CAT II': 2, 'CAT III': 3}[tx] }}"><i aria-hidden="true"></i>{{ tx }}</span>{% elif kd in ['cat1', 'cat2', 'cat3'] and tx not in ['0', '', '-'] %}<span class="cn"><i class="cq k{{ kd[3] }}" aria-hidden="true"></i>{{ tx | e }}</span>{% elif kd == 'wrap' %}<span class="cv">{% for w in tx.split(' ') %}{{ ' ' if not loop.first else '' }}{% if w.isascii() and w.isalpha() and w | length <= 12 %}{{ w | e }}{% elif w | length <= 16 %}<span class="w">{{ nbw(w) }}</span>{% else %}{{ w | e }}{% endif %}{% endfor %}</span>{% else %}{{ tx | e }}{% endif %}{% if cu %}<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
{%- if t.rows | length > 100 %}<!--/defer-mini-->{% endif %}
</tbody>
</table></div>
{%- endif %}
{%- if t.more | default('') %}<p class="xt0">{{ t.more | e }}</p>{% endif %}
{#- 1.73.0: Copy copies the text's command lines only; a text with no command has no button - one muted line says so #}
{%- if t.texts | default([]) %}<div class="rtx">{% for b in t.texts %}<div class="rtb"><h3 class="rth">{{ b.label | e }}</h3><div class="code{{ '' if b.cmd | default('') else ' nc' }}"><pre>{{ b.text | e }}</pre>{% if b.cmd | default('') %}{% if b.file | default('') %}<span class="rta"><button class="copy" type="button" hidden title="{{ b.title | e }}" data-copy="{{ b.cmd | e }}">{{ b.button | e }}</button><a class="dl" href="site-report-file:{{ b.file | urlencode }}" download>Download {{ b.file | e }}</a></span>{% else %}<button class="copy" type="button" hidden title="{{ b.title | e }}" data-copy="{{ b.cmd | e }}">{{ b.button | e }}</button>{% endif %}{% endif %}</div>{% if not b.cmd | default('') %}<p class="rtn">{{ b.note | default('No command in this text') | e }}</p>{% endif %}</div>{% endfor %}</div>{% endif %}
{#- 1.88.0: the cross-check's opened rule - each host's verdict line, then the four sources side by side #}
{%- if t.who | default([]) %}{% for c in t.who %}<div class="who"><p class="wh">{{ c.host | e }}</p><p class="wv w-{{ c.kind | e }}"><svg viewBox="0 0 16 16" aria-hidden="true">{% if c.kind == 'look' %}<path d="M8 1.6l6.6 11.6H1.4z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 6v3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.4" r=".95" fill="currentColor"/>{% elif c.kind == 'agree' %}<path d="M3.4 8.6l3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>{% else %}<circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5 8h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>{% endif %}</svg><span>{{ c.line | e }}</span></p><div class="wg">{% for col in c.cols %}<div class="wc"><h4>{{ col.title | e }}{% if col.sub | default('') %} <small>({{ col.sub | e }})</small>{% endif %}</h4>{% if col.pre | default([]) %}<pre class="wp">{% for l in col.pre %}<span{% if l.mark %} class="wdl" title="The line ACT named as deciding it"{% endif %}>{{ l.t | e }}</span>{% endfor %}</pre>{% endif %}<p class="wr t-{{ col.tone | e }}">{{ col.word | e }}</p>{% if col.note | default('') %}<p class="wn">{{ col.note | e }}</p>{% endif %}</div>{% endfor %}</div></div>{% endfor %}{% endif %}{% if t.who_more | default('') %}<p class="wmore">{{ t.who_more | e }}</p>{% endif %}
{%- endmacro %}
{#- which sections are short (a card in a row of cards): no Start here, no wide part (runway board, squares, matrix,
    timeline, heat grid, outage line, rows that open, collections, platform tiles, at a glance); a table of 4 columns at most and about 56 characters wide (each column its longest value), 25 rows at most, no links; 12 lines at most, none over 160 characters; a text of
    400 characters at most. A bar list: 2 columns, 2 to 15 rows, the second every row a plain number #}
{%- set narrow = [] %}
{%- set blist = [] %}
{%- for s in secs %}
{%- set cols = s.columns | default([]) %}
{%- set rws = s.rows | default([]) %}
{%- set nk = namespace(ok=true, num=true, mx=0, cs=false, w=0) %}
{%- for k in ['team_view', 'cards', 'board', 'squares', 'matrix', 'timeline', 'heat', 'outage', 'details', 'groups', 'tiles', 'glance', 'cell_links', 'buttons', 'links', 'sparks', 'actions', 'passed', 'causes', 'cause_first'] %}
{%- if s[k] is defined and s[k] %}{% set nk.ok = false %}{% endif %}
{%- endfor %}
{%- if cols | length > 4 or rws | length > 25 %}{% set nk.ok = false %}{% endif %}
{#- a table's width, in characters: each column its longest value or heading word (at most 40) and 4 for its room #}
{%- set nk.w = 0 %}
{%- for c in cols %}
{%- set j = loop.index0 %}
{%- set cw = namespace(m=(c | string).split(' ') | map('length') | max if (c | string).strip() else 0) %}
{%- for row in rws[:25] %}{% set v = ('' if row | length <= j or row[j] is none else row[j]) | string %}{% if v | length > cw.m %}{% set cw.m = v | length %}{% endif %}{% endfor %}
{%- set nk.w = nk.w + [cw.m, 40] | min + 4 %}
{%- endfor %}
{%- if nk.w > 56 %}{% set nk.ok = false %}{% endif %}
{%- if s.kind | default('') in ['by_kind','story','review_chart','noc'] %}{% set nk.ok = false %}{% endif %}
{%- if s.lines | default([]) | length > 12 %}{% set nk.ok = false %}{% endif %}
{%- for l in s.lines | default([]) %}{% if l | string | length > 160 %}{% set nk.ok = false %}{% endif %}{% endfor %}
{%- if s.text | default('') | string | length > 400 %}{% set nk.ok = false %}{% endif %}
{%- for row in rws %}
{%- set v = ('' if row | length < 2 or row[1] is none else row[1]) | string | trim %}
{%- if not v.replace(',', '').replace('.', '', 1).isdigit() %}{% set nk.num = false %}{% elif v.replace(',', '') | float > nk.mx %}{% set nk.mx = v.replace(',', '') | float %}{% endif %}
{%- endfor %}
{%- set nk.cs = false %}
{%- for cs in s.cell_status | default([]) %}{% for x in cs | default([], true) %}{% if x %}{% set nk.cs = true %}{% endif %}{% endfor %}{% endfor %}
{%- set bl = nk.ok and cols | length == 2 and 2 <= rws | length <= 15 and nk.num and not nk.cs and not s.filters | default([]) %}
{%- set _ = narrow.append(nk.ok) %}
{%- set _ = blist.append(nk.mx if bl else none) %}
{%- endfor %}
{#- Start here from the report's own rows (1.69.0b, the user: up to 3 ranked cards on each report with findings): a
    report that gives no cards of its own and is Critical or Warning - its worst rows, Critical before Warning, each
    in the order the report lists them. A STIG report (cat_cells): its CAT I rules, then CAT II (the report lists them
    by hosts open). Each card: the row's first value, one line (the cells that are Critical or Warning, else its
    longest value), Open item (that row) and View details (the row's other values) #}
{%- set auto = [] %}
{%- if st in ['critical', 'warning'] and not (secs | selectattr('cards', 'defined') | selectattr('cards') | list) and not r.dashboard | default({}) and r.teams is not defined %}
{%- set catrep = secs | selectattr('cat_cells', 'defined') | selectattr('cat_cells') | list %}
{%- for s in secs %}
{%- set si = loop.index %}
{%- if s.columns is defined and s.rows | default([]) and s.counted | default(true) and (not catrep or s.cat_cells | default(false)) %}
{%- for row in s.rows %}
{%- set ri = loop.index0 %}
{%- if catrep %}
{%- set cats = row | map('string') | select('in', ['CAT I', 'CAT II']) | list %}
{%- if cats %}{% set _ = auto.append([0 if cats[0] == 'CAT I' else 1, auto | length, si, ri]) %}{% endif %}
{%- else %}
{%- set rs = (s.row_status[ri] if s.row_status is defined and s.row_status | length > ri else '') | default('', true) %}
{%- if rs in ['critical', 'warning'] %}{% set _ = auto.append([0 if rs == 'critical' else 1, auto | length, si, ri]) %}{% endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
<div class="secs">
{%- if auto %}
<section class="sec start auto" id="start" aria-label="Start here">
<div class="sh"><span class="lbl">Start here</span><span class="sp"></span><span class="pill">{{ [auto | length, 3] | min }} of {{ auto | length }} {{ 'finding' if auto | length == 1 else 'findings' }}, worst first</span></div>
<div class="cards">
{%- for c in (auto | sort)[:3] %}
{%- set s = secs[c[2] - 1] %}
{%- set row = s.rows[c[3]] %}
{%- set cst = 'critical' if c[0] == 0 else 'warning' %}
{%- set ks = s.kinds | default([]) %}
{%- set tg = (s.row_tags[c[3]] if s.row_tags is defined and s.row_tags | length > c[3] else {}) | default({}, true) %}
{%- set cs = (s.cell_status[c[3]] if s.cell_status is defined and s.cell_status | length > c[3] else []) | default([], true) %}
{%- set cells = [] %}
{%- for v in row %}{% set j = loop.index0 %}{% set t = ('' if v is none else v) | string | trim %}{% if t and (ks[j] if ks | length > j else '') != 'x' %}{% set _ = cells.append([j, (s.column_titles[j] if s.column_titles is defined and s.column_titles | length > j else s.columns[j] | default('')) | string, t, (cs[j] if cs | length > j else '') | default('', true)]) %}{% endif %}{% endfor %}
{%- set hotc = cells[1:] | selectattr('3', 'in', ['critical', 'warning']) | list %}
<article class="todo c-{{ cst }}">
<div class="row1"><span class="num" aria-hidden="true"></span><span class="lbl">{{ 'Up next' if loop.first else 'Then' }}</span><span class="stc s-{{ cst }}"><span class="d" aria-hidden="true"></span>{{ ('CAT I' if c[0] == 0 else 'CAT II') if catrep else opsword[cst] }}</span></div>
<div class="from">{{ s.title.split(' (')[0] | e }}</div>
<h3>{{ cells[0][2] | e if cells else s.title | e }}</h3>
{%- set lg = namespace(t='') %}
{%- if hotc %}
<p class="next">{% for h in hotc[:3] %}{{ '; ' if not loop.first else '' }}{{ h[1] | e }}: {{ (h[2] | capitalize if h[2].isupper() and not h[2].startswith('CAT ') and not s.keep_case | default(false) else h[2]) | e }}{% endfor %}</p>
{%- elif cells | length > 1 %}
{%- for x in cells[1:] if x[2] | length > lg.t | length and x[2] not in ['CAT I', 'CAT II', 'CAT III'] %}{% set lg.t = x[2] %}{% endfor %}
<p class="next">{{ lg.t | truncate(200) | e }}</p>
{%- endif %}
