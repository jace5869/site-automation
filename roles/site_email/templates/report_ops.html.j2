<div class="tw"><table{% if s.compact | default(false) or s.details is defined %} class="{{ 'cc' if s.compact | default(false) else '' }}{{ ' xt' if s.details is defined else '' }}"{% endif %}{% if s.cell_keys | default(false) %} data-keys="{{ s.cell_keys | tojson | forceescape }}"{% endif %}>
