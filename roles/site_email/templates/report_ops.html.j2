<tr{% if rs in words %} class="r-{{ rs }}"{% endif %}{% if tg.pf | default('') %} data-pf="{{ tg.pf | e }}"{% endif %}{% set tgd = tg.data | default({}) | safe_data %}{% for k in tgd %} data-{{ k | e }}="{{ tgd[k] | e }}"{% endfor %}{% if tg.col | default('') %} data-col="{{ tg.col | e }}"{% endif %} id="{{ tg.id | e if tg.id | default('') else 's' ~ si ~ 'r' ~ ri }}"{% if 'cat' in tg and tg.cat is not none %} data-cat="{{ tg.cat | e }}"{% endif %}{% if tg.h | default('') %} data-h="{{ tg.h | lower | e }}"{% endif %}{% if s.row_filters is defined and s.row_filters | length > ri %}{% for vals in s.row_filters[ri] %} data-f{{ loop.index0 }}="|{{ vals | join('|') | e }}|"{% endfor %}{% endif %}>
