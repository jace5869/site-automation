@media (min-width:1200px){
  .wrap.has-rail{grid-template-columns:clamp(200px,15vw,250px) minmax(0,1fr);gap:0 var(--gap)}
  /* the rail's column runs to the page's end (the room under the report is the report's own), so at the very end the
     rail still sits under the bar */
  .wrap.has-rail{padding-bottom:0}.has-rail>.main{padding-bottom:56px}
  .has-rail>.rail{margin-top:0;top:calc(var(--appbar) + 12px);max-height:calc(100vh - var(--appbar) - 24px);padding:12px 8px;
    background:var(--card);border:1px solid var(--edge);border-radius:14px;box-shadow:var(--shadow)}
  :is(:root:has(#rail-hide:checked),:root[data-rail="hidden"]) .rail .rg{display:none}
}
.rail .lbl{font-size:10.5px}
.rg{margin-top:6px}
.rg>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:8px;
  font-family:var(--lab);font-size:10.5px;font-weight:650;letter-spacing:.1em;text-transform:uppercase;color:var(--label)}
.rg>summary::-webkit-details-marker{display:none}
.rg>summary:hover{background:var(--card-strong)}
.rg>summary:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.rg .rgt{flex:1;min-width:0}.rg .rgn{font-variant-numeric:tabular-nums;color:var(--muted)}
.rg .caret{width:14px;height:14px}.rg:not([open]) .caret{transform:rotate(-90deg)}
/* a status: a dot and its word, small and upper case - colour and word always */
.stc{display:inline-flex;align-items:center;gap:7px;font-family:var(--lab);font-size:11px;font-weight:650;letter-spacing:.1em;text-transform:uppercase;
  line-height:1;padding:5px 9px;border-radius:999px;border:1px solid;white-space:nowrap}
.stc .d,.tile .k .d{width:7px;height:7px;border-radius:50%;background:currentColor;flex:none;display:inline-block}
.pill{display:inline-flex;align-items:center;gap:5px;font-family:var(--lab);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
  color:var(--muted);background:var(--card-strong);border:1px solid var(--edge);border-radius:999px;padding:4px 9px;white-space:nowrap;font-variant-numeric:tabular-nums}
/* the header card: the verdict in one bold line, a short line, the headline number on the right; the strip under it opens (SHOW) */
.hero{padding:0;margin:0 0 var(--gap);overflow:hidden}
.hgrid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px 32px;align-items:center;padding:clamp(18px,2.2vw,28px) clamp(18px,2.4vw,32px)}
.hero h1{margin:14px 0 0;font-family:var(--display);font-size:clamp(1.3rem,.95rem + .95vw,1.75rem);line-height:1.25;letter-spacing:-.018em;font-weight:700;max-width:58ch;text-wrap:balance}
.hero .say{margin:8px 0 0;color:var(--muted);font-size:15px}
.hn{text-align:right;min-width:0;padding-left:28px;border-left:1px solid var(--line)}
.hn .bn{font-family:var(--display);font-size:clamp(40px,2rem + 2.2vw,64px);font-weight:700;line-height:1;letter-spacing:-.04em;font-variant-numeric:tabular-nums;color:var(--ink)}
.hn .bn.long{font-size:clamp(26px,1.2rem + 1.2vw,36px);letter-spacing:-.02em}
.hn .cap{font-family:var(--lab);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--label);margin-top:8px;max-width:28ch;margin-left:auto}
.hstrip{border-top:1px solid var(--line);background:var(--card-strong)}
.hstrip>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:16px;padding:9px clamp(18px,2.4vw,32px);font-size:13px;color:var(--muted)}
.hstrip>summary::-webkit-details-marker{display:none}
.hstrip .ln1{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tog{flex:none;font-family:var(--lab);font-size:11px;font-weight:650;letter-spacing:.12em;color:var(--accent)}
.tog .hd,.hstrip[open] .tog .sh{display:none}.hstrip[open] .tog .hd{display:inline}
.hstrip[open] .ln1{white-space:normal}
.hmore{padding:2px clamp(18px,2.4vw,32px) 14px;display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px 28px;color:var(--muted);font-size:13px}
.hmore .crumb{gap:4px 16px}.hmore .crumb .eyebrow{color:var(--accent)}
.hmore .runs{margin-left:auto}
.hstrip>summary:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
/* the status tiles: four to a row - a dot and its word, a big number, one line of what it means */
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;border:0;margin:0 0 var(--gap)}
.tiles.t1,.tiles.t2{grid-template-columns:repeat(2,minmax(0,1fr))}.tiles.t3,.tiles.t6{grid-template-columns:repeat(3,minmax(0,1fr))}
.tiles.t5,.tiles.t9,.tiles.t10{grid-template-columns:repeat(5,minmax(0,1fr))}
.tile{background:var(--card);border:1px solid var(--edge);border-radius:12px;padding:14px 16px 15px;border-left:1px solid var(--edge);box-shadow:var(--shadow)}
.tile:first-child{border-left:1px solid var(--edge)}
.tile .k{font-family:var(--lab);font-size:11px;font-weight:600;letter-spacing:.1em;color:var(--label);gap:8px}
.tile .v{font-size:clamp(28px,1.4rem + 1vw,38px);font-weight:700;margin-top:10px;letter-spacing:-.03em}
.tile .v.long{font-size:clamp(18px,1.3vw,22px)}
.tile .n{margin-top:6px;font-size:13px}
.tile.hot-critical:before,.tile.hot-warning:before{display:none}
.tile.hot-critical{border-color:var(--critical-bd)}.tile.hot-warning{border-color:var(--warning-bd)}
/* a row of tiles: their names, numbers and lines on the same lines however the names wrap (subgrid where the browser has it) */
@supports (grid-template-rows:subgrid){.tile{display:grid;grid-row:span 3;grid-template-rows:subgrid;row-gap:0;align-content:start}
  .tile .k{align-items:flex-start}.tile .k .d{margin-top:.32em}}
.tile.tc{box-shadow:var(--shadow)}.tile.tc .k .d{color:var(--cat);border-radius:3px}
/* the sections: cards; a run of short ones side by side (2 or 3 to a row; 1 at 900 px and under), a wide one the whole row */
.secs{display:flex;flex-direction:column;gap:var(--gap)}
.row{display:grid;grid-template-columns:repeat(auto-fit,minmax(max(320px,calc((100% - 2 * var(--gap)) / 3)),1fr));gap:var(--gap);align-items:start}
.sec{margin:0;border:1px solid var(--edge);border-top:1px solid var(--edge);background:var(--card);border-radius:var(--r);box-shadow:var(--shadow);min-width:0;scroll-margin-top:0}
.sec>summary{display:block;padding:16px 20px 12px}
.sec>summary .hr{display:flex;align-items:center;gap:8px;min-height:24px}
.sec>summary .hr .sp{flex:1}
.sec>summary h2{display:block;margin:10px 0 0;font-size:clamp(17px,1.2vw,20px);font-weight:700;letter-spacing:-.01em}
.sec>summary:hover h2{color:var(--ink)}
.sec>summary:hover .caret{color:var(--ink)}
.sec:not([open])>summary{padding-bottom:16px}
.body{padding:0 20px 4px}
.body>p{margin:0 0 12px;max-width:100ch;font-size:14px}
.body>p.st{display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.scopy{padding:3px 8px}.scopy .t{display:none}
.sec .tw{border:1px solid var(--line);border-radius:10px;margin-bottom:6px}
/* a wide card's table runs to the card's edges (the room of the card's padding goes to the columns) */
.secs>.sec>.body>.tw{margin-left:-20px;margin-right:-20px;border-radius:0;border-left:0;border-right:0}
.secs>.sec>.body>.tw:last-child{border-bottom:0;margin-bottom:-12px}
.secs>.sec>.body>.tw th:first-child,.secs>.sec>.body>.tw th:last-child,.secs>.sec>.body>.tw tbody tr:last-child td{border-radius:0!important}
.secs>.sec>.body>.tw td:first-child,.secs>.sec>.body>.tw th:first-child button{padding-left:20px}
.secs>.sec>.body>.tw table:is(.f2,.f3,.f4,.fx) td:first-child,.secs>.sec>.body>.tw table:is(.f2,.f3,.f4,.fx) th:first-child button{padding-left:12px}
th{font-family:var(--lab);font-size:10.5px;font-weight:600;letter-spacing:.07em}
/* a number's or a short value's heading whole on one line (10-16 never breaks at its hyphen) until the table must tighten */
.tw th.k-num button,.tw th.k-nw button{white-space:nowrap}.tw table.f2 :is(th.k-num,th.k-nw) button{white-space:normal}
/* a table that must tighten (the fit steps f2 on): its headings in the text face, narrower than the mono */
.tw table.f2 th,.tw table.f3 th{font-family:var(--sans);letter-spacing:.02em}
/* Explore: the section's filter, Columns, CSV and its whole text - a check box the CSS acts on (no script needed) */
.xpc{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.sec .tools2{display:none}
.xpc:checked~.tools2{display:flex}.xpc:checked~p.st{display:block;-webkit-line-clamp:unset;line-clamp:unset}
.cf{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin-top:8px;padding:11px 20px 13px;border-top:1px solid var(--line)}
.cf .src{flex:1;min-width:0;font-family:var(--lab);font-size:11.5px;color:var(--muted);overflow-wrap:anywhere}
.xpl{flex:none;font-size:13px;font-weight:650;color:var(--accent);cursor:pointer;white-space:nowrap;user-select:none}
.xpl:hover{text-decoration:underline;text-underline-offset:3px}
.xpl .c,.sec:has(.xpc:checked) .xpl .o{display:none}.sec:has(.xpc:checked) .xpl .c{display:inline}
.sec:has(.xpc:focus-visible) .xpl{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
/* buttons: the primary solid light blue (a site portal action), the rest outlined */
.btn{background:transparent;border-color:var(--edge)}
.btn.pl,.btn.pri{background:var(--pri);color:var(--pri-ink);border-color:var(--pri);font-weight:650;text-decoration:none}
.btn.pl:hover,.btn.pri:hover{background:var(--pri-hover);border-color:var(--pri-hover)}
/* a bar list: a label, its violet bar, its number right-aligned (a section of two columns, the second numbers) */
ul.lines.blist{max-width:none;margin:0 0 6px}
ul.blist .bh{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(60px,2fr) minmax(4ch,auto);gap:12px;padding:0 0 6px;border:0;
  font-family:var(--lab);font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--label);white-space:normal}
ul.blist li{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(60px,2fr) minmax(4ch,auto);gap:12px;align-items:center;padding:7px 0;white-space:normal}
ul.blist li:before{display:none}
ul.blist .bl{min-width:0;overflow-wrap:anywhere}
ul.blist .bt{display:block;height:8px;border-radius:4px;background:var(--line);overflow:hidden}
ul.blist .bt i{display:block;height:100%;border-radius:4px;background:var(--v1);min-width:2px}
ul.blist .bv{text-align:right;font-variant-numeric:tabular-nums;font-weight:650;white-space:nowrap}
ul.blist .bh .bv{font-weight:600}
/* a percentage: its share in the first violet, the rest in the second (a split bar); a status's own colour when it has one */
.meter{background:var(--v2)}.meter i{background:var(--v1);border-radius:3px 0 0 3px}
.meter.m-critical,.meter.m-warning,.meter.m-ok,.meter.m-info{background:var(--line)}
/* Start here: up to three ranked cards (01 02 03 - Up next), the rest under "every step" */
.sec.start{background:none;border:0;box-shadow:none}
.sec.start>summary{padding:0 2px 12px}
.sec.start .body{padding:0}
.cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--gap)}
.todo{border-radius:var(--r);padding:18px 20px 0;background:var(--card);border:1px solid var(--edge);box-shadow:var(--shadow)}
.todo:before{left:0;right:0;top:0;bottom:auto;width:auto;height:3px}
.todo .row1{gap:10px}
.todo .num:before{font-family:var(--lab);font-size:13px;font-weight:700;letter-spacing:.06em;color:var(--muted)}
.todo .lbl{font-size:10.5px}
.todo .row1 .stc{margin-left:auto}
.todo h3{margin:12px 0 0;font-size:16px;font-weight:700}
.todo .next{margin:8px 0 0;color:var(--muted);font-size:14px}
.start.auto .sh{display:flex;align-items:center;gap:8px;margin:0 2px 12px}.start.auto .sh .sp{flex:1}
.todo .from{margin-top:12px;font-size:12.5px;color:var(--muted)}.todo .from+h3{margin-top:2px}
.kv{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;margin:0;font-size:13px}
.kv dt{color:var(--muted);white-space:nowrap}.kv dd{margin:0;overflow-wrap:break-word;word-break:normal}
/* 1.76.5: an opened card takes the whole row (the others flow after it), its details in columns that read; a long value breaks at \\ / - _ . (the template puts <wbr> there), not in the middle of a word */
.todo:has(.cdx:checked){grid-column:1/-1}
.todo:has(.cdx:checked) .kv{grid-template-columns:repeat(2,minmax(140px,max-content) minmax(0,1fr));column-gap:18px}
@media (max-width:800px){.todo:has(.cdx:checked) .kv{grid-template-columns:auto minmax(0,1fr)}}
.cdx{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.cdd{display:none;margin-top:12px}
.cdx:checked~.cdd{display:block}
.cdd .subj{margin:0}.cdd .meta2{margin-top:4px;font-family:var(--lab);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.cdd .code{padding-top:10px;margin-top:0}
.lnk{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:auto;padding:14px 0 15px}
.todo .lnk{border-top:1px solid var(--line);margin-top:16px}
.lnk a,.lnk label{font-size:13px;font-weight:650;color:var(--accent);text-decoration:none;cursor:pointer;white-space:nowrap}
.lnk a:hover,.lnk label:hover{text-decoration:underline;text-underline-offset:3px}
.lnk label .c,.cdx:checked~.lnk label .o{display:none}.cdx:checked~.lnk label .c{display:inline}
.cdx:focus-visible~.lnk label{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
.allx{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.todo.later{display:none}.allx:checked~.cards .todo.later{display:flex}
.alll{display:inline-block;margin-top:12px;font-size:13px;font-weight:650;color:var(--accent);cursor:pointer}
.alll .c,.allx:checked~.alll .o{display:none}.allx:checked~.alll .c{display:inline}
.allx:focus-visible~.alll{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
.ptile{background:var(--card-strong);border-radius:12px}
.ptile .v{font-size:28px;font-weight:700;letter-spacing:-.02em}
.facets{background:var(--card);border-radius:12px;margin:0 0 var(--gap)}
footer{margin-top:32px}
@media (max-width:1100px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:900px){
  .row{grid-template-columns:minmax(0,1fr)}
  .tiles,.tiles[class*=" t"]{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cards{grid-template-columns:minmax(0,1fr)}
  .hgrid{grid-template-columns:minmax(0,1fr)}
  .hn{text-align:left;padding:14px 0 0;border-left:0;border-top:1px solid var(--line)}.hn .cap{margin-left:0}
  /* the tables get the room: slimmer margins around them */
  .wrap{padding-left:16px;padding-right:16px}.body{padding:0 12px 4px}.secs>.sec>.body>.tw{margin-left:-12px;margin-right:-12px}.secs>.sec>.body>.tw td:first-child,.secs>.sec>.body>.tw th:first-child button{padding-left:12px}.sec>summary{padding:14px 14px 10px}.cf{padding:10px 14px 12px}
}
@media (max-width:640px){
  .tiles{grid-template-columns:repeat(2,minmax(0,1fr))}.tile{padding:12px}.tile:nth-child(n+3){border-top:1px solid var(--edge)}
  .body{padding:0 12px 4px}.sec>summary{padding:14px 12px 10px}.cf{padding:10px 12px 12px}
}
@media (prefers-reduced-motion:no-preference){.hero{animation:rise .5s var(--ease) both}.hero>*{animation:none}}
@media print{
  .hero,.tile,.sec{box-shadow:none!important}.sec{break-inside:auto}
  .hstrip .tog,.cf .xpl,.lnk label,.alll{display:none!important}
  .cdd,.todo.later{display:block!important}.todo.later{display:flex!important}.body>p.st{display:block;-webkit-line-clamp:unset}
  .hstrip::details-content{content-visibility:visible}
}
