{#- The "ops" look - the report website only (report_web_theme: ops), never an email (mail programs draw none of
    this). 1.69.0: the report as an operations console - a header card with what the report found in one bold line,
    one short line under it and its headline number on the right (the details under SHOW); the key figures as status
    tiles (a dot and a word, a big number, a line of what it means); Start here as up to 3 ranked cards (01, 02, 03 -
    Up next), each with Open item and View details; then the sections as cards - a status chip and a count at the top,
    the title, the content, and a footer with where it came from and Explore (the section's filter, Columns, CSV and
    its whole text). Short sections (a list, a small table, a bar list) sit side by side, 2 or 3 to a row on a wide
    screen and 1 at 800 px; a wide table takes the whole row. Tables as in atlas and brief (the same cells, classes and
    script: sort, filter, Columns, CSV, Copy, the fit steps). Light and dark (navy) from one palette, written in hex
    (docs/WEB_REPORTS.md, "The ops look"); the violet pair of the bars checked with the dataviz palette validator in
    both; status colours for status only, always with their word or icon. The system's own fonts, a mono face for the
    small upper-case labels. Input as report_brief.html.j2: _report, _page_logo_cid/_page_logo_size, _page_runs,
    _page_job/_page_template, _email_footer. Every value is escaped. -#}
{%- set r = (_page_report | default(_report)) | report_tidy(false) -%}
{%- set rhead = (_page_report | default(_report)) | report_head -%}
{%- set logo_cid = _page_logo_cid | default(_email_logo_cid | default('')) -%}
{%- set logo_size = _page_logo_size | default(_email_logo_size | default([0, 0])) -%}
{%- set runs = _page_runs | default(_email_runs | default([])) -%}
{%- set job_id = _page_job | default(awx_job_id | default(tower_job_id | default(''))) | string -%}
{%- set job_name = _page_template | default(awx_job_template_name | default(tower_job_template_name | default(''))) | string -%}
{%- set words = {'ok': 'All good', 'warning': 'Needs attention', 'critical': 'Action required', 'info': 'For information', 'unknown': 'Unknown', 'low': 'Worth knowing'} -%}
{%- set chipword = {'ok': 'OK', 'warning': 'Warning', 'critical': 'Critical', 'info': 'Info', 'unknown': 'Unknown', 'low': 'Low'} -%}
{#- a cell whose whole text is one of these words gets its chip (and icon) even without a cell_status -#}
{%- set cellword = {'ok': 'ok', 'passed': 'ok', 'pass': 'ok', 'success': 'ok', 'successful': 'ok', 'healthy': 'ok', 'compliant': 'ok',
                    'valid': 'ok', 'up': 'ok', 'connected': 'ok',
                    'warning': 'warning', 'warn': 'warning', 'at risk': 'warning', 'expiring': 'warning', 'degraded': 'warning',
                    'critical': 'critical', 'failed': 'critical', 'fail': 'critical', 'error': 'critical', 'breached': 'critical',
                    'expired': 'critical', 'down': 'critical', 'unreachable': 'critical', 'not compliant': 'critical',
                    'info': 'info', 'unknown': 'unknown', 'low': 'low'} -%}
{%- set st = r.status | default('info') if r.status | default('info') in words else 'info' -%}
{#- a verdict only where there is one to give: a report that only informs leads with its title -#}
{%- set verdict = st in ['ok', 'warning', 'critical'] -%}
{%- set opsword = {'ok': 'Healthy', 'warning': 'Warning', 'critical': 'Critical', 'info': 'Not rated', 'unknown': 'Unavailable', 'low': 'Low'} -%}
{%- macro icon(k) -%}
{%- if k == 'ok' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M4.7 8.4l2.1 2.1 4.5-4.7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif k == 'warning' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6l6.6 11.6H1.4z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 6v3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.4" r=".95" fill="currentColor"/></svg>
{%- elif k == 'critical' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
{%- elif k == 'low' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M5.2 6.6L8 9.4l2.8-2.8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif k == 'info' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M8 7.2v4.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="8" cy="4.8" r="1" fill="currentColor"/></svg>
{%- else -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M6.2 6.2a1.9 1.9 0 113 1.5c-.8.5-1.2.9-1.2 1.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="11.6" r=".95" fill="currentColor"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- macro copyicons() -%}
<svg class="ic i1" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.2" y="5.2" width="8.6" height="8.6" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.8 3.2V3a1.6 1.6 0 00-1.6-1.6H3.4A1.6 1.6 0 001.8 3v5.8a1.6 1.6 0 001.6 1.6h.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="ic i2" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 8.6l3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro -%}
{#- 1.21.0: a date, a time or an IP address kept whole, at any width (2026-10-20, 18:14, 2026-10-20T18:14Z, 10/20/2026,
    192.0.2.45, 192.0.2.0/24, 192.0.2.5:443; a version with 4 parts too); a value's other words as they are -#}
{%- macro nbw(w) -%}
{%- set c = w.strip('()[],;"\'') -%}
{%- set ip = c.split('/')[0].split(':')[0] -%}
{%- set dg = c.rstrip('%').rstrip('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ').replace(',', '').replace('.', '').lstrip('+-') -%}
{%- if c and ((c[:4].isdigit() and c[4:5] == '-' and c[5:7].isdigit() and c[7:8] == '-')
     or (c.count('/') == 2 and c.replace('/', '').isdigit())
     or (c.count(':') in [1, 2] and c | length <= 12 and c.replace(':', '').replace('.', '').isdigit())
     or (ip.count('.') == 3 and ip.replace('.', '').isdigit())
     or (dg | length > 1 and dg.isdigit() and (c | length - dg | length) <= 4)) -%}
<span class="nb">{{ w | e }}</span>
{%- elif w | length > 12 -%}
<span class="lw">{{ w | e }}</span>
{%- elif w[:1] in ['[', '{'] or w in ['True', 'False'] -%}
{#- 1.28.0: its first character as a character reference - on ansible-core 2.16 a macro's output of exactly True or
    False, or one starting with [ or {, comes back a Python value (keep('True') a bool, keep('[1,2]') a list written
    [1, 2]); the page shows the same text -#}
{{ {'[': '&#91;', '{': '&#123;', 'T': '&#84;', 'F': '&#70;'}[w[:1]] }}{{ w[1:] | e }}
{%- else -%}
{{ w | e }}
{%- endif -%}
{%- endmacro -%}
{%- macro keep(text) -%}
{%- for ln in text.split('\n') -%}{{ '\n' if not loop.first else '' }}{%- for w in ln.split(' ') -%}{{ ' ' if not loop.first else '' }}{{ nbw(w) }}{%- endfor -%}{%- endfor -%}
{%- endmacro -%}
{#- 1.67.0: in a table with the portal's buttons (dots = True) a host name of more than 24 characters breaks after a
    dot (a place for it, never inside a label); any other word as nbw -#}
{%- macro dw(w, dots) -%}
{%- if dots and w | length > 24 and '.' in w.strip('.') and w.split('.')[-1][:1].isalpha() -%}
<span class="lw dw">{{ w.split('.') | map('e') | join('.<wbr>') }}</span>
{%- else -%}
{{ nbw(w) }}
{%- endif -%}
{%- endmacro -%}
{#- a chip: up to 12 characters on one line (sh); a longer one wraps, at a width by its length (2 to 4 lines); a long
    word of it breaks after a _ before anywhere else (ERROR_NO_LOGON_ / SERVERS, 1.24.0c) -#}
{%- macro chip(k, text) -%}
{%- set n = text | string | length -%}
<span class="chip s-{{ k | e }} {{ 'sh' if n <= 12 else ('c2' if n <= 24 else ('c3' if n <= 40 else ('c4' if n <= 60 else 'c5'))) }}">{{ icon(k) }}<span>
{%- for ln in (text | string).split('\n') -%}{{ '\n' if not loop.first else '' }}{%- for w in ln.split(' ') -%}{{ ' ' if not loop.first else '' }}
{%- if w | length > 12 and '_' in w.strip('_') -%}<span class="lw">{{ w.split('_') | map('e') | join('_<wbr>') }}</span>{%- else -%}{{ nbw(w) }}{%- endif -%}
{%- endfor -%}{%- endfor -%}</span></span>
{%- endmacro -%}
{#- a path, address or hash: escaped, with a place to break after each / and \ (no hyphen is added) -#}
{%- macro breakable(text) -%}
{%- for seg in text.split('/') -%}{{ '/<wbr>' if not loop.first else '' }}{%- for part in seg.split('\\') -%}{{ '\\<wbr>' if not loop.first else '' }}{{ keep(part) }}{%- endfor -%}{%- endfor -%}
{%- endmacro -%}
<!DOCTYPE html>
{%- set _motion = report_motion | default('auto') | string | trim | lower %}
<html lang="en"{% if _motion in ['off', 'always'] %} class="motion-{{ _motion }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ rhead.subject | e }}</title>
<script src="site-report.js"></script>
<style>
{#- the palette (roles/site_email/library/site_report_web.py has the same, for the index - tests/test_report_web.py
    checks they match). Light: the page a pale grey-lavender (#eef0f6), white cards, 1px edges (#dde1ea), navy text
    (#14213d). Dark: the page deep navy (#0f1626), cards a step lighter (#141d30), edges #24304a. Links and the primary
    button light blue; the bars violet - the first share #6d28d9 (dark: #7d3df3), the second #9f7aea (dark: #9780e7),
    the pair checked with the dataviz validator against the card in each (light and dark: every check passes). Status:
    red, amber, green, grey (Not rated, Unavailable) and a cyan for Low - each text colour 4.5:1 or better on the card
    and the page. The CAT, platform and sequential steps are brief's, checked again on the navy card. -#}
{%- set light %}
  --ink:#14213d;--spark:#6d28d9;--muted:#4b5672;--label:#33405e;--accent:#1d4ed8;--accent-ink:#ffffff;--accent-soft:rgba(29,78,216,.09);
  --pri:#8ec5ff;--pri-ink:#0f1a33;--pri-hover:#a9d3ff;--v1:#6d28d9;--v2:#9f7aea;
  --bg:#eef0f6;--bg2:#e6e9f1;--glow:transparent;--card:#ffffff;--card-solid:#ffffff;
  --card-strong:#f5f6fa;--th:#f5f6fa;--edge:#dde1ea;--line:#e8ebf2;
  --zebra:#fafbfd;--hover:#f0f4fd;--code:#f3f5f9;--bar:rgba(238,240,246,.88);
  --ok:#137a3a;--ok-bg:rgba(19,122,58,0.09);--ok-bd:rgba(19,122,58,0.25);--warning:#995200;
  --warning-bg:rgba(153,82,0,0.09);--warning-bd:rgba(153,82,0,0.25);--critical:#c0262d;
  --critical-bg:rgba(192,38,45,0.08);--critical-bd:rgba(192,38,45,0.25);--info:#566079;--info-bg:rgba(86,96,121,0.09);
  --info-bd:rgba(86,96,121,0.25);--low:#0b6f8a;--low-bg:rgba(11,111,138,0.09);--low-bd:rgba(11,111,138,0.25);--low-row:rgba(11,111,138,0.045);--unknown:#566079;--unknown-bg:rgba(86,96,121,0.09);--unknown-bd:rgba(86,96,121,0.25);
  --critical-row:rgba(192,38,45,0.04);--warning-row:rgba(153,82,0,0.045);--shadow:0 1px 2px rgba(20,33,61,.05);
  --q1:#e1f0ff;--q2:#9dc1ee;--q3:#5591dd;--q4:#2063b0;--q5:#0e3a6d;--q-edge:rgba(14,58,109,.22);
  --hu0:#7b8490;--hu1:#2a78d6;--hu2:#eb6834;--hu3:#1baf7a;--hu4:#eda100;--hu5:#e87ba4;--hu6:#008300;--hu7:#6250d6;--hu8:#e34948;
  --cat1:#e34948;--cat2:#eda100;--cat3:#6250d6;
  color-scheme:light;
{%- endset %}
{%- set dark %}
  --ink:#e6eaf3;--spark:#9780e7;--muted:#9ba6bd;--label:#b9c2d6;--accent:#8ec5ff;--accent-ink:#0b1220;
  --accent-soft:rgba(142,197,255,.12);--pri:#8ec5ff;--pri-ink:#0b1220;--pri-hover:#a9d3ff;--v1:#7d3df3;--v2:#9780e7;
  --bg:#0f1626;--bg2:#121a2c;--glow:transparent;
  --card:#141d30;--card-solid:#141d30;--card-strong:#18223a;--th:#18223a;
  --edge:#24304a;--line:#1f2a42;--zebra:rgba(255,255,255,.015);--hover:rgba(142,197,255,.06);
  --code:#0f1626;--bar:rgba(15,22,38,.9);--ok:#5fd08a;--ok-bg:rgba(95,208,138,0.1);
  --ok-bd:rgba(95,208,138,0.28);--warning:#f2b84b;--warning-bg:rgba(242,184,75,0.1);
  --warning-bd:rgba(242,184,75,0.28);--critical:#ff8080;--critical-bg:rgba(255,128,128,0.1);
  --critical-bd:rgba(255,128,128,0.3);--info:#a3adc2;--info-bg:rgba(163,173,194,0.1);--info-bd:rgba(163,173,194,0.26);--low:#5ccfe6;--low-bg:rgba(92,207,230,0.1);--low-bd:rgba(92,207,230,0.28);--low-row:rgba(92,207,230,0.05);
  --unknown:#a3adc2;--unknown-bg:rgba(163,173,194,0.1);--unknown-bd:rgba(163,173,194,0.26);
  --critical-row:rgba(255,128,128,0.05);--warning-row:rgba(242,184,75,0.05);--shadow:0 1px 2px rgba(0,0,0,.3);
  --q1:#1d3b61;--q2:#2863ab;--q3:#4f91e2;--q4:#97c1f7;--q5:#dff0ff;--q-edge:rgba(223,240,255,.18);
  --hu0:#8d96a1;--hu1:#3987e5;--hu2:#d95926;--hu3:#199e70;--hu4:#c98500;--hu5:#d55181;--hu6:#0ca30c;--hu7:#9085e9;--hu8:#e66767;
  --cat1:#d63d55;--cat2:#c98500;--cat3:#9085e9;
  color-scheme:dark;
{%- endset %}
:root{ {{- light -}} }
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){ {{- dark -}} }}
:root[data-theme="dark"]{ {{- dark -}} }
/* the switches work without the page's script too (a web server's Content-Security-Policy can block it): radio buttons */
:root:has(#theme-light:checked){ {{- light -}} }
:root:has(#theme-dark:checked){ {{- dark -}} }
/* one family and a mono - Segoe UI, never its Variable cuts: classic Outlook mis-measures a variable font (1.87.2) */
:root{--sans:"Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
  --display:"Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:ui-monospace,"Cascadia Mono","Cascadia Code",Consolas,"SF Mono",Menlo,"DejaVu Sans Mono",monospace;
  --ease:cubic-bezier(.16,1,.3,1);--cy:10px;--cx:14px;--fs:14px;--appbar:72px}
:root[data-density="compact"]{--cy:5px;--cx:10px;--fs:13.5px}
:root:has(#density-compact:checked){--cy:5px;--cx:10px;--fs:13.5px}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{background:var(--bg);scroll-padding-top:calc(var(--appbar) + 16px)}
body{margin:0;color:var(--ink);background:radial-gradient(1100px 560px at 12% -10%,var(--glow),transparent 70%) no-repeat,var(--bg);font:15px/1.55 var(--sans);letter-spacing:-.003em;min-height:100vh;-webkit-font-smoothing:antialiased}
a{color:var(--accent);text-underline-offset:2px}
.mono,code,pre,td.lk,td.k-path{font-family:var(--mono)}
.ic{width:15px;height:15px;flex:none;display:block}
.c-ok{color:var(--ok)}.c-warning{color:var(--warning)}.c-critical{color:var(--critical)}.c-info{color:var(--info)}.c-low{color:var(--low)}.c-unknown{color:var(--unknown)}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px 2px 6px;font-size:12.5px;font-weight:650;line-height:1.5;white-space:nowrap;border:1px solid}
.s-ok{color:var(--ok);background:var(--ok-bg);border-color:var(--ok-bd)}
.s-warning{color:var(--warning);background:var(--warning-bg);border-color:var(--warning-bd)}
.s-critical{color:var(--critical);background:var(--critical-bg);border-color:var(--critical-bd)}
.s-info{color:var(--info);background:var(--info-bg);border-color:var(--info-bd)}.s-low{color:var(--low);background:var(--low-bg);border-color:var(--low-bd)}
.s-unknown{color:var(--unknown);background:var(--unknown-bg);border-color:var(--unknown-bd)}
.card{background:var(--card);border:1px solid var(--edge);border-radius:14px}
/* translucent surfaces: a soft blur behind the cards where the browser has it, solid where it does not (never on the tables) */
@supports (backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px)){.card,.todo{-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.card,.todo{background:var(--card-solid)}}
.wrap{max-width:1760px;margin:0 auto;padding:8px clamp(16px,3vw,48px) 56px}
.lbl,.eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--label)}
/* the bar at the top: the report, its sections, the switches */
.appbar{position:sticky;top:0;z-index:20;background:var(--bar);border-bottom:1px solid var(--edge);
  -webkit-backdrop-filter:saturate(150%) blur(12px);backdrop-filter:saturate(150%) blur(12px)}
.appbar-in{max-width:1760px;margin:0 auto;padding:0 clamp(16px,3vw,48px);min-height:var(--appbar);display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:10px;min-width:0;flex:none;max-width:34%}
.logo{display:block;border-radius:8px;height:auto;max-height:52px;width:auto}
.brand b{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:0}
.nav{position:relative;flex:1;min-width:0;display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;padding:10px 0;mask-image:linear-gradient(90deg,#000 94%,transparent)}
/* 1.76.5: the section chips of the bar show whole or not at all (no clipped fragment): what does not fit wraps under and is cut off */
@media (min-width:1200px){.nav{flex-wrap:wrap;overflow:hidden;align-content:flex-start;max-height:46px;padding:10px 0 0;mask-image:none}}
.nav::-webkit-scrollbar{display:none}
.nav a{flex:none;display:inline-flex;align-items:center;gap:7px;text-decoration:none;color:var(--muted);font-size:13px;font-weight:600;
  border-radius:8px;padding:5px 10px;white-space:nowrap}
.nav a:hover{color:var(--ink);background:var(--card-strong)}
.nav a.on{color:var(--ink);background:var(--accent-soft)}
.nav .n{font-weight:500;color:var(--muted);font-variant-numeric:tabular-nums}
.dot{width:8px;height:8px;border-radius:50%;background:currentColor;flex:none}
.tools{display:flex;gap:8px;align-items:center;flex:none;margin-left:auto}
.btn{font:inherit;font-size:13px;font-weight:600;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:9px;padding:6px 11px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:border-color .15s}
.btn:hover{border-color:var(--accent)}
.seg{display:inline-flex;position:relative;background:var(--card-strong);border:1px solid var(--edge);border-radius:9px;padding:2px;gap:2px}
.seg input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.seg label{font-size:12.5px;font-weight:600;color:var(--muted);border-radius:7px;padding:5px 10px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;user-select:none}
.seg label:hover{color:var(--ink)}
.seg input:checked+label{background:var(--card);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12),inset 0 0 0 1px var(--edge)}
.seg input:focus-visible+label,.btn:focus-visible,summary:focus-visible,th button:focus-visible,.nav a:focus-visible,.rail a:focus-visible,.filter:focus-visible,
.find input:focus-visible,.cols input:focus-visible,.ccopy:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
/* the header: what the report found as a chip, then its title at a reading size - a page to work from, not a poster */
.hero{padding:clamp(20px,2.8vw,36px) 0 clamp(16px,1.8vw,24px);position:relative}
.crumb{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;color:var(--muted);font-size:13px}
.crumb .eyebrow{color:var(--accent)}
.verdict{display:inline-flex;align-items:center;gap:7px;margin:14px 0 0;padding:3px 12px 3px 9px;border:1px solid;border-radius:999px;
  font-size:13.5px;font-weight:700;line-height:1.35}
.verdict.c-ok{background:var(--ok-bg);border-color:var(--ok-bd)}.verdict.c-warning{background:var(--warning-bg);border-color:var(--warning-bd)}
.verdict.c-critical{background:var(--critical-bg);border-color:var(--critical-bd)}
.verdict .ic{width:15px;height:15px}
h1{margin:10px 0 0;font-family:var(--display);font-size:clamp(1.35rem,1rem + .9vw,1.75rem);line-height:1.22;letter-spacing:-.02em;font-weight:650;max-width:60ch;text-wrap:balance}
