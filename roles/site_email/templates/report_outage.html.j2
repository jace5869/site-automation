{#- On the website (the atlas, brief and ops looks: hover_look) a dot carries its events (data-evs: [time, level, what happened,
    object] each), and site-report.js opens them as a list on a click, Enter or Space; an email's chart stays a picture with its tips -#}
{%- set dot_list = hover_look is defined -%}
<div class="review-chart">
<input type="radio" name="tlv" id="tlv-out" class="ibk-r" checked><input type="radio" name="tlv" id="tlv-all" class="ibk-r">
<div class="tl-ctl"><b>Show:</b><label for="tlv-out">Outage only</label><label for="tlv-all">Everything</label>
<span class="tl-key"><i class="obox-demo"></i> the outage window &middot; <i class="ring-demo"></i> in Everything: ringed in red = about the lost datastores, their hosts or VMs &middot; a number = grouped events</span></div>
{% for v in s.views %}
<div class="tl-v v-{{ v.key }}"><div class="tl-grid">
<div class="tl-names"><div class="ln hd">{{ v.range | e }}</div>{% for lane in v.lanes %}<div class="ln">{{ lane.name | e }}<span>{{ lane.count }}</span></div>{% endfor %}</div>
{% set bottom = 40 + 46 * v.lanes | length %}
<svg class="tl-area" width="100%" height="{{ bottom + 26 }}" role="group" aria-label="{{ 'Everything' if v.key == 'all' else 'Outage only' }} event lanes">
{% for tick in v.ticks %}
{% if tick.midnight %}<line class="dayline" x1="{{ tick.x }}%" x2="{{ tick.x }}%" y1="0" y2="{{ bottom }}"/>{% endif %}
<g class="tk{{ ' first' if loop.first else '' }}{{ ' day' if tick.midnight else '' }}{{ ' odd' if loop.index0 % 2 else '' }}" text-anchor="{{ 'start' if tick.x < 4 else 'end' if tick.x > 96 else 'middle' }}">
{% if tick.date %}<text class="tk-date" x="{{ tick.x }}%" y="17">{{ tick.date | e }}</text>{% endif %}<text x="{{ tick.x }}%" y="32">{{ tick.clock }}</text></g>
{% endfor %}
{% set w = v.window %}
{% if w %}
<rect class="obox" x="{{ w.x }}%" y="36" width="{{ [0.3, w.width] | max }}%" height="{{ bottom - 33 }}" rx="5"/>
<text class="window-label" x="{{ w.x }}%" y="{{ bottom + 18 }}" text-anchor="{{ 'end' if w.x > 75 else 'start' }}">{{ w.label | e }}</text>
{% if w.still %}<rect class="obox still" x="{{ w.end }}%" y="36" width="{{ 100 - w.end }}%" height="{{ bottom - 33 }}" rx="5"/>
<text class="window-label" x="99%" y="{{ bottom + 18 }}" text-anchor="end">{{ w.still | e }} still down &#8594;</text>{% endif %}
{% endif %}
{% for lane in v.lanes %}
{% set y = 40 + loop.index0 * 46 %}
<g class="lt-{{ lane.key }}" aria-label="{{ lane.name | e }}"><line class="lane-rule" x2="100%" y1="{{ y }}" y2="{{ y }}"/>
{% for m in lane.marks %}
{% if lane.key == 'noise' %}
<rect class="nb{{ ' rel' if m.rel else '' }}" x="{{ m.x }}%" width="{{ m.width }}%" height="{{ m.height }}" y="{{ y + 40 - m.height }}" tabindex="0" role="img" data-tip="{{ m.tip | e }}" aria-label="{{ m.tip | e }}"/>
{% else %}
<g class="mk lv-{{ m.level }}{{ ' rel' if m.rel else '' }}{{ ' many' if m.count > 1 else '' }}" tabindex="0" role="img" data-tip="{{ m.tip | e }}"{% if dot_list and m.evs | default([]) %} data-evs="{{ m.evs | tojson | forceescape }}"{% endif %} aria-label="{{ m.tip | e }}">
{% if m.rel %}<circle class="ring" cx="{{ m.x }}%" cy="{{ y + 15 }}" r="{{ 11 if m.count > 1 else 9 }}"/>{% endif %}
<circle cx="{{ m.x }}%" cy="{{ y + 15 }}" r="{{ 7 if m.count > 1 else 5 }}"/>
{% if m.count > 1 %}<text class="mc" x="{{ m.x }}%" dx="{{ -10 if m.x > 98 else 8 }}" y="{{ y + 8 }}">{{ m.count }}</text>{% endif %}
{% if m.label %}<text class="ml" x="{{ m.x }}%" y="{{ y + 36 }}" text-anchor="{{ 'end' if m.x > 96 else 'start' if m.x < 4 else 'middle' }}">{{ m.label }}</text>{% endif %}
</g>{% endif %}
{% endfor %}</g>{% endfor %}
</svg></div></div>{% endfor %}
<p class="tl-note">Point at or tab to a mark for its full date, time and zone.{% if dot_list %} Click a mark, or press Enter on it, for the list of its events.{% endif %}</p></div>
