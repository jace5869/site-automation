{#- The "command" look (report_email_theme: command): a dark header with the site's logo
    (report_logo_file) and its line of text (report_email_header_text), the job's last runs as a
    strip of bars (report_history: from AAP), the summary as one row of numbers, then the sections.
    Outlook-safe like report.html.j2: tables for the layout, every style inline, the logo attached to
    the email (cid:), no scripts. Input: _report (see roles/site_email/tasks/main.yml), _email_footer,
    _email_logo_cid ('' = no logo) and _email_logo_size ([width, height]), _email_runs (report_runs; [] = no strip). Every value is escaped. -#}
{%- set r = _report -%}
{#- the web copy (report_web_dest) passes its own _page_logo_cid, _page_logo_size and _page_runs; an email links its web copy (_email_web_url) -#}
{%- set logo_cid = _page_logo_cid | default(_email_logo_cid | default('')) -%}
{%- set logo_size = _page_logo_size | default(_email_logo_size | default([0, 0])) -%}
{%- set colour = {'ok': '#15803d', 'warning': '#b45309', 'critical': '#b91c1c', 'info': '#1d4ed8', 'unknown': '#6b7280'} -%}
{%- set tint = {'ok': '#dcfce7', 'warning': '#fef3c7', 'critical': '#fee2e2', 'info': '#dbeafe', 'unknown': '#f3f4f6'} -%}
{%- set st = r.status | default('info') if r.status | default('info') in colour else 'info' -%}
{%- set navy = '#0b1a2e' -%}
{%- set accent = '#5eead4' -%}
{%- set runs = _page_runs | default(_email_runs | default([])) -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.title | e }}</title>
</head>
<body style="margin:0;padding:0;background:#e9edf3;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#e9edf3;">
<tr><td align="center" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:1000px;background:#ffffff;border:1px solid #c5cedb;font-family:'Segoe UI',Arial,Helvetica,sans-serif;font-size:14px;line-height:1.4;color:#111827;">
<tr><td bgcolor="{{ navy }}" style="background:{{ navy }};padding:16px 20px 10px 20px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{%- if logo_cid %}
<td width="{{ logo_size[0] + 16 }}" valign="middle" style="padding-right:16px;"><img src="cid:{{ logo_cid }}" width="{{ logo_size[0] }}" height="{{ logo_size[1] }}" alt="" style="display:block;border:0;width:{{ logo_size[0] }}px;height:{{ logo_size[1] }}px;"></td>
{%- endif %}
<td valign="middle" style="color:#ffffff;">
<div style="font-size:11px;font-weight:bold;letter-spacing:3px;color:{{ accent }};text-transform:uppercase;">{{ report_email_header_text | default('Site automation report') | e }} &nbsp;<span style="display:inline-block;background:{{ colour[st] }};color:#ffffff;letter-spacing:1px;padding:1px 8px;border-radius:9px;">{{ st | upper }}</span></div>
<div style="font-size:19px;font-weight:bold;color:#ffffff;margin-top:4px;">{{ r.title | e }}</div>
{%- if r.subtitle | default('') %}
<div style="font-size:13px;color:#b6c4d8;margin-top:2px;">{{ r.subtitle | e }}</div>
{%- endif %}
</td></tr></table>
</td></tr>
{%- if runs %}
<tr><td bgcolor="{{ navy }}" style="background:{{ navy }};padding:4px 20px 14px 20px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
<td valign="bottom" style="font-size:10px;letter-spacing:2px;color:#7f93ad;padding-right:12px;white-space:nowrap;">LAST {{ runs | length }} RUN{{ 'S' if runs | length != 1 else '' }}</td>
{%- for b in runs %}
<td valign="bottom" height="40" style="height:40px;padding:0 2px;" title="{{ b.text | e }}">
<table role="presentation" width="10" cellpadding="0" cellspacing="0" border="0"><tr>
<td width="10" height="{{ b.height }}" bgcolor="{{ colour[b.status] | default('#6b7280') }}" title="{{ b.text | e }}" style="width:10px;height:{{ b.height }}px;background:{{ colour[b.status] | default('#6b7280') }};{{ 'border:2px solid #ffffff;' if b.current else '' }}font-size:0;line-height:0;mso-line-height-rule:exactly;">&nbsp;</td>
</tr></table>
</td>
{%- endfor %}
<td valign="bottom" style="font-size:11px;color:#ffffff;padding-left:10px;white-space:nowrap;">this run</td>
</tr></table>
</td></tr>
{%- endif %}
<tr><td bgcolor="{{ accent }}" height="3" style="background:{{ accent }};height:3px;line-height:3px;font-size:0;mso-line-height-rule:exactly;">&nbsp;</td></tr>
{%- if r.summary | default([]) %}
{%- for chunk in r.summary | batch(5) %}
<tr><td style="padding:{{ '14px' if loop.first else '6px' }} 20px 4px 20px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
{%- for t in chunk %}
<td valign="top" style="padding:2px 18px 2px {{ '0' if loop.first else '14px' }};{{ '' if loop.first else 'border-left:1px solid #d6dce6;' }}">
<div style="font-size:10px;letter-spacing:1px;color:#5a6779;text-transform:uppercase;">{{ t.label | e }}</div>
<div style="font-size:24px;font-weight:bold;color:{{ colour[t.status | default('')] | default(navy) }};">{{ t.value | string | e }}</div>
{%- if t.note | default('') %}
<div style="font-size:11px;color:#5a6779;">{{ t.note | e }}</div>
{%- endif %}
</td>
{%- endfor %}
</tr></table>
</td></tr>
{%- endfor %}
{%- endif %}
{%- for s in r.sections | default([]) %}
<tr><td style="padding:14px 20px 4px 20px;">
<div style="font-size:15px;font-weight:bold;color:{{ navy }};border-bottom:1px solid #c5cedb;padding-bottom:4px;"><span style="color:{{ colour[s.status | default('')] | default('#9aa7bb') }};">&#9679;</span> {{ s.title | e }}{% if s.rows is defined %} <span style="font-weight:normal;color:#6b7280;">({{ s.rows | length }})</span>{% endif %}</div>
{%- if s.text | default('') %}
<div style="padding:6px 0;color:#374151;">{{ s.text | e }}</div>
{%- endif %}
{%- if s.cards is defined %}{{ s.cards | report_cards_html(navy, '#4b5563', navy) }}{% endif %}
{%- if s.columns is defined %}
{%- if s.rows | default([]) %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border:1px solid #c5cedb;font-size:13px;margin:4px 0 8px 0;">
<tr>
{%- for c in s.columns %}
<th align="left" style="background:#e8eef5;color:{{ navy }};padding:6px 8px;border:1px solid #c5cedb;font-weight:bold;">{{ c | e }}</th>
{%- endfor %}
</tr>
{%- for row in s.rows %}
{%- set rs = (s.row_status[loop.index0] if s.row_status is defined and s.row_status | length > loop.index0 else '') | default('', true) %}
{%- set cs = (s.cell_status[loop.index0] if s.cell_status is defined and s.cell_status | length > loop.index0 else []) | default([], true) %}
{%- if rs in tint %}
<tr bgcolor="{{ tint[rs] }}" style="background:{{ tint[rs] }};">
{%- else %}
<tr style="background:{{ '#ffffff' if loop.index is odd else '#f6f8fb' }};">
{%- endif %}
{%- for cell in row %}
{%- set cst = cs[loop.index0] if cs | length > loop.index0 else '' %}
{%- if cst and cst in colour %}
<td bgcolor="{{ colour[cst] }}" style="padding:5px 8px;border:1px solid #c5cedb;vertical-align:top;background:{{ colour[cst] }};color:#ffffff;font-weight:bold;">{{ ('' if cell is none else cell) | string | e }}</td>
{%- else %}
<td style="padding:5px 8px;border:1px solid #c5cedb;vertical-align:top;">{{ ('' if cell is none else cell) | string | e }}</td>
{%- endif %}
{%- endfor %}
</tr>
{%- endfor %}
</table>
{%- else %}
<div style="padding:6px 0;color:#6b7280;">None.</div>
{%- endif %}
{%- endif %}
{%- if s.lines | default([]) %}
<ul style="margin:6px 0 8px 0;padding-left:20px;">
{%- for l in s.lines if l | trim %}
<li style="margin:2px 0;">{{ l | e }}</li>
{%- endfor %}
</ul>
{%- endif %}
</td></tr>
{%- endfor %}
<tr><td bgcolor="{{ navy }}" style="background:{{ navy }};color:#b6c4d8;padding:10px 20px;font-size:12px;">
{%- if r.footer | default('') %}{{ r.footer | e }}<br>{% endif %}
{{ _email_footer | e }}{% if _email_web_url | default('') %}<br><a href="{{ _email_web_url | e }}" style="color:inherit;">Open this report in a browser</a>{% endif %}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
