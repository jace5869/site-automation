/* 1.86.0: the report website's motion and team layer (report_pop.js) - the atlas, brief and ops looks and the ticket
   insights' pages. The looks' own tokens first, the insights page's as the fallback. Nothing moves unless report_pop.js
   says the page may (html.pop-move: report_motion, the system's reduced-motion wish); print is always still. */
:root{--pop-ink:var(--ink,var(--fg));--pop-muted:var(--muted);--pop-edge:var(--edge,var(--line));--pop-card:var(--card,var(--surface));
  --pop-ok:var(--ok,var(--good));--pop-warn:var(--warning,var(--warn));--pop-crit:var(--critical,var(--crit));--pop-low:var(--low,var(--muted));
  --pop-acc:var(--accent);--pop-on-acc:var(--accent-ink,var(--on-accent,#fff));--pop-ease:cubic-bezier(.3,.7,.2,1)}
/* reveal: what is below the fold waits, then comes in (once) */
.pop-move .pop-wait{opacity:0;transform:translateY(14px)}
.pop-move .pop-wait.pop-in{opacity:1;transform:none;transition:opacity .55s var(--pop-ease) calc(var(--pop-i,0) * 45ms),transform .55s var(--pop-ease) calc(var(--pop-i,0) * 45ms)}
/* hover lift on tiles and cards */
.pop-move .card.tile,.pop-move .tiles>.tile,.pop-move .pt-card,.pop-move .cz{transition:transform .18s var(--pop-ease),box-shadow .18s var(--pop-ease)}
@media (hover:hover){.pop-move .card.tile:hover,.pop-move .tiles>.tile:hover,.pop-move .pt-tile:hover,.pop-move .cz:hover{transform:translateY(-3px);box-shadow:0 10px 26px -12px rgba(0,0,0,.35)}}
/* a change since the last run shows once its number has counted up */
.pop-move .pt-tile .v .delta{opacity:0;transform:translateY(4px)}
.pop-move .pt-tile .v.pop-done .delta{opacity:1;transform:none;transition:opacity .35s,transform .35s var(--pop-ease)}
/* rows and parts that open */
.pop-move .pop-show{animation:pop-show .38s var(--pop-ease)}
@keyframes pop-show{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@supports (interpolate-size:allow-keywords){
  .pop-move{interpolate-size:allow-keywords}
  .pop-move details::details-content{height:0;overflow:clip;transition:height .35s var(--pop-ease),content-visibility .35s allow-discrete}
  .pop-move details[open]::details-content{height:auto}}
/* the crosshair */
.pop-rel{position:relative}
.pop-x{pointer-events:none;opacity:0}
.pop-xon .pop-x{opacity:1}
.pop-xl{stroke:var(--pop-muted);stroke-width:1;stroke-dasharray:3 3}
.pop-xd{fill:var(--pop-card);stroke:var(--pop-acc);stroke-width:2.5}
.pop-tip{position:absolute;transform:translate(-50%,calc(-100% - 12px));pointer-events:none;white-space:nowrap;font-size:12px;font-weight:600;
  padding:4px 8px;border-radius:7px;background:var(--pop-ink);color:var(--pop-card);box-shadow:0 6px 16px -8px rgba(0,0,0,.5);z-index:5}
/* the slim header: under the page's bar, over the page (it moves nothing); sticky table headings go under it */
.appbar,header.bar{position:sticky}
.pop-mini{position:absolute;left:0;right:0;top:100%;display:flex;align-items:center;gap:12px;min-width:0;padding:7px clamp(14px,2.6vw,40px);
  font-size:13px;background:var(--bar,var(--surface));border-bottom:1px solid var(--pop-edge);box-shadow:0 8px 18px -14px rgba(0,0,0,.45);
  opacity:0;visibility:hidden;transform:translateY(-6px);pointer-events:none}
.pop-mini.on{opacity:1;visibility:visible;transform:none}
.pop-move .pop-mini{transition:opacity .25s,transform .3s var(--pop-ease),visibility .3s}
.pop-mini .pm-t{font-weight:700;white-space:nowrap;color:var(--pop-ink)}
.pop-mini .pm-c .chip{transform:scale(.9);transform-origin:left center}
.pop-mini .pm-k{display:flex;gap:14px;min-width:0;overflow:hidden;white-space:nowrap;color:var(--pop-muted)}
.pop-mini .pm-k i{font-style:normal}
.pop-mini .pm-k b{color:var(--pop-ink);font-variant-numeric:tabular-nums}
.pop-mini .pm-team{font-weight:700;color:var(--pop-acc)}
.pop-mini-on th{top:calc(var(--appbar,0px) + 38px)}
@media (max-width:900px){.pop-mini{display:none}.pop-mini-on th{top:var(--appbar,0px)}}
/* the team picker */
.pop-teams{margin:0 0 18px;scroll-margin-top:calc(var(--appbar,0px) + 50px)}
.pop-team-bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 14px}
.pop-team-bar .pt-lab{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--pop-muted)}
.pop-team{display:inline-flex;flex-wrap:wrap;gap:6px}
.pop-team .pt-b{font:inherit;font-size:13.5px;font-weight:600;padding:6px 14px;border-radius:999px;border:1px solid var(--pop-edge);text-decoration:none;
  background:var(--pop-card);color:var(--pop-ink);cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.pop-team .pt-b[aria-pressed=true],.pop-team .pt-b[aria-current=page]{background:var(--pop-acc);border-color:var(--pop-acc);color:var(--pop-on-acc)}
.pop-team .pt-b:focus-visible{outline:2px solid var(--pop-acc);outline-offset:2px}
.pop-move .pop-team .pt-b{transition:background .2s,color .2s,transform .15s}
.pop-move .pop-team .pt-b:active{transform:scale(.97)}
.pop-team .pt-n{font-weight:500;opacity:.8;font-variant-numeric:tabular-nums}
.pop-team .pt-b.pt-un:not([aria-pressed=true]){border-style:dashed}
.pt-sel{font:inherit;font-size:14px;padding:6px 10px;border-radius:9px;border:1px solid var(--pop-edge);background:var(--pop-card);color:var(--pop-ink);max-width:100%}
.pop-team-bar .pt-map,.pop-team-bar .pt-mine{font-size:12.5px;color:var(--pop-muted)}
.pop-team-bar .pt-mine a{font-weight:700;color:var(--pop-acc)}
.pop-team-bar .pt-sel{display:none}
.pop-team-bar.many .pop-team{display:none}
.pop-team-bar.many .pt-sel{display:inline-block}
@media (max-width:900px){.pop-team-bar .pop-team{display:none}.pop-team-bar .pt-sel{display:inline-block}}
/* the other teams' rows: folded behind one button at the table's end */
tr.pt-other>td{opacity:.6}
tr.pt-fold>td{text-align:center;padding:8px!important}
.pt-fb{font:inherit;font-size:13px;font-weight:600;border:1px dashed var(--pop-edge);background:transparent;color:var(--pop-acc);border-radius:8px;padding:5px 12px;cursor:pointer}
/* the severity chips over a table */
.pt-sev{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.pt-sev button{font:inherit;font-size:12.5px;font-weight:600;padding:4px 12px;border-radius:999px;border:1px solid var(--pop-edge);background:var(--pop-card);color:var(--pop-ink);cursor:pointer}
.pt-sev button[aria-pressed=true]{background:var(--pop-acc);border-color:var(--pop-acc);color:var(--pop-on-acc)}
/* a team's view */
.pop-team-view{margin:0}
.pt-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:0 0 14px}
.pt-card{background:var(--pop-card);border:1px solid var(--pop-edge);border-radius:16px;box-shadow:var(--shadow,none);padding:16px 18px;min-width:0}
.pt-card h3{margin:0 0 10px;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--pop-muted)}
.pt-tile{display:flex;flex-direction:column;gap:2px}
.pt-tile .pt-l{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--pop-muted);display:flex;gap:6px;align-items:center}
.pt-tile .v{font-size:34px;font-weight:750;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--pop-ink);letter-spacing:-.02em}
.pt-tile .v .delta{display:inline-block;font-size:12.5px;font-weight:650;margin-left:6px;vertical-align:middle;white-space:nowrap;letter-spacing:0}
.pt-tile .d{font-size:13px;color:var(--pop-muted)}
.delta.up{color:var(--pop-crit)}.delta.down{color:var(--pop-ok)}.delta.same{color:var(--pop-muted)}
.pt-tile.t-crit .v{color:var(--pop-crit)}.pt-tile.t-warn .v{color:var(--pop-warn)}
.pt-tile.t-zero .v{color:var(--pop-ink)}
.pt-ic{display:inline-grid;place-items:center;width:16px;height:16px;border-radius:50%;font-size:11px;font-weight:800;color:#fff;letter-spacing:0}
.pt-ic.c{background:var(--pop-crit)}.pt-ic.w{background:var(--pop-warn);border-radius:3px}
.pt-ringt{flex-direction:row;align-items:center;gap:14px}
.pt-ringt>div{display:flex;flex-direction:column;gap:2px;min-width:0}
.pt-ring{flex:none}
.pt-ring .trk{fill:none;stroke:var(--line,var(--pop-edge));stroke-width:7}
.pt-ring .arc{fill:none;stroke:var(--pop-ok);stroke-width:7;stroke-linecap:round}
.pop-move .pt-ring .arc{animation:pt-ring 1.1s var(--pop-ease)}
@keyframes pt-ring{from{stroke-dashoffset:100}}
.pt-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr) minmax(0,1fr);gap:14px}
.pt-todo ol{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.pt-todo li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;align-items:start}
.pt-todo li b{font-weight:650}
.pt-todo .mut{color:var(--pop-muted);font-size:13px}
.pt-todo .code{margin-top:6px}
.pt-todo .code>pre{flex:1 1 auto;min-width:0}
.pt-todo .code pre{margin:0;font-size:12.5px;white-space:pre-wrap;overflow-wrap:anywhere}
.pt-none{margin:0;color:var(--pop-ok);font-weight:600}
.sb-row{display:grid;grid-template-columns:minmax(0,110px) minmax(0,1fr);gap:2px 10px;align-items:center;margin:0 0 10px;font-size:13px;opacity:.55}
.sb-row.me,.pop-team-view[data-team=""] .sb-row{opacity:1}
.sb-row.me .sb-n{font-weight:750}
.sb-n{overflow-wrap:anywhere}
.sb-bar{display:flex;gap:2px;height:12px}
.sb-bar i{display:block;height:100%;border-radius:3px}
.pop-move .pop-in .sb-bar i,.pop-move .pop-show .sb-bar i{animation:sb-grow .8s var(--pop-ease) both;transform-origin:left}
@keyframes sb-grow{from{transform:scaleX(0)}}
.sb-v{grid-column:2;color:var(--pop-muted);font-size:12px}
/* critical: hatched as well as red - told from warning without its colour */
.sb-crit{background:repeating-linear-gradient(135deg,var(--pop-crit) 0 5px,color-mix(in srgb,var(--pop-crit) 55%,var(--pop-card)) 5px 7px)}
.sb-warn{background:var(--pop-warn)}.sb-low{background:var(--pop-low)}
.sbw0{width:0%}.sbw5{width:5%}.sbw10{width:10%}.sbw15{width:15%}.sbw20{width:20%}.sbw25{width:25%}.sbw30{width:30%}.sbw35{width:35%}.sbw40{width:40%}.sbw45{width:45%}.sbw50{width:50%}.sbw55{width:55%}.sbw60{width:60%}.sbw65{width:65%}.sbw70{width:70%}.sbw75{width:75%}.sbw80{width:80%}.sbw85{width:85%}.sbw90{width:90%}.sbw95{width:95%}.sbw100{width:100%}
.pt-defs{position:absolute;width:0;height:0;overflow:hidden}
.pop-team[hidden],.pt-sel[hidden]{display:none!important}
.sb-leg{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--pop-muted);margin-top:6px}
.sb-leg i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.pt-runs{display:block;width:100%;max-width:380px;height:auto;overflow:visible}
.pt-runs .pt-base{stroke:var(--line,var(--pop-edge));stroke-width:1}
.pt-runs text{font-size:11px;fill:var(--pop-muted)}
.pt-runs .pt-rv{fill:var(--pop-ink);font-weight:700}
.pt-runs .pt-rd.now{fill:var(--pop-ink);font-weight:700}
.pt-runs .r-c{fill:url(#pt-hatch)}
.pt-runs .r-w{fill:var(--pop-warn)}
.pt-hatch-a{fill:var(--pop-crit)}.pt-hatch-b{stroke:color-mix(in srgb,var(--pop-crit) 55%,var(--pop-card));stroke-width:2}
.pt-one{margin:4px 0 0;font-size:12.5px;color:var(--pop-muted)}
.pt-others{margin:10px 2px 0;font-size:13px;color:var(--pop-muted)}
.pt-kept{margin:14px 0 0}
@media (max-width:1100px){.pt-grid{grid-template-columns:1fr 1fr}.pt-grid>.pt-todo{grid-column:1/3}}
@media (max-width:900px){.pt-tiles{grid-template-columns:1fr 1fr}.pt-grid{grid-template-columns:1fr}.pt-grid>.pt-todo{grid-column:auto}}
@media print{.pop-move .pop-wait{opacity:1!important;transform:none!important}.pop-mini,.pt-fold,.pt-sev,.pop-team-bar{display:none!important}
  .pop-team-view[hidden]{display:none}tr.pt-other,tr[data-team][hidden]{display:table-row!important}.pop *{animation:none!important;transition:none!important}}
.pop-still *{animation-duration:0s!important;transition-duration:0s!important}
