{#- 1.63.0: the matrix's CSS (report_matrix.html.j2), in the atlas and brief looks' <style>. The cells take the look's
    status tokens (.s-ok, .s-low ... : their text on their tint is 4.5:1 or better in both themes), so light and dark
    follow the look. Fixed columns that share the width, never cut: up to 12 columns fit 800 px (dense: the icon over
    the age); more sites are a list (ad_repl_filters FIT_COLS). -#}
.rm-legend{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;color:var(--muted);font-size:13px;margin:16px 0 12px}
.rm-legend span{display:inline-flex;align-items:center;gap:6px}
.rm-legend .chip{font-size:12px}
.rm-dot,.rm-mk{font-style:normal;font-weight:700;color:var(--muted)}
.rm-wrap{position:relative;max-width:100%;overflow-x:auto}
table.rm{table-layout:fixed;width:100%;border-collapse:separate;border-spacing:4px;font-size:13px;margin:0 -4px}
table.rm col.rm-cn{width:18%}
table.rm th,table.rm td{position:static;background:none;border:0;padding:0;text-transform:none;letter-spacing:0;white-space:normal;line-height:1.3}
table.rm thead th{font-size:12.5px;font-weight:700;color:var(--ink);text-align:center;padding:2px 2px 6px;overflow-wrap:anywhere;vertical-align:bottom}
table.rm tr.rm-gr th{font-size:11.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:0 2px 2px}
table.rm tr.rm-gr th span{display:block;border-bottom:2px solid var(--line);padding-bottom:4px;overflow-wrap:anywhere}
table.rm th.rm-ax{font-size:11.5px;font-weight:600;color:var(--muted);text-align:left;vertical-align:bottom}
table.rm th.rm-dc{font-weight:700;text-align:left;padding:0 6px 0 4px;overflow-wrap:break-word;vertical-align:middle}
table.rm .rm-k{display:inline-block;min-width:1.6em;color:var(--muted);font-variant-numeric:tabular-nums}
table.rm .rm-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
table.rm tr.rm-band th{text-align:left;font-size:11.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:8px 4px 2px;border-bottom:2px solid var(--line);overflow-wrap:anywhere}
table.rm tbody tr.rm-band:first-child th{padding-top:0}
table.rm td.rm-c{height:38px;border-radius:8px;border:1px solid transparent;text-align:center;vertical-align:middle;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
table.rm td.rm-c .ic{display:inline-block;width:13px;height:13px;vertical-align:-2px;margin-right:4px}
table.rm.rm-dense td.rm-c{font-size:12px;line-height:1.15;padding:3px 0}
table.rm.rm-dense td.rm-c .ic{display:block;width:12px;height:12px;margin:0 auto 2px}
table.rm td.rm-c.s-ok{color:var(--ok);background:var(--ok-bg);border-color:var(--ok-bd)}
table.rm td.rm-c.s-low{color:var(--low);background:var(--low-bg);border-color:var(--low-bd)}
table.rm td.rm-c.s-warning{color:var(--warning);background:var(--warning-bg);border-color:var(--warning-bd)}
table.rm td.rm-c.s-critical{color:var(--critical);background:var(--critical-bg);border-color:var(--critical-bd)}
table.rm td.rm-c.s-unknown{color:var(--unknown);background:var(--unknown-bg);border-color:var(--unknown-bd)}
table.rm td.rm-none{background:var(--card-strong);color:var(--muted)}
table.rm td.rm-none i{font-style:normal;font-weight:700}
table.rm td.rm-self{background:repeating-linear-gradient(135deg,var(--line) 0 2px,transparent 2px 7px),var(--card-strong)}
table.rm td.rm-c[data-tip]:hover,table.rm td.rm-c[data-tip]:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
@media print{table.rm td.rm-c{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
