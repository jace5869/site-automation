{#- 1.139.0: Shared macros for the web report looks (report_atlas.html.j2, report_brief.html.j2, report_ops.html.j2).
    Pure refactor from the three identical copies: icon, copyicons, nbw, keep, dw, chip, breakable, xmini.
    Imported with context so xmini sees words. -#}
{%- macro icon(k) -%}
{%- if k == 'ok' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M4.7 8.4l2.1 2.1 4.5-4.7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif k == 'warning' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6l6.6 11.6H1.4z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 6v3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.4" r=".95" fill="currentColor"/></svg>
{%- elif k == 'critical' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
{%- elif k == 'low' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M5.2 6.6L8 9.4l2.8-2.8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif k == 'info' -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M8 7.2v4.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="8" cy="4.8" r="1" fill="currentColor"/></svg>
{%- else -%}
<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7.3" fill="currentColor" opacity=".2"/><path d="M6.2 6.2a1.9 1.9 0 113 1.5c-.8.5-1.2.9-1.2 1.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="11.6" r=".95" fill="currentColor"/></svg>
{%- endif -%}
{%- endmacro -%}
{%- macro copyicons() -%}
<svg class="ic i1" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.2" y="5.2" width="8.6" height="8.6" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.8 3.2V3a1.6 1.6 0 00-1.6-1.6H3.4A1.6 1.6 0 001.8 3v5.8a1.6 1.6 0 001.6 1.6h.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="ic i2" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 8.6l3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro -%}
{#- 1.21.0: a date, a time or an IP address kept whole, at any width (2026-10-20, 18:14, 2026-10-20T18:14Z, 10/20/2026,
    192.0.2.45, 192.0.2.0/24, 192.0.2.5:443; a version with 4 parts too); a value's other words as they are -#}
{%- macro nbw(w) -%}
{%- set c = w.strip('()[],;"\'') -%}
{%- set ip = c.split('/')[0].split(':')[0] -%}
{%- set dg = c.rstrip('%').rstrip('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ').replace(',', '').replace('.', '').lstrip('+-') -%}
{%- if c and ((c[:4].isdigit() and c[4:5] == '-' and c[5:7].isdigit() and c[7:8] == '-')
     or (c.count('/') == 2 and c.replace('/', '').isdigit())
     or (c.count(':') in [1, 2] and c | length <= 12 and c.replace(':', '').replace('.', '').isdigit())
     or (ip.count('.') == 3 and ip.replace('.', '').isdigit())
     or (dg | length > 1 and dg.isdigit() and (c | length - dg | length) <= 4)) -%}
<span class="nb">{{ w | e }}</span>
{%- elif w | length > 12 -%}
<span class="lw">{{ w | e }}</span>
{%- elif w[:1] in ['[', '{'] or w in ['True', 'False'] -%}
{#- 1.28.0: its first character as a character reference - on ansible-core 2.16 a macro's output of exactly True or
    False, or one starting with [ or {, comes back a Python value (keep('True') a bool, keep('[1,2]') a list written
    [1, 2]); the page shows the same text -#}
{{ {'[': '&#91;', '{': '&#123;', 'T': '&#84;', 'F': '&#70;'}[w[:1]] }}{{ w[1:] | e }}
{%- else -%}
{{ w | e }}
{%- endif -%}
{%- endmacro -%}
{%- macro keep(text) -%}
{%- for ln in text.split('\n') -%}{{ '\n' if not loop.first else '' }}{%- for w in ln.split(' ') -%}{{ ' ' if not loop.first else '' }}{{ nbw(w) }}{%- endfor -%}{%- endfor -%}
{%- endmacro -%}
{#- 1.67.0: in a table with the portal's buttons (dots = True) a host name of more than 24 characters breaks after a
    dot (a place for it, never inside a label); any other word as nbw -#}
{%- macro dw(w, dots) -%}
{%- if dots and w | length > 24 and '.' in w.strip('.') and w.split('.')[-1][:1].isalpha() -%}
<span class="lw dw">{{ w.split('.') | map('e') | join('.<wbr>') }}</span>
{%- else -%}
{{ nbw(w) }}
{%- endif -%}
{%- endmacro -%}
{#- a chip: up to 12 characters on one line (sh); a longer one wraps, at a width by its length (2 to 4 lines); a long
    word of it breaks after a _ before anywhere else (ERROR_NO_LOGON_ / SERVERS, 1.24.0c) -#}
{%- macro chip(k, text) -%}
{%- set n = text | string | length -%}
<span class="chip s-{{ k | e }} {{ 'sh' if n <= 12 else ('c2' if n <= 24 else ('c3' if n <= 40 else ('c4' if n <= 60 else 'c5'))) }}">{{ icon(k) }}<span>
{%- for ln in (text | string).split('\n') -%}{{ '\n' if not loop.first else '' }}{%- for w in ln.split(' ') -%}{{ ' ' if not loop.first else '' }}
{%- if w | length > 12 and '_' in w.strip('_') -%}<span class="lw">{{ w.split('_') | map('e') | join('_<wbr>') }}</span>{%- else -%}{{ nbw(w) }}{%- endif -%}
{%- endfor -%}{%- endfor -%}</span></span>
{%- endmacro -%}
{#- a path, address or hash: escaped, with a place to break after each / and \ (no hyphen is added) -#}
{%- macro breakable(text) -%}
{%- for seg in text.split('/') -%}{{ '/<wbr>' if not loop.first else '' }}{%- for part in seg.split('\\') -%}{{ '\\<wbr>' if not loop.first else '' }}{{ keep(part) }}{%- endfor -%}{%- endfor -%}
{%- endmacro -%}
{%- macro xmini(t) %}
{%- if t.text | default('') %}<p class="xt0">{{ t.text | e }}</p>{% endif %}
{%- if t.rows | default([]) %}
<div class="tw"><table class="mini">
<thead><tr>{% for c in t.columns %}<th class="{{ 'k-num' if t.kinds[loop.index0] | default('') in ['num', 'cat1', 'cat2', 'cat3'] else 'k-mid' }}" scope="col">{{ c | e }}</th>{% endfor %}</tr></thead>
<tbody>
{%- for row in t.rows %}
{%- if loop.index == 101 %}<!--defer-mini {{ loop.length }}-->{% endif %}
{%- set xl = (t.links[loop.index0] if t.links is defined and t.links | length > loop.index0 else '') | default('', true) %}{#- 1.69.2: a second link column (links2, at link2_col: a host's Collection opens the collection) #}{%- set xl2 = (t.links2[loop.index0] if t.links2 is defined and t.links2 | length > loop.index0 else '') | default('', true) %}
{%- set xt = (t.link_titles[loop.index0] if t.link_titles is defined and t.link_titles | length > loop.index0 else '') | default('', true) %}{%- set xt2 = (t.link2_titles[loop.index0] if t.link2_titles is defined and t.link2_titles | length > loop.index0 else '') | default('', true) %}
{%- set gr = (t.row_status[loop.index0] if t.row_status is defined and t.row_status | length > loop.index0 else '') | default('', true) %}
<tr{% if gr in words %} class="r-{{ gr }}"{% endif %}>{% for cell in row %}{% set kd = t.kinds[loop.index0] | default('') %}{% set cu = xl if loop.first else (xl2 if loop.index0 == t.link2_col | default(1) else '') %}{% set ct = xt if loop.first else xt2 %}{% set tx = ('' if cell is none else cell) | string %}<td class="{{ 'k-num' if kd in ['num', 'cat1', 'cat2', 'cat3'] else ('k-wrap' if kd == 'wrap' else 'nw') }}" data-l="{{ t.columns[loop.index0] | e }}">{% if cu %}<a class="hl" href="{{ cu | e }}" target="_blank" rel="noopener" title="{{ ct | e }}">{% endif %}{% if tx in {'CAT I': 1, 'CAT II': 2, 'CAT III': 3} %}<span class="catc k{{ {'CAT I': 1, 'CAT II': 2, 'CAT III': 3}[tx] }}"><i aria-hidden="true"></i>{{ tx }}</span>{% elif kd in ['cat1', 'cat2', 'cat3'] and tx not in ['0', '', '-'] %}<span class="cn"><i class="cq k{{ kd[3] }}" aria-hidden="true"></i>{{ tx | e }}</span>{% elif kd == 'wrap' %}<span class="cv">{% for w in tx.split(' ') %}{{ ' ' if not loop.first else '' }}{% if w.isascii() and w.isalpha() and w | length <= 12 %}{{ w | e }}{% elif w | length <= 16 %}<span class="w">{{ nbw(w) }}</span>{% else %}{{ w | e }}{% endif %}{% endfor %}</span>{% else %}{{ tx | e }}{% endif %}{% if cu %}<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5H3.5v9h9v-3M9.5 2.5h4v4M13.2 2.8 7.5 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
{%- if t.rows | length > 100 %}<!--/defer-mini-->{% endif %}
</tbody>
</table></div>
{%- endif %}
{%- if t.more | default('') %}<p class="xt0">{{ t.more | e }}</p>{% endif %}
{#- 1.73.0: Copy copies the text's command lines only; a text with no command has no button - one muted line says so #}
{%- if t.texts | default([]) %}<div class="rtx">{% for b in t.texts %}{% if has_servers | default(false) and b.label | default('') == 'Fix text' %}<p class="srv-fix"><b>What to do:</b> {{ b.text | e }}</p>{% else %}<div class="rtb"><h3 class="rth">{{ b.label | e }}</h3><div class="code{{ '' if b.cmd | default('') else ' nc' }}"><pre>{{ b.text | e }}</pre>{% if b.cmd | default('') %}{% if b.file | default('') %}<span class="rta"><button class="copy" type="button" hidden title="{{ b.title | e }}" data-copy="{{ b.cmd | e }}">{{ b.button | e }}</button><a class="dl" href="site-report-file:{{ b.file | urlencode }}" download>Download {{ b.file | e }}</a></span>{% else %}<button class="copy" type="button" hidden title="{{ b.title | e }}" data-copy="{{ b.cmd | e }}">{{ b.button | e }}</button>{% endif %}{% endif %}</div>{% if not b.cmd | default('') %}<p class="rtn">{{ b.note | default('No command in this text') | e }}</p>{% endif %}</div>{% endif %}{% endfor %}</div>{% endif %}
{#- 1.88.0: the cross-check's opened rule - each host's verdict line, then the four sources side by side #}
{%- if t.who | default([]) %}{% for c in t.who %}<div class="who"><p class="wh">{{ c.host | e }}</p><p class="wv w-{{ c.kind | e }}"><svg viewBox="0 0 16 16" aria-hidden="true">{% if c.kind == 'look' %}<path d="M8 1.6l6.6 11.6H1.4z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8 6v3.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="11.4" r=".95" fill="currentColor"/>{% elif c.kind == 'agree' %}<path d="M3.4 8.6l3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>{% else %}<circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5 8h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>{% endif %}</svg><span>{{ c.line | e }}</span></p><div class="wg">{% for col in c.cols %}<div class="wc"><h4>{{ col.title | e }}{% if col.sub | default('') %} <small>({{ col.sub | e }})</small>{% endif %}</h4>{% if col.pre | default([]) %}<pre class="wp">{% for l in col.pre %}<span{% if l.mark %} class="wdl" title="The line ACT named as deciding it"{% endif %}>{{ l.t | e }}</span>{% endfor %}</pre>{% endif %}<p class="wr t-{{ col.tone | e }}">{{ col.word | e }}</p>{% if col.note | default('') %}<p class="wn">{{ col.note | e }}</p>{% endif %}</div>{% endfor %}</div></div>{% endfor %}{% endif %}{% if t.who_more | default('') %}<p class="wmore">{{ t.who_more | e }}</p>{% endif %}
{%- endmacro %}

{%- macro section_count(s, has_servers) -%}
{%- set count = namespace(value=0) -%}
{%- for key in (['rows', 'servers', 'rollup_hosts', 'cards', 'passed', 'groups', 'causes', 'issues', 'glance', 'tiles', 'lines'] if has_servers else ['rows']) -%}
{%- if not count.value and s[key] | default([]) -%}{%- set count.value = s[key] | length -%}{%- endif -%}
{%- endfor -%}
{{ count.value or (r.teams.hosts | default({}) | length if has_servers and s.team_view | default(false) and r.teams is defined else 0) }}
{%- endmacro -%}
