# VMware ask - the lines to add to your reverse proxy's nginx (STIG Manager's), written by roles/vmware_ask_stack: it
# never changes your nginx. Paste them INSIDE its server { } block - the one with listen 443 ssl and
# ssl_verify_client (on or optional) - above its location /. Then, with the nginx container's name:
#   sudo podman exec <nginx> nginx -t    && sudo podman exec <nginx> nginx -s reload
# (docs/VMWARE_ASK.md, "Add /ask/ to your nginx"). Nothing else in that block changes: STIG Manager stays as it is.
#
# The service is looked up when a request comes (the resolver and the variable below), not when nginx starts: nginx
# starts, and STIG Manager works, while the service is down - /ask/ then answers 502 alone.
# Who asks is the client certificate this nginx verified: the two X-SSL-Client headers are set here on every request,
# over anything the browser sent, and the service refuses a request without SUCCESS.
location = {{ vmware_ask_path | regex_replace('/$', '') }} {
    absolute_redirect off;
    return 301 {{ vmware_ask_path }};
}
location {{ vmware_ask_path }} {
    resolver {{ _ask_resolvers | join(' ') }} valid=30s ipv6=off;   # the podman network {{ vmware_ask_network }}'s DNS
    set $vmware_ask_app http://vmware-ask-app:8080;
    rewrite ^{{ vmware_ask_path }}(.*)$ /$1 break;
    proxy_pass $vmware_ask_app;
    proxy_http_version 1.1;
    proxy_set_header Host                $host;
    proxy_set_header X-Real-IP           $remote_addr;
    proxy_set_header X-Forwarded-Proto   https;
    proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
    proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;
    proxy_read_timeout 60s;
    client_max_body_size 64k;
}
