# site-automation - install ACT for Windows (generated by roles/win_act for one job run and
# deleted afterwards; it carries act.ps1 inside, base64 encoded).
#   1. win_act_dir: create it, owner Administrators, permissions Administrators and SYSTEM only
#      (nothing inherited from C:\ProgramData or C:\temp, where ordinary users can create files)
#   2. write act.ps1 there, check its SHA256 against the repository's, swap it in, and unblock it
# Needs full PowerShell (like ACT itself). Input: $env:SITE_CHECK_CONFIG = {"dir": "...", "sha256": "..."}.
$ErrorActionPreference = 'Stop'
if ($ExecutionContext.SessionState.LanguageMode -ne 'FullLanguage') {
    throw ('ACT for Windows needs full PowerShell; this server runs PowerShell in ' + $ExecutionContext.SessionState.LanguageMode + ' (WDAC / AppLocker). Sign act.ps1 and allow it in the policy (see ACT''s deployment notes).')
}
$cfg = ConvertFrom-Json -InputObject $env:SITE_CHECK_CONFIG
$dir = [string]$cfg.dir
$want = ([string]$cfg.sha256).ToUpper()
function Invoke-Native([string] $What, [string] $Exe, [string[]] $Arguments) {
    $out = @(& $Exe @Arguments 2>&1 | ForEach-Object { [string]$_ })
    if ($LASTEXITCODE -ne 0) { throw ("$What failed (exit $LASTEXITCODE): " + ($out -join ' ')) }
}
$parent = Split-Path -Path $dir -Parent
if ($parent -and -not (Test-Path -LiteralPath $parent)) { $null = New-Item -ItemType Directory -Path $parent -Force }
if (-not (Test-Path -LiteralPath $dir)) { $null = New-Item -ItemType Directory -Path $dir -Force }
# 1. take it over, whoever created it
Invoke-Native 'takeown' 'takeown.exe' @('/F', $dir, '/A', '/R', '/D', 'Y')
Invoke-Native 'icacls reset' 'icacls.exe' @($dir, '/reset', '/T', '/C', '/Q')
Invoke-Native 'icacls lock down' 'icacls.exe' @($dir, '/inheritance:r', '/grant:r', '*S-1-5-32-544:(OI)(CI)F', '*S-1-5-18:(OI)(CI)F', '/C', '/Q')
# anything already inside only inherits from the folder now
if (@(Get-ChildItem -LiteralPath $dir -Force).Count -gt 0) {
    Invoke-Native 'icacls children' 'icacls.exe' @((Join-Path -Path $dir -ChildPath '*'), '/reset', '/T', '/C', '/Q')
}
# 2. the new act.ps1, checked before it replaces the old one
$newFile = Join-Path -Path $dir -ChildPath 'act.ps1.new'
$b64 = @'
{% for line in _win_act_b64 | regex_findall('.{1,76}') %}
{{ line }}
{% endfor %}
'@
[System.IO.File]::WriteAllBytes($newFile, [System.Convert]::FromBase64String($b64))
$got = (Get-FileHash -LiteralPath $newFile -Algorithm SHA256).Hash.ToUpper()
if ($got -ne $want) {
    Remove-Item -LiteralPath $newFile -Force
    throw "the written act.ps1 has SHA256 $got, expected $want"
}
$final = Join-Path -Path $dir -ChildPath 'act.ps1'
Move-Item -LiteralPath $newFile -Destination $final -Force
# never marked as downloaded from the internet (no Zone.Identifier), so the execution policy
# treats it as a local script
Unblock-File -LiteralPath $final
'###SITE-JSON### ' + (ConvertTo-Json -InputObject @{ installed = $final; sha256 = $got; unblocked = $true } -Compress)
