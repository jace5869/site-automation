location = {{ portal_path | regex_replace('/$', '') }} {
    absolute_redirect off;
    return 301 {{ portal_path }};
}
location {{ portal_path }} {
    resolver {{ _portal_resolvers | join(' ') }} valid=30s ipv6=off;   # the podman network {{ _portal_net_name }}'s DNS
    set $site_portal_app http://site-portal-app:8080;
    rewrite ^{{ portal_path }}(.*)$ /$1 break;
    proxy_pass $site_portal_app;
    proxy_http_version 1.1;
    proxy_set_header Host                $http_host;
    proxy_set_header X-Real-IP           $remote_addr;
    proxy_set_header X-Forwarded-Proto   https;
    proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
    proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;
    proxy_read_timeout 60s;
    client_max_body_size 64k;
}
