/* The site portal's pages, in the look of the report website (report_web_theme: ops, atlas or brief). Made by scripts/gen_portal_css.py
   from this file and the three reports' own palettes (roles/site_email/templates/report_*.html.j2) - do not edit static/portal.css.
   Offline: the system's fonts, no outside file. No inline style: the pages run under style-src 'self'. A status is a mark and a
   word; its colour only repeats them. */
@@TOKENS@@
:root{--sans:"Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
  --display:"Segoe UI Variable Display","Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:ui-monospace,"Cascadia Mono","Cascadia Code",Consolas,"SF Mono",Menlo,"DejaVu Sans Mono",monospace;
  --r:14px;--cy:10px;--cx:14px;--fs:14px;
  --btn:var(--pri,var(--accent));--btn-ink:var(--pri-ink,var(--accent-ink));--btn-hover:var(--pri-hover,var(--accent))}
:root[data-look="atlas"]{--r:16px}
* { box-sizing: border-box; }
html{background:var(--bg)}
body{margin:0;color:var(--ink);font:14.5px/1.55 var(--sans);letter-spacing:-.003em;min-height:100vh;display:flex;flex-direction:column;
  background:radial-gradient(1100px 560px at 12% -10%,var(--glow,var(--glow1,transparent)),transparent 70%) no-repeat,var(--bg);-webkit-font-smoothing:antialiased}
a{color:var(--accent);text-underline-offset:2px}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ic{width:15px;height:15px;flex:none;display:block}
.c-ok{color:var(--ok)}.c-warning{color:var(--warning)}.c-critical{color:var(--critical)}.c-info{color:var(--info)}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px 2px 6px;font-size:12.5px;font-weight:650;line-height:1.5;white-space:nowrap;border:1px solid}
.s-ok{color:var(--ok);background:var(--ok-bg);border-color:var(--ok-bd)}
.s-warning{color:var(--warning);background:var(--warning-bg);border-color:var(--warning-bd)}
.s-critical{color:var(--critical);background:var(--critical-bg);border-color:var(--critical-bd)}
.s-info{color:var(--info);background:var(--info-bg);border-color:var(--info-bd)}
.s-run{color:var(--accent);background:var(--accent-soft);border-color:var(--accent)}
.card{background:var(--card);border:1px solid var(--edge);border-radius:var(--r);box-shadow:var(--shadow)}
/* the reports' banner (report_banner): its colours come from static/banner.css, made from report_banner_color */
.banner{text-align:center;font:700 12px/1.6 var(--mono);letter-spacing:.08em;padding:1px 8px;overflow-wrap:anywhere}
/* the bar: the portal, its pages, who, the colours switch. 1.112.3: clipped at its sides only - the map's toasts under it slide in
   from the right and never widen the page */
.appbar{position:sticky;top:0;z-index:20;overflow-x:clip;background:var(--bar);border-bottom:1px solid var(--edge);-webkit-backdrop-filter:saturate(150%) blur(12px);backdrop-filter:saturate(150%) blur(12px)}
.appbar-in{max-width:1600px;margin:0 auto;padding:0 clamp(16px,2.6vw,40px);min-height:60px;display:flex;flex-wrap:wrap;align-items:center;gap:0 16px}
/* 1.112.3: a logo and a long portal name never wider than the window: the name wraps (portal_title) */
.home{display:flex;align-items:center;gap:10px;flex:none;max-width:100%;text-decoration:none;color:var(--ink);font-size:13.5px;font-weight:700;overflow-wrap:anywhere}
.home .mark{width:28px;height:28px;border-radius:8px;background:var(--btn);color:var(--btn-ink);display:grid;place-items:center;font-weight:800;font-size:13px}
/* 1.112.3: the tabs take the room the name and the switch leave, and wrap to a second row there: the switch never covers a tab
   (Network map and Active Directory on, at 800 px). Less room than 24rem (a logo and a long portal name): the tabs and the switch
   go to a row under the name. 640 px and narrower the tabs have a row of their own */
.nav{flex:1 1 0;min-width:min(100%,24rem);display:flex;flex-wrap:wrap;gap:4px;padding:10px 0}
.nav a{flex:none;display:inline-flex;align-items:center;text-decoration:none;color:var(--muted);font-size:13px;font-weight:600;border-radius:8px;padding:5px 10px;white-space:nowrap}
.nav a:hover{color:var(--ink);background:var(--card-strong)}
.nav a[aria-current="page"]{color:var(--ink);background:var(--accent-soft)}
/* 1.112.3: the user name at most 40 characters wide (a longer one ends in ... - its title has it whole); the switch always whole */
.tools{display:flex;gap:10px;align-items:center;flex:none;max-width:100%;margin-left:auto}
.who{font-family:var(--mono);font-size:12px;color:var(--muted);white-space:nowrap;min-width:0;max-width:40ch;overflow:hidden;text-overflow:ellipsis}
.seg{flex:none;display:inline-flex;background:var(--card-strong);border:1px solid var(--edge);border-radius:9px;padding:2px;gap:2px}
.seg input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
.seg label{font-size:12.5px;font-weight:600;color:var(--muted);border-radius:7px;padding:5px 10px;cursor:pointer;display:inline-flex;align-items:center;user-select:none}
.seg label:hover{color:var(--ink)}
.seg input:checked+label{background:var(--card);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12),inset 0 0 0 1px var(--edge)}
.seg input:focus-visible+label{outline:2px solid var(--accent);outline-offset:2px}
main{flex:1;width:100%;max-width:1600px;margin:0 auto;padding:20px clamp(16px,2.6vw,40px) 56px}
/* the head of a page */
.hero{padding:4px 0 6px}
.crumb{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px;color:var(--muted);font-size:13px;margin:0}
.crumb a{color:var(--muted);text-decoration:none}.crumb a:hover{color:var(--accent)}
.eyebrow,.lbl{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--label)}
.crumb .eyebrow{color:var(--accent)}
h1{margin:8px 0 0;font-family:var(--display);font-size:clamp(1.35rem,1rem + .9vw,1.75rem);line-height:1.22;letter-spacing:-.02em;font-weight:650}
:root[data-look="atlas"] h1{font-weight:750}
.lede{margin:6px 0 0;color:var(--muted);max-width:72ch}
.sub,.empty{color:var(--muted);font-size:13.5px;margin:4px 0}
/* a section: a rule, a title, a count */
.sec{margin-top:clamp(22px,2.4vw,34px);border-top:1px solid var(--edge)}
.sec>h2{margin:0;padding:16px 0 12px;font-family:var(--display);font-size:clamp(17px,1.3vw,20px);font-weight:650;letter-spacing:-.015em;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.sec>h2 .count{font-family:var(--mono);font-size:13px;font-weight:500;color:var(--muted)}
.sec>h2 .note{margin-left:auto;font-family:var(--sans);font-size:12.5px;font-weight:500;color:var(--muted)}
/* the action cards */
.acts{list-style:none;padding:0;margin:0;display:grid;gap:12px;grid-template-columns:repeat(3,minmax(0,1fr))}
.act{padding:14px 16px;display:flex;flex-direction:column;gap:6px;min-width:0;text-decoration:none;color:inherit}
a.act:hover{border-color:var(--accent)}
.act .top{display:flex;align-items:flex-start;gap:10px;justify-content:space-between}
.act h3{margin:0;font-family:var(--display);font-size:15.5px;font-weight:650;letter-spacing:-.01em;line-height:1.3;overflow-wrap:anywhere}
a.act h3{color:var(--ink)}
.act p{margin:0;color:var(--muted);font-size:13.5px}
.act .go{margin-top:auto;padding-top:8px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:4px}
.act.off{background:transparent;box-shadow:none;border-style:dashed}
.act.off h3{color:var(--muted)}
.act .offline{display:flex;gap:7px;align-items:flex-start;color:var(--muted);font-size:13px}
.badge{font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:999px;border:1px solid var(--warning-bd);background:var(--warning-bg);color:var(--warning);white-space:nowrap;flex:none}
.badge.off{border-color:var(--edge);background:var(--card-strong);color:var(--muted)}
/* tables, as the report's */
.tw{border:1px solid var(--edge);border-radius:12px;background:var(--card);overflow-x:auto}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:var(--fs)}
th{background:var(--th,var(--card-strong));text-align:left;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label);border-bottom:1px solid var(--edge);padding:10px var(--cx)}
td{padding:var(--cy) var(--cx);border-bottom:1px solid var(--line);vertical-align:middle;overflow-wrap:anywhere}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:var(--hover)}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
td.nw{white-space:nowrap}
td a{font-weight:600;text-decoration:none}td a:hover{text-decoration:underline}
td.mono,.mono{font-family:var(--mono);font-size:13px}
tr.hot-critical td:first-child{box-shadow:inset 3px 0 0 var(--critical)}
tr.hot-warning td:first-child{box-shadow:inset 3px 0 0 var(--warning)}
td .row-btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
/* the key figures: one ruled strip */
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--edge);border-bottom:1px solid var(--edge);margin:14px 0 0}
.tile{padding:14px 20px 16px;border-left:1px solid var(--line);min-width:0}
.tile:first-child{border-left:0}
.tile .k{font-size:11.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--label)}
.tile .v{font-family:var(--display);font-size:clamp(15px,1.1vw,17px);font-weight:650;line-height:1.3;margin-top:6px;overflow-wrap:anywhere;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.tile .n{color:var(--muted);font-size:13px;margin-top:4px;overflow-wrap:anywhere}
.tile .n:empty{display:none}
/* what came of a fix: Fixed, Still there, Not checked */
.res{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.rc{padding:14px 16px;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.rc .n{font-family:var(--display);font-size:30px;font-weight:650;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.03em}
.res.one{grid-template-columns:minmax(0,1fr)}
.rc.ok{box-shadow:inset 0 2px 0 var(--ok),var(--shadow)}.rc.bad{box-shadow:inset 0 2px 0 var(--critical),var(--shadow)}.rc.mid{box-shadow:inset 0 2px 0 var(--info),var(--shadow)}
.rc p{margin:0;color:var(--muted);font-size:13px}
.ba{font-variant-numeric:tabular-nums;color:var(--ink)}
.next{display:flex;align-items:center;gap:10px;margin:12px 0 0;flex-wrap:wrap}
/* the confirm page */
.two{display:grid;grid-template-columns:minmax(0,3fr) minmax(0,2fr);gap:16px;align-items:start;margin-top:18px}
.panel{padding:16px 18px;min-width:0}
.panel h2{margin:0 0 10px;font-size:11.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--label)}
dl.def{margin:0;display:grid;grid-template-columns:minmax(100px,34%) minmax(0,1fr)}
dl.def dt,dl.def dd{margin:0;padding:9px 0;border-top:1px solid var(--line)}
dl.def dt:first-of-type,dl.def dt:first-of-type+dd{border-top:0}
dl.def dt{color:var(--muted);font-size:13px}
dl.def dd{overflow-wrap:anywhere;font-weight:550}
.field{margin:0 0 14px}
.field label{display:block;font-size:11.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--label);margin-bottom:5px}
.field input,.field select,.field textarea{width:100%;font:inherit;font-size:14px;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:9px;padding:8px 11px}
.field textarea{font-family:var(--mono);font-size:13px;resize:vertical}
.field .multi{display:grid;gap:6px}
.field .opt{display:flex;gap:9px;align-items:center;font-size:14px;font-weight:400;letter-spacing:0;text-transform:none;color:var(--ink);margin:0}
.field .opt input{width:auto;flex:none}
.field .hint{margin:0 0 6px;font-size:13px;color:var(--muted)}
/* the host picker (1.78.0): chips, a search box and a list of the inventory's hosts and groups */
.picker select[multiple]{min-height:9em}
.pk-chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 8px;min-height:28px;align-items:center}
.pk-chip{gap:6px;max-width:100%;overflow-wrap:anywhere}
.pk-x{border:0;background:none;color:inherit;font:inherit;line-height:1;cursor:pointer;padding:0 2px;border-radius:5px}
.pk-x:hover,.pk-x:focus-visible{background:var(--edge)}
.field .pk-q{margin:0 0 6px}
.pk-list{list-style:none;margin:0 0 6px;padding:4px;max-height:15em;overflow-y:auto;background:var(--card);border:1px solid var(--edge);border-radius:9px}
.pk-row{display:flex;gap:9px;align-items:center;padding:6px 8px;border-radius:7px;cursor:pointer;font-size:14px}
.pk-row.on{background:var(--edge)}
.pk-row.off{opacity:.55;cursor:not-allowed}
.pk-box{flex:none;display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border:1.5px solid var(--muted);border-radius:4px;font-size:12px;line-height:1}
.pk-row.sel .pk-box{background:var(--ink);color:var(--card);border-color:var(--ink)}
.pk-name{font-family:var(--mono);font-size:13px;overflow-wrap:anywhere;min-width:0;flex:1 1 auto}
.pk-kind{flex:none;font-size:12px;color:var(--muted);white-space:nowrap}
.pk-empty,.pk-foot{padding:6px 8px;margin:0}
.pk-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
/* 1.129.0: the group drop-down, the list's parts (Groups, Hosts, one group's hosts) and the Windows line */
.pk-gbar{display:flex;gap:8px;align-items:center;margin:0 0 6px}
.pk-glab{font-size:13px;color:var(--muted);flex:none}
.field .pk-group{flex:1 1 auto;min-width:0;max-width:100%}
.pk-head{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:8px 8px 4px;font-size:12px;font-weight:600;color:var(--muted);text-transform:none;position:sticky;top:-4px;background:var(--card);z-index:1}
.pk-head .pk-htext{overflow-wrap:anywhere;min-width:0}
.pk-whole{padding:3px 10px;font-size:12.5px}
.pk-os{margin:0 0 10px}
.field.bad input,.field.bad select,.field.bad textarea{border-color:var(--critical)}
.why{color:var(--critical);font-size:12.5px;margin:4px 0 0}
.why:empty{display:none}
.btns{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:18px}
.btn,button{font:inherit;font-size:13.5px;font-weight:600;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:9px;padding:8px 14px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;text-decoration:none}
.btn:hover,button:hover{border-color:var(--accent)}
.btn.pri,button.pri{background:var(--btn);color:var(--btn-ink);border-color:var(--btn);padding:8px 22px}
.btn.pri:hover,button.pri:hover{background:var(--btn-hover);border-color:var(--btn-hover)}
.btn.deny,button.deny{color:var(--critical);border-color:var(--critical-bd)}
button:disabled{opacity:.45;cursor:default}
.state{color:var(--muted);font-size:13px}
.state.bad{color:var(--critical)}
/* a note: said, never lost */
.note{background:var(--card);border:1px solid var(--edge);border-left:4px solid var(--info);border-radius:10px;padding:10px 14px;margin:12px 0;max-width:90ch}
.note.bad{border-left-color:var(--critical);background:var(--critical-bg)}
.note.warn{border-left-color:var(--warning)}
.note.muted{border-left-color:var(--edge);color:var(--muted)}     /* 1.112.3: a usual state, nothing wrong (no AD run yet) */
.note .chip{margin-right:8px}
.muted-line{color:var(--muted);font-size:13px;margin:6px 0 0}
/* the output */
pre.out{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font-family:var(--mono);font-size:12.8px;line-height:1.5;background:var(--code);border:1px solid var(--line);border-radius:12px;padding:12px 14px;max-height:60vh;overflow:auto;color:var(--ink)}
#j-links ul{padding-left:18px;margin:0}
#j-links li{overflow-wrap:anywhere;margin:4px 0}
.status{margin:6px 0 4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.status.bad{color:var(--critical)}
@media (prefers-reduced-motion:no-preference){.chip.s-run .ic{animation:pulse 1.6s ease-in-out infinite}@keyframes pulse{50%{opacity:.35}}}
@media (max-width:1000px){
  .acts{grid-template-columns:repeat(2,minmax(0,1fr))}
  .tiles{grid-template-columns:repeat(2,minmax(0,1fr))}.tile:nth-child(odd){border-left:0}.tile:nth-child(n+3){border-top:1px solid var(--line)}
  .two{grid-template-columns:minmax(0,1fr)}
  .who{display:none}
}
@media (max-width:640px){
  .appbar-in{flex-wrap:wrap;gap:8px;padding:8px 16px}.nav{order:3;flex-basis:100%;padding:0 0 4px}
  .acts,.res{grid-template-columns:minmax(0,1fr)}
  .tiles{grid-template-columns:minmax(0,1fr)}.tile{border-left:0}.tile+.tile{border-top:1px solid var(--line)}
}
/* pick a host, then a finding (1.75.3) */
.steps{list-style:none;display:flex;gap:6px;flex-wrap:wrap;padding:0;margin:14px 0 0;font-size:13px;color:var(--muted)}
.steps li{display:flex;align-items:center;gap:8px;padding:4px 12px 4px 6px;border-radius:999px;border:1px solid var(--edge);background:var(--card)}
.steps li .n{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:700;background:var(--card-strong);color:var(--muted)}
.steps li.on{color:var(--ink);border-color:var(--accent);background:var(--accent-soft)}
.steps li.on .n{background:var(--btn);color:var(--btn-ink)}
.steps li.done .n{background:var(--ok-bg);color:var(--ok)}
.steps li.done{color:var(--ink)}
.hostbox{position:relative;max-width:560px}
.hostbox .row{display:flex;gap:10px;align-items:flex-start}
.hostbox input,.hostbox textarea{flex:1;min-width:0}
.hostbox button{white-space:nowrap}
.suggest{position:absolute;left:0;right:140px;top:100%;margin-top:4px;z-index:5;background:var(--card);border:1px solid var(--edge);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.18);padding:4px;list-style:none;margin-left:0;margin-bottom:0}
.suggest li{padding:7px 10px;border-radius:7px;font-family:var(--mono);font-size:13px}
.suggest li.on{background:var(--accent-soft)}
.suggest b{color:var(--accent)}
.help{color:var(--muted);font-size:12.5px;margin:6px 0 0}
.picks{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.pick{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border:1px solid var(--edge);border-radius:12px;background:var(--card);cursor:pointer}
.pick:hover{border-color:var(--accent)}
.pick input{margin-top:4px;accent-color:var(--accent);flex:none;width:16px;height:16px}
.pick:has(input:checked){border-color:var(--accent);background:var(--accent-soft);box-shadow:inset 3px 0 0 var(--accent)}
.pick.skip:has(input:checked){background:var(--card-strong);box-shadow:none}
.pick .body{min-width:0;flex:1}
.pick .t{display:flex;gap:10px;align-items:baseline;justify-content:space-between;flex-wrap:wrap}
.pick .t b{font-family:var(--display);font-size:15px;font-weight:650;overflow-wrap:anywhere}
.pick .m{color:var(--muted);font-size:13px;margin-top:2px;overflow-wrap:anywhere}
.pick .newest{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ok);font-weight:600}
.looked{margin:14px 0 0}
details.more{margin-top:14px;border:1px solid var(--edge);border-radius:10px;background:var(--card);padding:0}
details.more summary{cursor:pointer;padding:9px 14px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
details.more dl{margin:0;padding:0 14px 10px}
.group{margin-top:22px}
.group>h3{margin:0 0 8px;font-family:var(--mono);font-size:13px;font-weight:600;color:var(--ink);display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pick.skip{border-style:dashed;background:transparent;color:var(--muted)}
.empty-card{padding:18px 20px}
.empty-card h2{margin:0 0 4px;font-family:var(--display);font-size:17px}
textarea.hosts{min-height:84px}

.two.one{margin-top:18px}
.field textarea[name=hosts]{font-family:var(--mono);font-size:13px;min-height:44px}
@media (max-width:1000px){.suggest{right:0}}
@media print{.appbar .seg,.btns,.nav{display:none}pre.out{max-height:none}}
/* 1.78.0: the Actions page (status strip, filter tiles, search, cards), the Run dialog and Details panel, the Jobs page (list and pane) */
.strip{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;justify-content:space-between;padding:10px 16px;margin:0 0 14px}
.strip .l{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:13.5px}
.strip .r{display:flex;gap:10px;align-items:center;color:var(--muted);font-size:13px}
/* 1.78.2: the cards by area, the help under the strip, the site's logo */
.grp{margin-top:clamp(18px,2vw,28px)}
.grp:first-child{margin-top:4px}
.grp[hidden]{display:none}
.grp>h2{cursor:default}.js-on .grp>h2{cursor:pointer}
.grp>h2 .chev{font-size:12px;color:var(--muted);width:14px;display:inline-block}
.grp.folded:not(.peek)>ul{display:none}
.grp.pinned>h2{color:var(--ink)}
.tcard .top .pin{margin-left:auto;border:0;background:none;color:var(--muted);font-size:18px;line-height:1;cursor:pointer;padding:2px 4px;border-radius:6px}
.tcard .top .pin:hover{color:var(--ink);background:var(--card-strong)}
.tcard .top .pin.on{color:var(--warning)}
.tcard.off .top .pin{display:none}
/* 1.78.4: the live badges and toasts, the keyboard list, a locked approval */
.nav .bdg,.appbar .nav a .bdg{display:inline-grid;place-items:center;min-width:18px;height:18px;border-radius:999px;background:var(--accent);color:var(--accent-ink);font:700 11px/1 var(--mono);padding:0 5px;margin-left:6px}
.nav a[href$="approvals"] .bdg{background:var(--warning);color:#fff}
.nav .bdg[hidden],.appbar .nav a .bdg[hidden]{display:none}                     /* 1.87.0: nothing to count - no empty dot */
.toasts{position:fixed;right:20px;bottom:20px;z-index:50;display:grid;gap:10px;width:min(340px,calc(100vw - 40px))}
.toast{background:var(--card-solid);border:1px solid var(--edge);border-left:4px solid var(--ok);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.22);padding:12px 36px 12px 14px;position:relative}
.toast.bad{border-left-color:var(--critical)}
.toast b{display:block;font-size:14px}.toast p{margin:3px 0 6px;font-size:13px;color:var(--muted)}.toast a{font-weight:650;font-size:13px}
.toast .tx{position:absolute;right:6px;top:4px;border:0;background:none;font-size:20px;line-height:1;color:var(--muted);cursor:pointer;padding:2px 6px}
.keys{position:fixed;left:50%;top:90px;transform:translateX(-50%);width:min(420px,calc(100vw - 32px));background:var(--card-solid);border:1px solid var(--edge);border-radius:14px;box-shadow:0 16px 40px rgba(0,0,0,.25);padding:16px 20px;z-index:60}
.keys h3{margin:0 0 8px}.keys dl{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0;font-size:13.5px}.keys dd{margin:0}
.keys kbd{font:600 12px var(--mono);border:1px solid var(--edge);border-bottom-width:2px;border-radius:6px;padding:1px 7px}
tr.locked td{color:var(--muted);background:var(--card-strong)}
tr.locked td b,tr.locked td a{color:var(--ink)}
tr.locked .lockline{display:inline-flex;gap:6px;align-items:flex-start;white-space:normal;color:var(--ink)}
@media print{.toasts,.keys,.bdg{display:none}}
.grp>h2{margin:0;padding:6px 0 12px;font-family:var(--display);font-size:clamp(17px,1.3vw,20px);font-weight:650;letter-spacing:-.015em;display:flex;align-items:baseline;gap:10px}
.grp>h2 .count{font-family:var(--mono);font-size:13px;font-weight:500;color:var(--muted);display:inline-block}
details.hlp{margin:0 0 14px;padding:0}
details.hlp>summary{cursor:pointer;padding:10px 16px;font-size:13.5px;font-weight:600;color:var(--ink)}
details.hlp .whyb{padding:0 16px 12px;font-size:13.5px}
details.hlp ul.hl{margin:0;padding-left:18px}
details.hlp ul.hl ul{margin:4px 0 4px;padding-left:18px}
details.hlp li{margin:3px 0}
details.hlp li.warn{color:var(--warning);font-weight:600}
details.hlp code{font-family:var(--mono);font-size:12.5px}
.home img.logo{display:block;max-height:40px;max-width:160px;width:auto;height:auto}
.ftiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 14px}
.ft{display:block;text-decoration:none;text-align:left;padding:12px 16px;border-radius:12px;border:1px solid var(--edge);background:var(--card);cursor:pointer;font:inherit;color:var(--ink)}
.ft:hover{border-color:var(--accent)}
.ft .k{display:block;font-size:11.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--label)}
.ft .v{display:block;font-family:var(--display);font-size:26px;font-weight:650;line-height:1.2;margin-top:4px}
.ft[aria-current=true]{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.ft.bad .v{color:var(--critical)}
.find{display:flex;gap:10px;align-items:center;margin:0 0 16px}
.find input{flex:1;min-width:0;font:inherit;font-size:14px;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:9px;padding:9px 12px}
.find kbd{font-family:var(--mono);font-size:12px;border:1px solid var(--edge);border-radius:6px;padding:1px 6px;color:var(--muted)}
.find .cnt{color:var(--muted);font-size:13px;white-space:nowrap}
.acts.cols3>li{display:flex}
.acts.cols3>li>.tcard{flex:1}
.tcard{display:flex;flex-direction:column;gap:8px;padding:16px;min-width:0}
.tcard .top{display:flex;gap:12px;justify-content:flex-start;align-items:center}
.tcard h3{margin:0;font-family:var(--display);font-size:16.5px;line-height:1.3;overflow-wrap:anywhere;text-align:left}
.tcard p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.45}
.tcard p.none{font-style:italic}
.tcard .meta{display:flex;gap:6px 10px;flex-wrap:wrap;align-items:center;font-size:12.5px;color:var(--muted)}
.tcard .lab{display:flex;gap:6px;flex-wrap:wrap}
.tcard .lab .tg{font:inherit;font-size:12px;border:1px solid var(--edge);border-radius:999px;padding:1px 9px;color:var(--muted);background:var(--card-strong)}
.ty{font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;border:1px solid var(--edge);border-radius:6px;padding:1px 7px;color:var(--label)}
.tcard .acts2{display:flex;gap:8px;margin-top:auto;padding-top:4px}
.ico{display:inline-flex;width:34px;height:34px;border-radius:10px;align-items:center;justify-content:center;background:var(--accent-soft);color:var(--accent-ink);flex:none}
.ico svg{width:18px;height:18px}
.tcard[hidden],.acts.cols3>li[hidden]{display:none}
/* 1.78.4: what can be started and what cannot look different in every look. Available: a solid accent border and top bar, a filled Run. Off: a neutral grey surface, a dashed
   border, muted ink, a lock chip and its reason on one line, no Run; the accent colour is never used for it. */
.tcard:not(.off){border-color:var(--accent);box-shadow:inset 0 3px 0 var(--accent),var(--shadow)}
.tcard:not(.off) .btn.pri{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.tcard:not(.off) .btn.pri:hover{filter:brightness(.9)}
.tcard.off{background:var(--card-strong);border:1px dashed var(--muted);box-shadow:none;position:relative;overflow:hidden}
/* 1.87.0: an off card is parked at a glance - hatched, an Off tab, the reason in a box with its lock, no Run; an available card has its thick accent edge */
.tcard.off{background:repeating-linear-gradient(135deg,transparent 0 10px,color-mix(in srgb,var(--muted) 7%,transparent) 10px 20px),var(--card-strong)}
.tcard.off::before{content:"Off";position:absolute;top:0;right:0;padding:3px 12px 4px 14px;border-bottom-left-radius:10px;font-size:11px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;background:var(--muted);color:var(--card);pointer-events:none}          /* a corner tab: inside the card (a turned ribbon would overflow it) */
.tcard:not(.off){border-top-width:4px}
.tcard.off h3,.tcard.off p,.tcard.off .meta,.tcard.off .ty{color:var(--muted)}
.tcard.off .ico{background:var(--line);color:var(--muted)}
.tcard.off .btn{background:transparent;color:var(--ink);border-color:var(--muted)}
.tcard.off .badge.off{display:inline-flex;align-items:center;gap:4px;border-style:solid;border-color:var(--muted);background:transparent;color:var(--ink)}
.tcard.off .badge.off svg{width:12px;height:12px}
.tcard.off p.offline{display:flex;gap:6px;align-items:flex-start;font-size:13px;color:var(--ink);background:var(--card);border:1px solid var(--edge);border-radius:8px;padding:6px 9px;margin:2px 0}
.tcard.off p.offline svg{flex:none;width:14px;height:14px;margin-top:2px;opacity:.75}
.tcard.off p.offline span{min-width:0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
dialog.dlg{width:min(640px,calc(100vw - 32px));max-height:calc(100vh - 48px);overflow:auto;background:var(--card-solid);color:var(--ink);border:1px solid var(--edge);border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.4);padding:22px 24px}
/* 1.123.1: a form with a long pick list (NetApp - expand a volume) - the dialog widens to fit, the list never runs past it */
dialog.dlg:has(select.wide){width:min(920px,calc(100vw - 32px))}
dialog.dlg select{max-width:100%}
dialog.dlg select.wide{width:100%}
dialog.dlg::backdrop{background:rgba(10,12,16,.55)}
dialog.dlg h2{margin:0 0 4px;font-family:var(--display);font-size:20px}
dialog.dlg .sub{color:var(--muted);font-size:13.5px;margin:0 0 16px}
.note.info{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border:1px solid var(--info-bd);background:var(--info-bg);border-radius:10px;font-size:13.5px;margin:14px 0 0}
.dlg .btns{justify-content:flex-end}
dialog.drawer{margin:0 0 0 auto;width:min(460px,100vw);height:100vh;max-height:none;border-radius:16px 0 0 16px}
.drawer .hd2{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.drawer h3{margin:14px 0 4px;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
.drawer p{margin:0 0 4px;font-size:14px}
.plain{list-style:none;margin:0;padding:0;display:grid;gap:6px;font-size:14px}
.plain.runs li{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.drawer table.q{width:100%;border-collapse:collapse;font-size:13.5px}
.drawer table.q th,.drawer table.q td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)}
.two-pane{display:grid;grid-template-columns:minmax(300px,380px) minmax(0,1fr);gap:16px;align-items:start}
.jl{padding:14px;display:flex;flex-direction:column;gap:12px}
.seg2{display:inline-flex;border:1px solid var(--edge);border-radius:9px;overflow:hidden;align-self:flex-start}
.seg2 a{padding:6px 14px;color:var(--ink);text-decoration:none;font-size:13.5px;font-weight:600}
.seg2 a.on{background:var(--btn);color:var(--btn-ink)}
.jl .find{margin:0}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chips button{padding:3px 10px;border-radius:999px;font-size:12.5px}
.chips button[aria-pressed=true]{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}
.jrows{list-style:none;margin:0;padding:0;display:grid}
.jrows li{border-top:1px solid var(--line);border-radius:8px}
.jrows li:first-child{border-top:0}
.jrows li[hidden]{display:none}
.jrows li.on{background:var(--accent-soft)}
.jrows a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 8px;color:inherit;text-decoration:none}
.jrows .d{width:10px;height:10px;border-radius:50%;background:var(--muted)}
.jrows .d.ok{background:var(--ok)}.jrows .d.bad{background:var(--critical)}.jrows .d.run{background:var(--info)}.jrows .d.wait{background:var(--warning)}
.jrows .t{font-weight:650;font-size:14px;overflow-wrap:anywhere}
.jrows small{display:block;color:var(--muted);font-size:12.5px;font-weight:400}
.jrows .r{color:var(--muted);font-size:12.5px;text-align:right;white-space:nowrap}
.jd{padding:20px 22px;display:flex;flex-direction:column;gap:16px;min-width:0}
.jd .hd{display:flex;gap:12px;justify-content:space-between;align-items:flex-start;flex-wrap:wrap}
.jd h2{margin:0;font-family:var(--display);font-size:22px;line-height:1.25}
.jd h3{margin:0 0 6px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
.jd .muted-line{margin:4px 0 0}
.banner2{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border:1px solid var(--ok-bd);background:var(--ok-bg);border-radius:10px;font-size:14px}
.banner2.bad{border-color:var(--critical-bd);background:var(--critical-bg)}
.banner2.run{border-color:var(--info-bd);background:var(--info-bg)}
.banner2 svg{margin-top:3px;flex:none;width:16px;height:16px}
.described{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:4px 12px;margin:8px 0 10px;font-size:13px}.described dt{font-weight:650;color:var(--muted)}.described dd{margin:0;overflow-wrap:anywhere}
.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--edge);border-radius:10px}
.facts>div{padding:10px 14px;border-left:1px solid var(--line);border-top:1px solid var(--line);min-width:0}
.facts>div:nth-child(-n+4){border-top:0}
.facts>div:nth-child(4n+1){border-left:0}
.facts>div.wide{grid-column:1/-1;border-left:0}
.facts .k{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--label)}
.facts .v{margin-top:3px;font-size:14px;overflow-wrap:anywhere}
.facts .mono{font-family:var(--mono);font-size:13px}
.btn.sm{padding:1px 8px;font-size:12.5px}
.jd dl{display:grid;grid-template-columns:minmax(120px,200px) minmax(0,1fr);gap:6px 16px;margin:0}
.jd dt{color:var(--muted);font-size:13.5px}.jd dd{margin:0;font-family:var(--mono);font-size:13px;overflow-wrap:anywhere}
.pane-btns{margin:0}
.foot{color:var(--muted);font-size:13px}
.now{display:grid;gap:8px}.now .nl{font-size:16px;font-family:var(--display)}.now .nl .ic{display:inline-block;width:15px;height:15px;vertical-align:-2px;margin-right:6px;color:var(--info)}
progress.pb{width:100%;height:10px;appearance:none;-webkit-appearance:none;border:0;border-radius:999px;background:var(--line);overflow:hidden}
progress.pb::-webkit-progress-bar{background:var(--line);border-radius:999px}
progress.pb::-webkit-progress-value{background:var(--info);border-radius:999px}
progress.pb::-moz-progress-bar{background:var(--info);border-radius:999px}
.hosts{display:flex;gap:8px;flex-wrap:wrap}
.hc{display:inline-flex;gap:6px;align-items:center;border:1px solid var(--edge);border-radius:999px;padding:3px 12px 3px 8px;font-size:13px}
.hc b{font-family:var(--mono);font-weight:600}
.hc.ok{border-color:var(--ok-bd);background:var(--ok-bg)}.hc.bad{border-color:var(--critical-bd);background:var(--critical-bg)}
.hc.run{border-color:var(--info-bd);background:var(--info-bg)}.hc.wait{border-color:var(--warning-bd);background:var(--warning-bg)}
.hc .ic{width:14px;height:14px}
#job-output{display:grid;gap:8px;min-width:0}
#job-output .hd{align-items:center}
#job-output h3,.output-sum,.output-check{margin:0}
.output-check{padding:8px 12px;background:var(--info-bg);border:1px solid var(--info-bd);border-radius:10px}
.output-sum{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 14px}
.output-recap th,.output-recap td{padding:4px 8px;white-space:nowrap}
.output-recap th[scope=row]{background:transparent;font:600 13px var(--mono);letter-spacing:normal;text-transform:none}
.output-recap thead th{text-transform:none;letter-spacing:normal}.output-recap .zero,.om-skipped{color:var(--muted)}
.output-lines{list-style:none;margin:0;padding:6px 10px;background:var(--card-strong);border:1px solid var(--line);border-radius:10px;font-size:13.5px;overflow-wrap:anywhere}
.output-lines>li{padding:2px 6px 2px 22px}
.output-lines .out-play,.output-lines .out-task{padding:5px 0;font-weight:650}
.output-lines .out-task{border-top:1px solid var(--line)}
.output-lines summary{cursor:pointer}
.output-lines details ul{margin:0;padding-left:28px}
.output-marker{white-space:nowrap}.output-lines>li>.output-marker{display:inline-block;min-width:8em}.output-emoji{font-family:"Segoe UI Emoji","Apple Color Emoji","Noto Color Emoji",sans-serif}
.om-ok{color:var(--ok)}.om-changed,.om-check{color:var(--info)}.om-failed{color:var(--critical)}
.om-warning,.om-unreachable{color:var(--warning)}.om-retry{color:var(--low)}
.out-failed{background:var(--critical-bg)}.out-unreachable{background:var(--warning-bg)}
.output-lines .out-failed,.output-lines .out-unreachable{margin:2px 0;border-left:3px solid var(--critical);border-radius:4px}
.output-lines .out-unreachable{border-color:var(--warning)}
.out-failed .output-msg,.out-unreachable .output-msg{display:block;font-family:var(--mono)}
.output-lines pre{white-space:pre-wrap;overflow-wrap:anywhere}
.output-raw{margin:0;padding:10px;overflow:auto;background:var(--code);border:1px solid var(--line);border-radius:8px}
.evs{list-style:none;margin:0;padding:0;display:grid;gap:4px}
.evs .ev{display:flex;gap:10px;align-items:flex-start;font-size:14px;padding:3px 0}
.evs .ev svg{width:16px;height:16px;margin-top:3px;flex:none}
.evs .ev.ok svg{color:var(--ok)}.evs .ev.bad svg{color:var(--critical)}.evs .ev.wait svg{color:var(--warning)}
.evs .ev b{font-family:var(--mono);font-weight:600}
@media (max-width:1000px){.two-pane{grid-template-columns:minmax(0,1fr)}.facts{grid-template-columns:repeat(2,minmax(0,1fr))}.ftiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media print{.jl,.appbar,.pane-btns{display:none}}
/* 1.78.2: what is running turns - the running icon (status chip, host chips, Now line), the jobs list's ring, the progress bar's stripe. Off under reduced motion and in print. */
.jrows .d.run{background:none;border:2px solid var(--info);border-top-color:transparent;box-sizing:border-box}
progress.pb::-webkit-progress-value{background-image:repeating-linear-gradient(45deg,rgba(255,255,255,.22) 0 8px,rgba(255,255,255,0) 8px 16px);background-size:22.63px 22.63px}
progress.pb::-moz-progress-bar{background-image:repeating-linear-gradient(45deg,rgba(255,255,255,.22) 0 8px,rgba(255,255,255,0) 8px 16px);background-size:22.63px 22.63px}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes stripe{to{background-position:22.63px 0}}
@media (prefers-reduced-motion:no-preference){
  .ic-run,.jrows .d.run{animation:spin 1s linear infinite}
  progress.pb::-webkit-progress-value{animation:stripe 1s linear infinite}
  progress.pb::-moz-progress-bar{animation:stripe 1s linear infinite}
}
/* portal_motion (1.78.3): always - animate even when the system asks for less motion; off - never. The class is on <html> (no inline style); print stays still in every mode. */
html.motion-always .ic-run,html.motion-always .jrows .d.run{animation:spin 1s linear infinite}
html.motion-always progress.pb::-webkit-progress-value{animation:stripe 1s linear infinite}
html.motion-always progress.pb::-moz-progress-bar{animation:stripe 1s linear infinite}
html.motion-off .ic-run,html.motion-off .jrows .d.run,html.motion-off .chip.s-run .ic{animation:none}
html.motion-off progress.pb::-webkit-progress-value{animation:none}
html.motion-off progress.pb::-moz-progress-bar{animation:none}
/* 1.79.5: a job that is over never turns - its pane says data-done="1"; a row or a card's last run that is not running has no .d.run / .ic-run (portal.js and the service) */
html .jd[data-done="1"] .ic-run,html.motion-always .jd[data-done="1"] .ic-run{animation:none}
@media print{html .ic-run,html .jrows .d.run{animation:none !important}html progress.pb::-webkit-progress-value{animation:none !important}html progress.pb::-moz-progress-bar{animation:none !important}}
/* 1.87.0: motion. portal-theme.js puts html.moves on before the page is drawn - portal_motion always: yes; off: never; auto: unless the system asks
   for less motion (it follows a change). Everything below that moves needs html.moves, so without scripts nothing here moves (the 1.78.2 rules above
   still turn what runs). What does not move - the ring's fill, a skeleton's shape, the run time - is there for everyone. Print never moves. */
/* the first load: tiles, cards and panes come in one after another; portal.js puts html.settled on after it, so a pane or list swapped in later stays put */
@keyframes up{from{opacity:0;transform:translateY(12px)}}
html.moves:not(.settled) :is(.ftiles>.ft,.acts>li>.tcard,.two-pane>*,.card.strip){animation:up .45s cubic-bezier(.3,.7,.2,1) both}
html.moves:not(.settled) :is(.ftiles>.ft:nth-child(2),.acts>li:nth-child(2)>.tcard,.two-pane>:nth-child(2)){animation-delay:60ms}
html.moves:not(.settled) :is(.ftiles>.ft:nth-child(3),.acts>li:nth-child(3)>.tcard){animation-delay:120ms}
html.moves:not(.settled) :is(.ftiles>.ft:nth-child(4),.acts>li:nth-child(4)>.tcard){animation-delay:180ms}
html.moves:not(.settled) .acts>li:nth-child(n+5)>.tcard{animation-delay:240ms}
/* an available card lifts under the pointer or the keyboard */
html.moves #agrid .tcard{transition:transform .18s cubic-bezier(.3,.7,.2,1),box-shadow .18s cubic-bezier(.3,.7,.2,1)}
html.moves #agrid .tcard:not(.off):is(:hover,:focus-within){transform:translateY(-4px);box-shadow:inset 0 3px 0 var(--accent),0 16px 34px -18px rgba(0,0,0,.45)}
/* counts: portal.js counts them up on the first load, and a count that changes later (a nav badge) bumps */
@keyframes bump{from{transform:scale(.6)}}
html.moves .mv-bump{animation:bump .5s cubic-bezier(.3,1.6,.5,1)}
/* a running job: the list counts its run time (data-t0, UTC); the job's page has a ring - a workflow's steps, or a job's estimate - drawn by the service */
.jrows .d.run{width:14px;height:14px}
.jrows small.mv-el{color:var(--info);font-weight:650;font-variant-numeric:tabular-nums}
.banner2.has-ring{align-items:center}
.banner2 .ring{position:relative;display:inline-grid;place-items:center;flex:none;width:42px;height:42px;margin:-6px 0}
.banner2 .ring svg{position:absolute;inset:0;width:100%;height:100%;margin:0}
.ring .t{fill:none;stroke:color-mix(in srgb,var(--info) 18%,transparent);stroke-width:5}
.ring .a{fill:none;stroke:var(--info);stroke-width:5;stroke-linecap:round}
.ring b{position:relative;font-size:11px;font-variant-numeric:tabular-nums}
html.moves .ring .a{transition:stroke-dashoffset .8s cubic-bezier(.3,.7,.2,1)}
html.moves .ring .a.mv-hold{transition:none}
html.moves .jd[data-done="0"] .ring.run svg{animation:spin 2.4s linear infinite}
/* the Now bar with no estimate: a light sweeps across it */
@keyframes sweep{to{background-position:140% 0,0 0}}
html.moves progress.pb:not([value]){background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--info) 55%,transparent),transparent) -40% 0/40% 100% no-repeat,var(--line);animation:sweep 1.3s cubic-bezier(.45,.05,.55,.95) infinite}
html.moves progress.pb:not([value])::-webkit-progress-bar{background:transparent}
html.moves progress.pb:not([value])::-moz-progress-bar{background:transparent}
/* skeletons: the shape of the next job's pane, or of the cards on Refresh, while the next page loads */
@keyframes shim{to{background-position:-300% 0}}
.skel{display:grid;gap:12px;padding:4px 0}
.jrows li.picked{background:var(--accent-soft)}.jrows:has(li.picked) li.on:not(.picked){background:none}      /* the job picked, while its page loads */
.skel i{display:block;height:14px;border-radius:7px;background:var(--line)}
.skel i.h{height:26px;width:55%}.skel i.s{width:35%}.skel i.b{height:60px}
html.moves .skel i{background:linear-gradient(90deg,var(--line) 0,color-mix(in srgb,var(--line) 40%,var(--card)) 40%,var(--line) 80%) 0 0/300% 100%;animation:shim 1.2s linear infinite}
/* toasts slide in; one that closes by itself shows its time left as a line (8 s: TOAST_MS in portal.js; held while pointed at) */
@keyframes toast-in{from{transform:translateX(110%);opacity:0}}
@keyframes left{to{transform:scaleX(0)}}
.toast{overflow:hidden}
html.moves .toast{animation:toast-in .42s cubic-bezier(.2,1.25,.4,1)}
html.moves .toast.timed::after{content:"";position:absolute;left:0;bottom:0;height:3px;width:100%;background:var(--ok);opacity:.55;transform-origin:left;animation:left 8s linear forwards}
html.moves .toast.held::after{animation-play-state:paused}
/* the Run dialog pops, the Details panel slides in, a <details> opens smoothly (where the browser can) */
@keyframes drawer-in{from{transform:translateX(40px);opacity:0}}
@keyframes pop{from{transform:scale(.94);opacity:0}}
@keyframes fade{from{opacity:0}}
html.moves dialog.drawer[open]{animation:drawer-in .32s cubic-bezier(.3,.7,.2,1)}
html.moves dialog.dlg:not(.drawer)[open]{animation:pop .26s cubic-bezier(.3,1.2,.5,1)}
html.moves dialog[open]::backdrop{animation:fade .3s}
html.moves{interpolate-size:allow-keywords}
html.moves details::details-content{height:0;overflow:clip;transition:height .3s cubic-bezier(.3,.7,.2,1),content-visibility .3s allow-discrete}
html.moves details[open]::details-content{height:auto}
@media print{html.moves *,html.moves *::before,html.moves *::after,html.moves *::backdrop{animation:none !important;transition:none !important}html.moves details::details-content{height:auto}}
/* 1.92.0: a workflow waiting for approval - the decision on the job page (the check's plan, What it will change, Approve / Deny), Plan ready,
   the steps in run order; the Approvals page's rows with the same panel and the reasons; cards at 900 px and below */
.banner2.wait{border-color:var(--warning-bd);background:var(--warning-bg)}
.decide{margin-top:12px;border:1px solid var(--warning-bd);border-left:4px solid var(--warning);border-radius:12px;background:var(--card-strong);padding:14px 16px 16px;display:grid;gap:12px}
.decide .dtop{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline}
.decide .eyebrow2{font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:700;color:var(--label)}
.decide .left{font-size:13px;color:var(--muted)}
details.wic{border:1px solid var(--edge);border-radius:10px;background:var(--card)}
details.wic>summary{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 12px;cursor:pointer;list-style:none;border-radius:10px}
details.wic>summary::-webkit-details-marker{display:none}
details.wic>summary:hover{background:var(--hover)}
details.wic>summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
details.wic .t{font-weight:650}
details.wic .chev{color:var(--muted);flex:none}
details.wic[open] .chev{transform:rotate(90deg)}
details.wic .cnt{display:inline-flex;gap:6px;flex-wrap:wrap}
.chip.n{color:var(--ink);background:transparent;border-color:var(--edge);font-weight:600;padding:2px 10px}
.chip.s-low{color:var(--low);background:var(--low-bg);border-color:var(--low-bd)}
.chip.s-plan{color:var(--accent);background:var(--accent-soft);border-color:var(--accent)}
.wicp{padding:2px 14px 12px}
.wicp .pt{margin:0 0 4px;color:var(--muted);font-size:13px}
.wicp .hg{padding:8px 0;border-bottom:1px dashed var(--line)}
.wicp .hg:last-of-type{border-bottom:0}
.wicp .hn{font-family:var(--mono);font-weight:650;font-size:13px;margin-bottom:6px;overflow-wrap:anywhere}
.wicp ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.wicp li{display:grid;grid-template-columns:92px minmax(0,1fr);gap:10px;align-items:start;font-size:14px}
.wicp li .chip{justify-self:start}
.wicp li>span:last-child{overflow-wrap:anywhere}
.wicp .more{color:var(--muted);font-size:13px;margin:6px 0 0}
.dbtns{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.dbtns .sp{flex:1}
.dbtns .log{font-size:12.5px;color:var(--muted);flex-basis:100%}
.dwhy{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:10px;background:var(--bg2);border:1px solid var(--edge);font-size:14px;color:var(--ink);white-space:normal}
.dwhy b{color:var(--ink)}
.dwhy svg{flex:none;margin-top:3px;width:16px;height:16px;color:var(--muted)}
.dwhy code,.decide code{font-family:var(--mono);font-size:12.5px;background:var(--code);padding:1px 5px;border-radius:5px}
td.ord{font-family:var(--mono);color:var(--muted);width:28px}
.jd td.ord+td+td{white-space:nowrap}
tr.now-row td{background:var(--warning-row)}
.apw{display:grid;gap:8px;margin-top:8px}
.apw details.wic>summary{padding:6px 10px}
.btn.sm2{padding:5px 12px;font-size:13px}
.decs .dwhy{font-size:13.5px;max-width:300px}
#approvals tr.wicrow td{padding-top:0}
#approvals tr.wicrow .wicp{border:1px solid var(--edge);border-radius:10px;background:var(--card);padding-top:6px}
#approvals td .apw details.wic>.wicp{display:none}
html.moves details.wic .chev{transition:transform .25s cubic-bezier(.3,.7,.2,1)}
html.moves #approvals tr.wicrow .wicp{animation:up .3s cubic-bezier(.3,.7,.2,1) both}
@media (max-width:900px){
  #approvals table,#approvals tbody{display:block}
  #approvals thead{display:none}
  #approvals tbody>tr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:4px 16px;padding:12px 14px;border-bottom:1px solid var(--line)}
  #approvals tbody>tr>td{display:block;border:0;padding:0;min-width:0;background:transparent;box-shadow:none}
  #approvals tbody>tr>td:nth-child(3){grid-column:1/-1;margin-top:6px}
  #approvals tbody>tr>td.decs{grid-column:1/-1;margin-top:8px;white-space:normal}
  #approvals tbody>tr>td:nth-child(2)::before,#approvals tbody>tr>td:nth-child(4)::before{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--label);font-weight:700;font-family:var(--sans)}
  #approvals tbody>tr>td:nth-child(2)::before{content:"Started by"}
  #approvals tbody>tr>td:nth-child(4)::before{content:"Waiting since"}
  #approvals tbody>tr.locked{background:var(--zebra)}
  #approvals tbody>tr.hot-warning{box-shadow:inset 4px 0 0 var(--warning);background:var(--warning-row)}
  #approvals tbody>tr.wicrow{display:none}
  #approvals td .apw details.wic>.wicp{display:block}
  .decs .dwhy{max-width:none}
}
/* 1.92.0: toasts never over the page's main column (portal.js place()): 1500 px and wider a gutter on the right while one shows
   (html.toasting); the Jobs page over its job list (tl); any other page in the page under its heading (ti); 900 px and narrower
   bottom centre (tb). Two at a time, "+N more"; an approval waiting is amber */
.toast.appr{border-left-color:var(--warning)}
.tmore{justify-self:end;font-size:12.5px;font-weight:650;color:var(--muted);background:var(--card-solid);border:1px solid var(--edge);border-radius:999px;padding:3px 10px}
html.toasting main{padding-right:calc(340px + 40px)}
.toasts.tl{right:auto;left:clamp(16px,2.6vw,40px);width:300px}
.toasts.tb{right:auto;left:50%;transform:translateX(-50%)}
.toasts.ti{position:static;width:auto;display:flex;flex-wrap:wrap;align-items:flex-start;gap:10px;margin:0 0 14px}
.toasts.ti .toast{flex:0 1 340px}
html.moves main{transition:padding-right .3s cubic-bezier(.3,.7,.2,1)}

/* VM deploy plan on Jobs and Approvals */
.deploy-card{grid-template-columns:minmax(0,1fr);gap:14px;overflow-wrap:anywhere}
.banner2:has(+ .deploy-card){overflow-wrap:anywhere}
.deploy-card.stopped{border-color:var(--critical-bd);border-left-color:var(--critical)}
.deploy-meta{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;font-size:13.5px}
.deploy-meta .mono{color:var(--muted)}
.deploy-legend{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}
.deploy-tiles{grid-template-columns:repeat(3,minmax(0,1fr));margin:0}
.deploy-tiles .tile{border:0;border-left:1px solid var(--line)}
.deploy-tiles .tile:nth-child(3n+1){border-left:0}
.deploy-tiles .tile:nth-child(n+4){border-top:1px solid var(--line)}
.deploy-fields{table-layout:fixed}
.deploy-fields th:first-child{width:20%}
.deploy-fields thead th:last-child{width:26%}
.deploy-fields :is(td,th){vertical-align:top;overflow-wrap:anywhere}
.deploy-fields .chip,.deploy-list .chip{max-width:100%;white-space:normal}
.deploy-card .chip .ic,.deploy-list .chip .ic{flex:none}
.as-read{display:flex;align-items:center;gap:3px;font:500 11.5px var(--sans);text-transform:none;letter-spacing:normal;color:var(--muted)}
.as-read .ic{width:12px;height:12px}
.deploy-fields .sub,.deploy-list .sub{color:var(--muted);font-size:12.5px;margin-top:2px}
.deploy-why{margin-top:4px;font-size:12.5px;font-weight:650}
.deploy-fields .deploy-warning>*,.deploy-list .deploy-warning{background:var(--warning-row)}
.deploy-fields .deploy-stop>*,.deploy-list .deploy-stop{background:var(--critical-row)}
.deploy-warning .deploy-why{color:var(--warning)}
.deploy-stop .deploy-why{color:var(--critical)}
.deploy-fields .deploy-warning th,.deploy-list li.deploy-warning{box-shadow:inset 3px 0 var(--warning)}
.deploy-fields .deploy-stop th,.deploy-list li.deploy-stop{box-shadow:inset 3px 0 var(--critical)}
.deploy-card blockquote{margin:0;border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--card);font:13px/1.5 var(--mono);white-space:pre-wrap}
.deploy-list{overflow-wrap:anywhere}
.deploy-list ul{gap:0;border:1px solid var(--line);border-radius:10px}
.deploy-list li{grid-template-columns:20% minmax(0,1fr) 26%;gap:8px;padding:7px 12px;align-items:start}
.deploy-list li+li{border-top:1px solid var(--line)}
.deploy-list li .chip{justify-self:end}
.deploy-label{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
@media (max-width:900px){
  .deploy-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}
  .deploy-tiles .tile:nth-child(n){border:0}
  .deploy-tiles .tile:nth-child(even){border-left:1px solid var(--line)}
  .deploy-tiles .tile:nth-child(n+3){border-top:1px solid var(--line)}
}

.placement-hint{display:block;font:600 11.5px var(--sans);color:var(--accent)}
.placement-editor{display:grid;gap:12px;padding:14px;border:1px solid var(--accent);border-radius:var(--r);background:var(--card-strong);overflow-wrap:anywhere}
.placement-editor :is(h3,h4,p,pre){margin:0}
.placement-lists{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:start}
.placement-lists fieldset{min-width:0;margin:0;padding:5px 10px 10px;border:1px solid var(--line);border-radius:10px}
.placement-lists legend{font-weight:700;padding:0 5px}
.placement-lists h4,.placement-note h4{font-size:12px;color:var(--muted);margin:6px 0}
.placement-option{display:grid;grid-template-columns:18px minmax(0,1fr);align-items:start;gap:3px 8px;padding:7px 2px;border-top:1px solid var(--line);cursor:pointer}
.placement-option input{margin:4px 0;width:auto;accent-color:var(--accent)}
.placement-option small{display:block;font:12px/1.5 var(--sans);color:var(--muted)}
.placement-fit,.placement-option .placement-reason{grid-column:2;font:12.5px/1.45 var(--sans)}
.placement-fit{display:flex;align-items:center;gap:8px;color:var(--muted)}
.placement-fit meter{width:3.4em;flex:none}
.placement-option.off{color:var(--muted);background:var(--bg);cursor:not-allowed}
.placement-option .placement-reason{color:var(--critical)}
.placement-pick{grid-column:2;justify-self:start}
.placement-folder .placement-pick{grid-column:1}
.placement-folder{display:grid;gap:4px;font-weight:650;min-width:0}
.placement-folder select{min-width:0;max-width:100%;white-space:normal}
.placement-note{border:1px solid var(--line);border-radius:10px;background:var(--card);padding:8px 12px}
.placement-note pre{white-space:pre-wrap;font:12.5px/1.55 var(--mono)}
.deploy-fields tr.placement-draft>*{background:var(--accent-soft)}
.placement-draft td>:not(.draft){display:none}
@supports (appearance:base-select){
  .placement-folder select,.placement-folder select::picker(select){appearance:base-select;max-width:100%;overflow-wrap:anywhere}
  .placement-folder option{white-space:normal}
}
@media(max-width:900px){.placement-lists{grid-template-columns:minmax(0,1fr)}}
