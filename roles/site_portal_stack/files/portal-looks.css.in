/* 1.136.1: the portal's looks (portal_look) - html[data-skin=KEY] over the report palette (html[data-look]).
   Ten looks: metro-atlas (default), metro-calm, metro-wall, atlas-clean, atlas-night, contour-lite, strata, metro, relay,
   atlas. Each sets the whole token set (light and dark, the Auto / Light / Dark switch) and its shape. Offline: the fonts
   are the bundled woff2 files (static/fonts/, SIL Open Font License). No inline style. A status is a word and a mark; its
   colour repeats them. */
@@FONTS@@
@@TOKENS@@

/* ---------------------------------------------------------------- every look */
:root[data-skin] body{background:var(--bg);font-family:var(--sans)}
:root[data-skin] .tint-slate{--area:light-dark(#55657a,#a9b8cc)}
:root[data-skin] .tint-sky{--area:light-dark(#0b6ea0,#5cc2f2)}
:root[data-skin] .tint-indigo{--area:light-dark(#4a45c9,#a5a8ff)}
:root[data-skin] .tint-violet{--area:light-dark(#7a3fc0,#cf9bff)}
:root[data-skin] .tint-plum{--area:light-dark(#a3307f,#ff8fd2)}
.lookpick{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--muted)}
.lookpick select{font:inherit;font-size:12.5px;color:var(--ink);background:var(--card-strong);border:1px solid var(--edge);border-radius:8px;padding:4px 6px;max-width:11.5em}
@media (max-width:900px){.lookpick span{display:none}}
:root[data-skin] .ft .v,:root[data-skin] .ops .ot-big b,:root[data-skin] td.num,:root[data-skin] .ops-area .oa-cnt{font-variant-numeric:tabular-nums}
.appbar-contour{display:none;position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:hidden;z-index:0}
.appbar-contour svg{position:absolute;right:0;top:0;height:100%;width:54%;min-width:340px}
.appbar-in{position:relative;z-index:1}

/* ---------------------------------------------------------------- the Actions page's Ops center section (portal-looks.js) */
.ops{margin:0 0 16px}
.ops[hidden]{display:none}
/* one-line mode (portal_actions_ops_center: line, the default): clickable status strip */
.ops-strip{display:flex;align-items:center;gap:8px 10px;flex-wrap:wrap;min-height:46px;padding:9px 14px;background:var(--card);border:1px solid var(--edge);border-left:4px solid var(--ops-edge,var(--unknown));border-radius:var(--r);box-shadow:var(--shadow)}
.ops-strip.s-crit{--ops-edge:var(--critical)}
.ops-strip.s-warn{--ops-edge:var(--warning)}
.ops-strip.s-ok{--ops-edge:var(--ok)}
.ops-strip.s-stale,.ops-strip.s-off{--ops-edge:var(--unknown)}
.ops-id{display:inline-flex;align-items:center;gap:7px;flex:none}
.ops-site{font:750 13.5px/1 var(--mono);color:var(--ink);letter-spacing:.03em;margin:0}
.ops-div{color:var(--edge);user-select:none;flex:none}
.ops-areas{display:inline-flex;align-items:center;gap:6px;flex-wrap:wrap;min-width:0}
.ops-area{display:inline-flex;align-items:center;gap:5px;padding:3px 9px 3px 7px;border-radius:calc(var(--r) * .75 + 2px);border:1px solid var(--edge);background:var(--card-strong);color:var(--ink);font-size:12.5px;font-weight:650;line-height:1.25;white-space:nowrap;text-decoration:none}
.ops-area:hover{border-color:var(--accent);background:var(--card);text-decoration:none}
.ops-area:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ops-area svg{width:13px;height:13px;flex:none}
.ops-area .oa-cnt{font-family:var(--mono);font-weight:750}
.ops-area .oa-st{font:700 10px/1 var(--mono);text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.ops-area.s-crit{border-color:var(--critical-bd)}.ops-area.s-crit svg,.ops-area.s-crit .oa-cnt,.ops-area.s-crit .oa-st{color:var(--critical)}
.ops-area.s-warn{border-color:var(--warning-bd)}.ops-area.s-warn svg,.ops-area.s-warn .oa-cnt,.ops-area.s-warn .oa-st{color:var(--warning)}
.ops-area.s-ok{border-color:var(--ok-bd)}.ops-area.s-ok svg,.ops-area.s-ok .oa-st{color:var(--ok)}
.ops-area.s-stale,.ops-area.s-off{border-color:var(--unknown-bd)}.ops-area.s-stale svg,.ops-area.s-off svg{color:var(--unknown)}
.ops-area.ok-tile{display:none}
.ops-ok-sum{display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--muted);font-weight:600;white-space:nowrap}
.ops-ok-sum svg{width:13px;height:13px;flex:none;color:var(--ok)}
.ops-ok-sum.is-stale svg{color:var(--unknown)}
.ops-open{margin-left:auto;flex:none;display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:calc(var(--r) * .75 + 2px);border:1px solid var(--edge);background:var(--card);color:var(--ink);font-size:12.5px;font-weight:650;text-decoration:none;white-space:nowrap}
.ops-open:hover{border-color:var(--accent);background:var(--card-strong);text-decoration:none}
.ops-open:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ma-live{display:none;align-items:center;gap:5px;font:650 11px/1 var(--mono);color:var(--accent);padding:2px 8px;border-radius:999px;border:1px solid color-mix(in srgb,var(--accent) 40%,transparent);background:var(--accent-soft)}
.ma-live i{width:6px;height:6px;border-radius:50%;background:var(--accent)}
/* full mode (portal_actions_ops_center: full) */
.ops-h{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin:2px 0 8px;font-family:var(--display);font-size:clamp(17px,1.3vw,20px);font-weight:650}
.ops-h .count{font-family:var(--mono);font-size:12px;color:var(--muted);font-weight:600}
.ops-h .hint{margin-left:auto;font-family:var(--sans);font-size:12.5px;font-weight:500;color:var(--muted);text-transform:none;font-style:normal;letter-spacing:0}
.ops-say{margin:0 0 10px;font-size:14.5px;display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px}
.ops-say b{font-family:var(--display);font-size:1.15em}
.ops-say .lamps{display:inline-flex;flex-wrap:wrap;gap:6px}
.ops-note{margin:0;color:var(--muted);font-size:13px}
.ops-tiles{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
.ot{position:relative;min-width:0}
.ot>a{position:relative;display:flex;flex-direction:column;gap:6px;height:100%;padding:14px 16px 12px;color:var(--ink);text-decoration:none;
  background:var(--card);border:1px solid var(--edge);border-radius:var(--r);box-shadow:var(--shadow);overflow:hidden;cursor:pointer}
.ot>a:hover{border-color:var(--accent)}
.ot>a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ot.s-crit>a{--sev:var(--critical)}
.ot.s-warn>a{--sev:var(--warning)}
.ot.s-ok>a{--sev:var(--ok)}
.ot.s-stale>a,.ot.s-off>a{--sev:var(--unknown)}
.ot-face{display:contents}
html.moves .ot>a{transition:transform .18s cubic-bezier(.3,.7,.2,1),border-color .18s}
html.moves .ot>a:hover{transform:translateY(-2px)}
html.moves .ops-area{transition:border-color .14s,background .14s,transform .12s}
html.moves .ops-area:hover{transform:translateY(-1px)}
.ot-h{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;font-weight:700;font-size:14.5px}
.ops-spot svg,.ops-say svg{width:15px;height:15px;flex:none}
.sp-main h3 svg{width:22px;height:22px}
.sp-main h3 .ow svg{width:13px;height:13px}
.ot-h svg{width:18px;height:18px;flex:none}
.ot-h .ow{margin-left:auto}
.ow{display:inline-flex;align-items:center;gap:5px;border:1px solid;border-radius:999px;padding:1px 9px 1px 6px;font-size:12px;font-weight:700;white-space:nowrap}
.ow svg{width:13px;height:13px;flex:none}
.ow.crit{color:var(--critical);background:var(--critical-bg);border-color:var(--critical-bd)}
.ow.warn{color:var(--warning);background:var(--warning-bg);border-color:var(--warning-bd)}
.ow.ok{color:var(--ok);background:var(--ok-bg);border-color:var(--ok-bd)}
.ow.stale,.ow.off{color:var(--unknown);background:var(--unknown-bg);border-color:var(--unknown-bd)}
.ot-big{display:flex;align-items:baseline;gap:8px;min-height:2.2em;flex-wrap:wrap}
.ot-big b{font-family:var(--display);font-size:30px;font-weight:700;line-height:1.05}
.ot-big span{font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}
.ot-counts{font:600 11.5px var(--mono);color:var(--muted);margin:0}
.ot-note{font-size:12.5px;color:var(--muted);margin:0;overflow-wrap:anywhere}
.ot.s-stale .ot-big b,.ot.s-off .ot-big b{color:var(--muted)}
.ot-lamps{display:flex;gap:6px;margin-top:auto}
.olm{display:inline-flex;align-items:center;gap:5px;font:600 11.5px var(--mono);color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:2px 7px}
.olm i{width:9px;height:9px;border-radius:50%;background:var(--line);flex:none}
.olm.on.crit{color:var(--critical);border-color:var(--critical-bd)}.olm.on.crit i{background:var(--critical)}
.olm.on.warn{color:var(--warning);border-color:var(--warning-bd)}.olm.on.warn i{background:var(--warning)}
.olm.on.ok{color:var(--ok);border-color:var(--ok-bd)}.olm.on.ok i{background:var(--ok)}
.olm.on.stale{color:var(--unknown);border-color:var(--unknown-bd)}.olm.on.stale i{background:var(--unknown)}
.ot-cue{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;color:var(--accent);margin-top:2px}
.ot-why{font-size:12px;color:var(--muted);margin:0;overflow-wrap:anywhere}
.ot-back{display:none}
.ops-foot{margin:8px 0 0;font-size:12px;color:var(--muted)}
/* the limit chart: bands, labelled dashed limits, the value - grey while OK, amber / red where it crosses; one sentence */
.olc{margin:2px 0 0;min-width:0}
.lc-b{position:relative;padding:14px 0 2px}
.lc-b.lc2{padding-bottom:15px}
.olc svg{display:block;width:100%;height:16px;overflow:visible}
.olc svg.big{height:22px}
.olc .olb{position:absolute;top:0;font:600 10.5px/1.2 var(--mono);white-space:nowrap;padding-left:3px}
.olc .olb.end{transform:translateX(-100%);padding:0 3px 0 0}
.olc .olb.below{top:auto;bottom:0}
.olc .olb.olw{color:var(--warning)}
.olc .olb.olx{color:var(--critical)}
.olc .tr{fill:var(--line)}
.olc .bw{fill:var(--warning);opacity:.2}
.olc .bc{fill:var(--critical);opacity:.22}
.olc .vo{fill:var(--muted)}
.olc .vw{fill:var(--warning)}
.olc .vc{fill:var(--critical)}
.olc .vs{fill:var(--unknown);opacity:.55}
.olc .lw{stroke:var(--warning);stroke-width:1.5;stroke-dasharray:3 2}
.olc .lcr{stroke:var(--critical);stroke-width:1.5;stroke-dasharray:3 2}
.olc p{margin:3px 0 0;font-size:12px;color:var(--muted)}
.olc p b{color:var(--ink)}
.olc p b.z-warn{color:var(--warning)}.olc p b.z-crit{color:var(--critical)}.olc p b.z-stale{color:var(--unknown)}
.ops-spot{display:none}
@media (max-width:640px){.ops-h .hint{margin-left:0}.ops-strip{padding:8px 11px;gap:6px 8px}.ops-area{padding:3px 7px;font-size:12px}}

/* ================================================================ metro-atlas: Metro Atlas (default) */
:root[data-skin="metro-atlas"] h1{letter-spacing:-.025em}
:root[data-skin="metro-atlas"] .home .mark{border-radius:4px;background:var(--accent);color:var(--accent-ink)}
:root[data-skin="metro-atlas"] .nav a[aria-current="page"]{background:var(--accent-soft);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 40%,transparent)}
:root[data-skin="metro-atlas"] .card,:root[data-skin="metro-atlas"] .ft{border-radius:4px}
:root[data-skin="metro-atlas"] .ft{border-left:4px solid var(--edge)}
:root[data-skin="metro-atlas"] .ft[aria-current="true"]{border-left-color:var(--accent)}
:root[data-skin="metro-atlas"] .ft.bad{border-left-color:var(--critical)}
:root[data-skin="metro-atlas"] .tcard:not(.off){border-color:var(--edge);border-top-width:1px;border-left:4px solid var(--area,var(--accent));box-shadow:var(--shadow)}
:root[data-skin="metro-atlas"] .tcard .ico{border-radius:4px;background:color-mix(in srgb,var(--area,var(--accent)) 14%,var(--card));color:var(--area,var(--accent));border:1px solid color-mix(in srgb,var(--area,var(--accent)) 32%,transparent)}
:root[data-skin="metro-atlas"] .btn,:root[data-skin="metro-atlas"] button{border-radius:4px}
:root[data-skin="metro-atlas"] .ot>a{border-radius:4px;border-left:4px solid var(--sev,var(--edge))}
:root[data-skin="metro-atlas"] .ot-big b{font-size:34px;letter-spacing:-.03em}
:root[data-skin="metro-atlas"] .ma-live{display:inline-flex}
@keyframes maPulse{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes maSwap{0%{opacity:.15;transform:translateY(4px)}100%{opacity:1;transform:none}}
html.moves[data-skin="metro-atlas"] .ma-live i{animation:maPulse 2.8s ease-in-out infinite}
html.moves[data-skin="metro-atlas"] .ot-note.ma-swap{animation:maSwap .42s cubic-bezier(.22,1,.36,1)}

/* ================================================================ metro-calm: Metro Calm */
:root[data-skin="metro-calm"] h1{font-weight:500;letter-spacing:-.02em}
:root[data-skin="metro-calm"] .appbar{background:var(--bar);border-bottom:1px solid var(--edge)}
:root[data-skin="metro-calm"] .home .mark{border-radius:2px;background:var(--accent);color:var(--accent-ink)}
:root[data-skin="metro-calm"] .nav a{border-radius:2px}
:root[data-skin="metro-calm"] .nav a[aria-current="page"]{background:var(--card-strong);box-shadow:inset 0 -2px 0 var(--accent)}
:root[data-skin="metro-calm"] .card,:root[data-skin="metro-calm"] .ft{border-radius:2px}
:root[data-skin="metro-calm"] .ft{border-left:4px solid var(--edge)}
:root[data-skin="metro-calm"] .ft[aria-current="true"]{border-left-color:var(--accent)}
:root[data-skin="metro-calm"] .ft.bad{border-left-color:var(--critical)}
:root[data-skin="metro-calm"] .ft .v{font-weight:400;font-size:32px}
:root[data-skin="metro-calm"] .tcard:not(.off){border-color:var(--edge);border-top-width:1px;border-left:4px solid var(--area,var(--accent));box-shadow:var(--shadow)}
:root[data-skin="metro-calm"] .tcard .ico{border-radius:2px;background:color-mix(in srgb,var(--area,var(--accent)) 12%,var(--card));color:var(--area,var(--accent));border:1px solid color-mix(in srgb,var(--area,var(--accent)) 30%,transparent)}
:root[data-skin="metro-calm"] .btn,:root[data-skin="metro-calm"] button,:root[data-skin="metro-calm"] .chip,:root[data-skin="metro-calm"] .ow,:root[data-skin="metro-calm"] .ops-area,:root[data-skin="metro-calm"] .ops-open{border-radius:2px}
:root[data-skin="metro-calm"] .ot>a{border-radius:2px;border-left:4px solid var(--sev,var(--edge))}
:root[data-skin="metro-calm"] .ot-big b{font-weight:400;font-size:34px}

/* ================================================================ metro-wall: Metro Wall */
:root[data-skin="metro-wall"] h1{font-weight:750;letter-spacing:-.02em}
:root[data-skin="metro-wall"] .appbar{border-bottom:2px solid var(--edge)}
:root[data-skin="metro-wall"] .home .mark{border-radius:3px;background:var(--accent);color:var(--accent-ink)}
:root[data-skin="metro-wall"] .card,:root[data-skin="metro-wall"] .ft{border-width:2px;border-radius:3px}
:root[data-skin="metro-wall"] .ft{border-left:6px solid var(--edge)}
:root[data-skin="metro-wall"] .ft[aria-current="true"]{border-left-color:var(--accent)}
:root[data-skin="metro-wall"] .ft.bad{border-left-color:var(--critical)}
:root[data-skin="metro-wall"] .ft .v{font-weight:750;font-size:38px;line-height:1}
:root[data-skin="metro-wall"] .tcard:not(.off){border:2px solid var(--edge);border-left:5px solid var(--area,var(--accent));border-radius:3px;box-shadow:var(--shadow)}
:root[data-skin="metro-wall"] .tcard .ico{border-radius:3px}
:root[data-skin="metro-wall"] .tcard h3{font-size:17px}
:root[data-skin="metro-wall"] .tcard p:not(.offline),:root[data-skin="metro-wall"] .ops-h .hint,:root[data-skin="metro-wall"] .ot-note,:root[data-skin="metro-wall"] .hero .lede{display:none}
:root[data-skin="metro-wall"] .btn,:root[data-skin="metro-wall"] button,:root[data-skin="metro-wall"] .chip,:root[data-skin="metro-wall"] .ow,:root[data-skin="metro-wall"] .ops-area,:root[data-skin="metro-wall"] .ops-open{border-radius:3px}
:root[data-skin="metro-wall"] .ops-strip{padding:11px 16px;border-width:2px;border-left-width:6px}
:root[data-skin="metro-wall"] .ops-site{font-size:15px}
:root[data-skin="metro-wall"] .ops-area{font-size:13.5px;padding:4px 10px}
:root[data-skin="metro-wall"] .ot>a{border-width:2px;border-left:6px solid var(--sev,var(--edge));border-radius:3px}
:root[data-skin="metro-wall"] .ot-big b{font-weight:750;font-size:44px;line-height:.98;letter-spacing:-.035em}
:root[data-skin="metro-wall"] table th{border-bottom-width:2px}

/* ================================================================ atlas-clean: Atlas Clean */
:root[data-skin="atlas-clean"] h1{font-weight:750;letter-spacing:-.035em}
:root[data-skin="atlas-clean"] .home .mark{border-radius:8px;background:var(--accent);color:var(--accent-ink)}
:root[data-skin="atlas-clean"] .card,:root[data-skin="atlas-clean"] .ft{border-radius:8px;box-shadow:none}
:root[data-skin="atlas-clean"] .grp>h2{font-family:var(--mono);font-size:13px;letter-spacing:.09em;text-transform:uppercase;border-top:2px solid var(--ink);padding-top:8px}
:root[data-skin="atlas-clean"] .tcard:not(.off){border-color:var(--edge);border-top:2px solid var(--area,var(--accent));box-shadow:none}
:root[data-skin="atlas-clean"] .ops-strip{border-left:1px solid var(--edge);border-top:2px solid var(--ink);box-shadow:none;padding:10px 14px}
:root[data-skin="atlas-clean"] .ops-area{background:var(--card);border:1px solid var(--edge);border-radius:5px;padding:4px 9px}
:root[data-skin="atlas-clean"] .ops-area.s-crit{border-left:3px solid var(--critical)}
:root[data-skin="atlas-clean"] .ops-area.s-warn{border-left:3px solid var(--warning)}
:root[data-skin="atlas-clean"] .ops-area.s-ok{border-left:3px solid var(--ok)}
:root[data-skin="atlas-clean"] .ops-area.ok-tile{display:inline-flex}
:root[data-skin="atlas-clean"] .ops-ok-sum{display:none}
:root[data-skin="atlas-clean"] .ot>a{border-radius:8px;border-top:2px solid var(--sev,var(--edge));box-shadow:none}
:root[data-skin="atlas-clean"] .ot-big b{letter-spacing:-.04em}
:root[data-skin="atlas-clean"] table th{border-bottom:1.5px solid var(--ink)}

/* ================================================================ atlas-night: Atlas Night */
:root[data-skin="atlas-night"] h1{font-weight:750;letter-spacing:-.025em}
:root[data-skin="atlas-night"] .home .mark{border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--a2));color:var(--accent-ink)}
:root[data-skin="atlas-night"] .nav a[aria-current="page"]{border-radius:999px}
:root[data-skin="atlas-night"] .card,:root[data-skin="atlas-night"] .ft{border-radius:14px}
:root[data-skin="atlas-night"] .tcard:not(.off){border-color:var(--edge);border-top-width:1px;box-shadow:inset 0 3px 0 var(--area,var(--accent)),var(--shadow)}
:root[data-skin="atlas-night"] .tcard .ico{border-radius:50%}
:root[data-skin="atlas-night"] .btn,:root[data-skin="atlas-night"] .ops-open{border-radius:999px}
:root[data-skin="atlas-night"] .ops-strip{border-radius:14px;border-left:4px solid var(--ops-edge,var(--unknown))}
:root[data-skin="atlas-night"] .ot>a{border-radius:14px;border-top:3px solid var(--sev,var(--edge));background:linear-gradient(155deg,color-mix(in srgb,var(--sev,var(--edge)) 6%,var(--card)),var(--card) 68%)}

/* ================================================================ contour-lite: Contour Lite */
:root[data-skin="contour-lite"] .appbar-contour{display:block}
:root[data-skin="contour-lite"] .contour-stroke{stroke:var(--accent);stroke-opacity:.16}
:root[data-skin="contour-lite"][data-theme="dark"] .contour-stroke{stroke:var(--accent);stroke-opacity:.19}
@media (prefers-color-scheme:dark){:root[data-skin="contour-lite"]:not([data-theme="light"]) .contour-stroke{stroke:var(--accent);stroke-opacity:.19}}
:root[data-skin="contour-lite"]:has(#theme-dark:checked) .contour-stroke{stroke:var(--accent);stroke-opacity:.19}
:root[data-skin="contour-lite"] .home .mark{border-radius:8px;background:var(--accent);color:var(--accent-ink)}
:root[data-skin="contour-lite"] .card,:root[data-skin="contour-lite"] .ft{border-radius:8px;box-shadow:none}
:root[data-skin="contour-lite"] .tcard:not(.off){border:1px solid var(--edge);box-shadow:none}
:root[data-skin="contour-lite"] .ops-strip{border-left:1px solid var(--edge);box-shadow:none}
:root[data-skin="contour-lite"] .ot>a{border-radius:8px;box-shadow:none}

/* ================================================================ strata: Strata Console */
:root[data-skin="strata"] h1,:root[data-skin="strata"] .grp>h2,:root[data-skin="strata"] .ops-h{font-family:var(--display);text-transform:uppercase;letter-spacing:.02em}
:root[data-skin="strata"] .appbar{border-bottom:1.5px solid var(--edge)}
:root[data-skin="strata"] .home .mark{border-radius:5px;background:linear-gradient(135deg,var(--accent),var(--a2));color:var(--accent-ink)}
:root[data-skin="strata"] .nav a[aria-current="page"]{box-shadow:inset 0 0 0 1.5px var(--accent);background:var(--accent-soft)}
:root[data-skin="strata"] .card{border-width:1.5px;box-shadow:0 4px 0 var(--lip),0 14px 28px -12px rgba(0,0,0,.35)}
:root[data-skin="strata"] .ft{border-radius:6px;border-width:1.5px;padding:0;overflow:hidden;box-shadow:0 4px 0 var(--lip)}
:root[data-skin="strata"] .ft .k{padding:8px 14px;background:color-mix(in srgb,var(--accent) 14%,var(--card));border-bottom:1.5px solid var(--edge);font-family:var(--display);color:var(--ink)}
:root[data-skin="strata"] .ft .v{padding:8px 14px 12px;font-size:30px}
:root[data-skin="strata"] .ft.bad .k{background:color-mix(in srgb,var(--critical) 16%,var(--card))}
:root[data-skin="strata"] .ft[aria-current="true"]{border-color:var(--accent);outline:1.5px solid var(--accent)}
:root[data-skin="strata"] .tcard:not(.off){border-color:var(--edge);border-top-width:1.5px;border-left:5px solid var(--area,var(--accent));box-shadow:0 4px 0 var(--lip)}
:root[data-skin="strata"] .tcard .ico{border-radius:6px;background:var(--area,var(--accent));color:var(--bg);border:0}
:root[data-skin="strata"] .tcard h3{font-family:var(--display);text-transform:uppercase;letter-spacing:.01em}
:root[data-skin="strata"] .tcard:not(.off) .btn.pri{font-family:var(--display);text-transform:uppercase;letter-spacing:.05em;border-radius:5px;box-shadow:0 3px 0 var(--lip);background:var(--area,var(--accent));border-color:var(--area,var(--accent));color:var(--bg)}
:root[data-skin="strata"] .btn,:root[data-skin="strata"] button{border-radius:5px}
:root[data-skin="strata"] .chip,:root[data-skin="strata"] .ow{border-radius:4px;font-family:var(--mono);text-transform:uppercase;letter-spacing:.04em}
/* the spotlight stage: one area on a stage at a time (worst first), the others as square tiles with lamp modules */
:root[data-skin="strata"] .ops-spot{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.4fr) auto;gap:12px 18px;align-items:stretch;padding:12px 16px 14px;margin:0 0 12px;
  background:var(--card);border:1.5px solid var(--edge);border-top:3px solid var(--spot,var(--accent));border-radius:6px;box-shadow:0 4px 0 var(--lip)}
.ops-spot.s-crit{--spot:var(--critical)}
.ops-spot.s-warn{--spot:var(--warning)}
.ops-spot.s-ok{--spot:var(--ok)}
.ops-spot.s-stale,.ops-spot.s-off{--spot:var(--unknown)}
.sp-lab{font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--spot,var(--muted));display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;grid-column:1/-1}
.sp-lab .sp-step{margin-left:auto;display:inline-flex;gap:6px;align-items:center;color:var(--muted);letter-spacing:.04em}
.sp-lab .sp-step button{font:600 11px var(--mono);padding:3px 9px}
.sp-main{border-left:3px solid var(--spot,var(--accent));padding-left:12px;display:flex;flex-direction:column;gap:6px;min-width:0}
.sp-main h3{margin:0;font-family:var(--display);font-size:22px;text-transform:uppercase;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sp-main .ot-big b{font-size:40px}
.sp-chart{align-self:center;min-width:0}
.sp-chart .olc .olb{font-size:11.5px}
.sp-side{display:flex;flex-direction:column;gap:8px;justify-content:space-between;min-width:12em}
.sp-side .ot-lamps{margin:0}
.sp-side .btn{justify-content:center;font-family:var(--display);text-transform:uppercase;letter-spacing:.05em}
@media (max-width:1000px){:root[data-skin="strata"] .ops-spot{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.sp-side{grid-column:1/-1;flex-direction:row;align-items:center}}
:root[data-skin="strata"] .ops-tiles{grid-template-columns:repeat(auto-fill,minmax(190px,1fr))}
:root[data-skin="strata"] .ot>a{min-height:190px;border-width:1.5px;border-radius:6px;border-top:3px solid var(--st,var(--edge));box-shadow:0 4px 0 var(--lip)}
:root[data-skin="strata"] .ot.s-crit>a{--st:var(--critical);background:color-mix(in srgb,var(--critical) 9%,var(--card))}
:root[data-skin="strata"] .ot.s-warn>a{--st:var(--warning);background:color-mix(in srgb,var(--warning) 8%,var(--card))}
:root[data-skin="strata"] .ot.s-ok>a{--st:var(--ok)}
:root[data-skin="strata"] .ot.on-spot>a{outline:2px solid var(--st,var(--accent));outline-offset:2px}
:root[data-skin="strata"] .ot .olm{flex:1;flex-direction:column;justify-content:center;gap:3px;padding:6px 2px;border-radius:5px;background:var(--bg)}
:root[data-skin="strata"] .ot .olm i{width:11px;height:11px}

/* ================================================================ metro: Metro Live Tiles */
:root[data-skin="metro"] h1{font-weight:400;font-size:clamp(1.6rem,1.2rem + 1vw,2.1rem);letter-spacing:-.01em}
:root[data-skin="metro"] .appbar{background:var(--card);border-bottom:0;box-shadow:0 1px 0 var(--edge)}
:root[data-skin="metro"] .home .mark{border-radius:0;background:#0f7fa8;color:#fff}
:root[data-skin="metro"] .nav a{border-radius:0}
:root[data-skin="metro"] .nav a[aria-current="page"]{background:transparent;box-shadow:inset 0 -3px 0 var(--accent)}
:root[data-skin="metro"] .card{border:0;border-radius:2px;box-shadow:var(--shadow)}
:root[data-skin="metro"] .ft{border:0;border-radius:0;color:#fff;min-height:96px;display:flex;flex-direction:column;justify-content:space-between}
:root[data-skin="metro"] .ft .k{color:#fff;opacity:.95;text-transform:none;letter-spacing:0;font-size:13px;font-weight:600}
:root[data-skin="metro"] .ft .v{font-weight:300;font-size:40px}
:root[data-skin="metro"] .ftiles .ft:nth-child(5n+1){background:#0f6f94}
:root[data-skin="metro"] .ftiles .ft:nth-child(5n+2){background:#5b41c4}
:root[data-skin="metro"] .ftiles .ft:nth-child(5n+3){background:#127a50}
:root[data-skin="metro"] .ftiles .ft:nth-child(5n+4){background:#a8327a}
:root[data-skin="metro"] .ftiles .ft:nth-child(5n){background:#4a5568}
:root[data-skin="metro"] .ft *{color:#fff}
:root[data-skin="metro"] .ftiles .ft.bad{background:#b2431b}
:root[data-skin="metro"] .ftiles .ft .v,:root[data-skin="metro"] .ftiles .ft.bad .v{color:#fff}
:root[data-skin="metro"] .ft[aria-current="true"]{outline:3px solid var(--ink);outline-offset:-3px}
:root[data-skin="metro"] .tcard:not(.off){border:0;border-radius:2px;box-shadow:var(--shadow)}
:root[data-skin="metro"] .tcard .ico{border-radius:0;background:var(--metro-tile,#0f6f94);color:#fff;border:0}
:root[data-skin="metro"] .tint-sky{--metro-tile:#0f6f94}
:root[data-skin="metro"] .tint-indigo{--metro-tile:#5b41c4}
:root[data-skin="metro"] .tint-violet{--metro-tile:#a8327a}
:root[data-skin="metro"] .tint-plum{--metro-tile:#b2431b}
:root[data-skin="metro"] .tint-slate{--metro-tile:#127a50}
:root[data-skin="metro"] .tcard:not(.off) .btn.pri{border-radius:0;background:#0b6ea0;border-color:#0b6ea0;color:#fff}
:root[data-skin="metro"] .btn,:root[data-skin="metro"] button,:root[data-skin="metro"] .chip,:root[data-skin="metro"] .ow{border-radius:0}
:root[data-skin="metro"] .ops-tiles{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}
:root[data-skin="metro"] .ot>a{border:0;border-radius:0;box-shadow:none;min-height:200px;perspective:900px;border-left:6px solid var(--mt,var(--edge))}
:root[data-skin="metro"] .ot.s-ok>a{--mt:var(--ok)}
:root[data-skin="metro"] .ot.s-stale>a,:root[data-skin="metro"] .ot.s-off>a{--mt:var(--unknown)}
:root[data-skin="metro"] .ot.s-crit>a{background:#b42424;color:#fff;border-left-color:#b42424}
:root[data-skin="metro"] .ot.s-warn>a{background:#f2b33d;color:#1a1200;border-left-color:#f2b33d}
:root[data-skin="metro"] .ot.s-crit>a *,:root[data-skin="metro"] .ot.s-warn>a *{color:inherit}
:root[data-skin="metro"] .ot.s-crit .ow,:root[data-skin="metro"] .ot.s-warn .ow{background:transparent;border-color:currentColor}
:root[data-skin="metro"] .ot.s-crit .olc .tr,:root[data-skin="metro"] .ot.s-warn .olc .tr{fill:rgba(0,0,0,.2)}
:root[data-skin="metro"] .ot.s-crit .olc .bw,:root[data-skin="metro"] .ot.s-crit .olc .bc,:root[data-skin="metro"] .ot.s-warn .olc .bw,:root[data-skin="metro"] .ot.s-warn .olc .bc{fill:rgba(0,0,0,.18);opacity:1}
:root[data-skin="metro"] .ot.s-crit .olc .vc,:root[data-skin="metro"] .ot.s-crit .olc .vw,:root[data-skin="metro"] .ot.s-crit .olc .vo{fill:#fff}
:root[data-skin="metro"] .ot.s-warn .olc .vw,:root[data-skin="metro"] .ot.s-warn .olc .vo,:root[data-skin="metro"] .ot.s-warn .olc .vc{fill:#1a1200}
:root[data-skin="metro"] .ot.s-crit .olc line,:root[data-skin="metro"] .ot.s-warn .olc line{stroke:currentColor}
:root[data-skin="metro"] .ot.s-crit .olc .olb,:root[data-skin="metro"] .ot.s-warn .olc .olb{color:inherit}
:root[data-skin="metro"] .ot.s-crit .olc p b,:root[data-skin="metro"] .ot.s-warn .olc p b{color:inherit}
:root[data-skin="metro"] .ot.s-crit .olm,:root[data-skin="metro"] .ot.s-warn .olm{border-color:currentColor}
:root[data-skin="metro"] .ot.s-crit .olm i,:root[data-skin="metro"] .ot.s-warn .olm i{background:currentColor;opacity:.35}
:root[data-skin="metro"] .ot.s-crit .olm.on i,:root[data-skin="metro"] .ot.s-warn .olm.on i{opacity:1}
:root[data-skin="metro"] .ot-big b{font-weight:300;font-size:44px}
:root[data-skin="metro"] .ot-face{display:flex;flex-direction:column;gap:6px;height:100%;backface-visibility:hidden}
:root[data-skin="metro"] .ot-back{display:flex;flex-direction:column;gap:4px;position:absolute;inset:0;padding:14px 16px;background:inherit;visibility:hidden;backface-visibility:hidden;transform:rotateX(-90deg);transform-origin:50% 0}
:root[data-skin="metro"] .ot-back h4{margin:0 0 4px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.85}
:root[data-skin="metro"] .ot-back .r{display:flex;justify-content:space-between;gap:8px;font-size:13px;padding:4px 0;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent)}
:root[data-skin="metro"] .ot-back .r b{font-family:var(--mono);font-weight:600;white-space:nowrap}
:root[data-skin="metro"] .ot.flip .ot-face{visibility:hidden}
:root[data-skin="metro"] .ot.flip .ot-back{visibility:visible;transform:none}
html.moves[data-skin="metro"] .ot-face,html.moves[data-skin="metro"] .ot-back{transition:transform .6s cubic-bezier(.22,1,.36,1),visibility .6s}
html.moves[data-skin="metro"] .ot.flip .ot-face{transform:rotateX(90deg);transform-origin:50% 100%}

/* ================================================================ relay: Relay Panel */
:root[data-skin="relay"] h1,:root[data-skin="relay"] .grp>h2,:root[data-skin="relay"] .tcard h3,:root[data-skin="relay"] .ops-h,:root[data-skin="relay"] .ot-h{text-transform:uppercase;letter-spacing:.02em}
:root[data-skin="relay"] .appbar{border-bottom:2px solid var(--edge)}
:root[data-skin="relay"] .home .mark{border-radius:3px;background:var(--accent);color:var(--accent-ink);box-shadow:0 0 12px color-mix(in srgb,var(--accent) 60%,transparent)}
:root[data-skin="relay"] .card{border-width:2px;border-radius:4px;box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 3px 0 rgba(0,0,0,.22)}
:root[data-skin="relay"] .ft{border-width:2px;border-radius:4px;border-left:6px solid var(--relay-c,var(--accent))}
:root[data-skin="relay"] .ftiles .ft:nth-child(2){--relay-c:#5b8def}
:root[data-skin="relay"] .ftiles .ft:nth-child(3){--relay-c:#a78bfa}
:root[data-skin="relay"] .ftiles .ft.bad{--relay-c:var(--critical)}
:root[data-skin="relay"] .tcard:not(.off){border:2px solid var(--edge);border-top:5px solid var(--area,var(--accent));border-radius:4px;box-shadow:0 3px 0 rgba(0,0,0,.22)}
:root[data-skin="relay"] .tcard .ico{border-radius:3px;background:var(--area,var(--accent));color:var(--bg);border:0}
:root[data-skin="relay"] .tcard:not(.off) .btn.pri{border-radius:3px;background:var(--area,var(--accent));border-color:var(--area,var(--accent));color:var(--bg);box-shadow:0 3px 0 rgba(0,0,0,.3)}
:root[data-skin="relay"] .tcard:not(.off) .btn.pri:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.3)}
:root[data-skin="relay"] .btn,:root[data-skin="relay"] button{border-radius:3px;border-width:2px}
:root[data-skin="relay"] .chip,:root[data-skin="relay"] .ow{border-radius:2px;text-transform:uppercase;font-family:var(--mono);letter-spacing:.04em}
:root[data-skin="relay"] .ot>a{border-width:2px;border-radius:4px;border-top:5px solid var(--rc,var(--edge))}
:root[data-skin="relay"] .ot[data-id="storage"]>a{--rc:#2fb5a5}
:root[data-skin="relay"] .ot[data-id="vmware"]>a{--rc:#5b8def}
:root[data-skin="relay"] .ot[data-id="ad"]>a{--rc:#a78bfa}
:root[data-skin="relay"] .ot[data-id="vdi"]>a{--rc:#7fb6c9}
:root[data-skin="relay"] .ot[data-id="tickets"]>a{--rc:#d9a066}
:root[data-skin="relay"] .ot-h{flex-wrap:wrap}
:root[data-skin="relay"] .ot-h .ow{order:3;margin:0;justify-content:flex-start;width:100%;white-space:normal;border-radius:3px;border-width:2px;font-size:16px;padding:5px 10px;letter-spacing:.05em}
:root[data-skin="relay"] .ot.s-off .ot-h .ow{font-size:12.5px}
:root[data-skin="relay"] .ot-h .ow svg{width:18px;height:18px}
:root[data-skin="relay"] .ot .olm{flex:1;justify-content:center;flex-direction:column;padding:6px 2px;border-width:2px;border-radius:3px}
:root[data-skin="relay"] .ot .olm i{width:14px;height:14px}
:root[data-skin="relay"] .ot .olm.on.crit i{box-shadow:0 0 10px var(--critical)}
:root[data-skin="relay"] .ot .olm.on.warn i{box-shadow:0 0 10px var(--warning)}
:root[data-skin="relay"] .ot .olm.on.ok i{box-shadow:0 0 8px var(--ok)}

/* ================================================================ atlas: Contour Atlas (plain status tiles, no island map) */
:root[data-skin="atlas"] body:not([data-page="wall"]) main{max-width:1760px}
:root[data-skin="atlas"] h1{font-weight:800;letter-spacing:-.025em}
:root[data-skin="atlas"] .home .mark{border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--a2));color:var(--accent-ink)}
:root[data-skin="atlas"] .nav a[aria-current="page"]{border-radius:999px}
:root[data-skin="atlas"] .card{border-radius:16px}
:root[data-skin="atlas"] .ft{border-radius:16px}
:root[data-skin="atlas"] .tcard:not(.off){border-color:var(--edge);border-top-width:1px;box-shadow:inset 0 3px 0 var(--area,var(--accent)),var(--shadow)}
:root[data-skin="atlas"] .tcard .ico{border-radius:50%;background:color-mix(in srgb,var(--area,var(--accent)) 18%,var(--card));color:var(--area,var(--accent));border:0}
:root[data-skin="atlas"] .tcard:not(.off) .btn.pri,:root[data-skin="atlas"] .btn,:root[data-skin="atlas"] .ops-open{border-radius:999px}
:root[data-skin="atlas"] .ops-strip{border-radius:16px}
:root[data-skin="atlas"] .ot>a{border-radius:16px;border-top:3px solid var(--sev,var(--edge))}

@media (prefers-reduced-motion:reduce){html:not(.motion-always) .ot>a,html:not(.motion-always) .ot-face,html:not(.motion-always) .ot-back,html:not(.motion-always) .ops-area,html:not(.motion-always) .ma-live i,html:not(.motion-always) .ot-note.ma-swap{transition:none!important;animation:none!important}}
@media print{.ops,.lookpick{display:none}}
