# Secrets never live in this repository. These patterns catch the usual accidents.
*.pem
# (but the test certificates - certificates only, no keys: tests/fixtures/pki/README.md)
!tests/fixtures/pki/*.pem
*.key
*.p12
*.pfx
*.crt
# ...except public CA certificates the jobs need (docs/VMWARE.md: report_email_ca_path, site_act_ca)
!playbooks/files/ca/*.pem
!playbooks/files/ca/*.crt
# ...and the certificates the OCSP checks ask about (site_ocsp_certs, vm_sso_ocsp, net_perf_ocsp: public, no keys)
!playbooks/files/ocsp/*.pem
!playbooks/files/ocsp/*.crt
!playbooks/files/ocsp/*.cer
.vault_pass*
vault-password*
*.secret
secrets.yml
**/secrets/
.env
# local state
*.retry
.ansible/
__pycache__/
act-reports/
!tests/trust/fixtures/*.pem
